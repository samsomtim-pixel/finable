---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<a href="/" class:list={['logo', className]} aria-label="Finable — naar de homepage">
  <svg viewBox="0 0 157 157" width="32" height="32" aria-hidden="true">
    <path fill="#1E4536" d="M78.5 74.1C37.6 74.1 4.4 40.9 4.4 0h42.9c0 17.2 14 31.2 31.2 31.2s31.2-14 31.2-31.2h42.9c0 40.9-33.2 74.1-74.1 74.1z"/>
    <path fill="#1E4536" d="M0 156.9v-26.8c10.7 0 19.5-8.7 19.5-19.5S10.7 91.2 0 91.2V64.5c25.5 0 46.2 20.7 46.2 46.2S25.5 156.9 0 156.9z"/>
    <path fill="#1E4536" d="M156.9 84.6c-7.3-2.2-15-3.4-23-3.4-42.7 0-77.6 33.6-79.8 75.7h46.4c2.1-16.6 16.3-29.4 33.4-29.4 8.9 0 17 3.5 23 9.2z"/>
  </svg>
  <span class="logo-text">Finable<span class="logo-dot">.</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1;
  }
  .logo-dot {
    color: var(--terracotta);
  }
</style>
