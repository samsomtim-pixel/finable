---
// Navigatiebalk. Bron: hoe-het-werkt-nav2 (logo als inline SVG, menu-items, CTA).
// Actief item: navy, 600, terracotta onderlijn — precies zoals in de prototypes.
// Taal volgt de route (lib/i18n); de NL · EN-wissel linkt naar de equivalente pagina in de andere taal.
import Button from './Button.astro';
import { alternates, langOf } from '../lib/i18n';
interface Props {
  active?: 'hoe-het-werkt' | 'aanpak' | 'over';
}
const { active } = Astro.props;
const lang = langOf(Astro.url.pathname);
const alt = alternates(Astro.url.pathname);
const on = 'color:var(--navy);font-weight:600;border-bottom:2px solid var(--terracotta);padding-bottom:4px';
const off = 'color:var(--body)';
const items = lang === 'en'
  ? [
      { href: '/en/how-it-works', key: 'hoe-het-werkt', label: 'How Finable works' },
      { href: '/en/finance-team', key: 'aanpak', label: 'Finance team' },
      { href: '/en/about', key: 'over', label: 'About' },
    ]
  : [
      { href: '/hoe-het-werkt', key: 'hoe-het-werkt', label: 'Zo werkt Finable' },
      { href: '/aanpak', key: 'aanpak', label: 'Finance-team' },
      { href: '/over', key: 'over', label: 'Over' },
    ];
const cta = lang === 'en' ? { href: '/en/book-a-call', label: 'Book a call' } : { href: '/gesprek', label: 'Plan een gesprek' };
const home = lang === 'en' ? '/en/' : '/';
const t = lang === 'en'
  ? { nav: 'Main navigation', menu: 'Menu', close: 'Close menu', langLabel: 'Language' }
  : { nav: 'Hoofdnavigatie', menu: 'Menu', close: 'Menu sluiten', langLabel: 'Taal' };
---
<header style="position:relative;z-index:50">
  <nav class="wrap" style="padding-top:26px;padding-bottom:26px;display:flex;align-items:center;justify-content:space-between;gap:24px" aria-label={t.nav}>
    <a href={home} aria-label="Finable" style="line-height:0;display:inline-block"><svg viewBox="0 0 868 156.9093" height="30" role="img" aria-label="Finable" style="display:block"><path d="M78.4547,74.0961C37.5982,74.0961,4.3586,40.8564,4.3586,0h42.8977c0,17.2025,13.9958,31.1983,31.1983,31.1983s31.1983-13.9958,31.1983-31.1983h42.8977c0,40.8564-33.2396,74.0961-74.0961,74.0961Z" fill="#C4643A"></path><path d="M0,156.9093v-26.7589c10.7306,0,19.461-8.7304,19.461-19.461S10.7306,91.2284,0,91.2284v-26.7589c25.4856,0,46.2199,20.7343,46.2199,46.2199S25.4856,156.9093,0,156.9093Z" fill="#C4643A"></path><path d="M156.9093,84.5626c-7.2946-2.1984-15.0253-3.3804-23.027-3.3804-42.6643,0-77.6268,33.5996-79.8223,75.7271h46.4579c2.0808-16.5752,16.2342-29.4494,33.3644-29.4494,8.9166,0,17.0064,3.509,23.027,9.1949v-52.0921Z" fill="#C4643A"></path><path d="M217.342,20.2428h86.923v21.3104h-62.4351v33.2741h50.0977v21.3098h-50.0977v54.9583h-24.4879V20.2428Z" fill="#1B3A5C"></path><path d="M341.279,16.5041v25.6098h-24.6754v-25.6098h24.6754ZM317.3517,56.8819h22.9923v94.2136h-22.9923V56.8819Z" fill="#1B3A5C"></path><path d="M361.6538,56.8819h22.9923v14.5805c5.0475-10.2812,15.8892-16.0761,29.3485-16.0761,21.123,0,34.9566,15.3286,34.9566,37.3866v58.3226h-22.806v-53.4627c0-12.898-8.0381-21.8711-19.8148-21.8711-12.7111,0-21.6842,10.0943-21.6842,23.9273v51.4064h-22.9923V56.8819Z" fill="#1B3A5C"></path><path d="M465.4011,124.177c0-18.1323,14.0199-29.9085,36.0784-29.9085h15.8886c5.2349,0,7.4774-1.8694,7.4774-5.9824,0-9.1593-6.9162-15.5149-19.0661-15.5149s-19.4411,7.4768-19.8148,15.8892h-20.5636c1.1225-18.6936,17.0111-33.2741,41.4996-33.2741,23.9273,0,40.7509,14.0199,40.7509,34.9566v60.7526h-22.806v-14.0199c-3.7387,9.3462-14.7674,15.5149-28.0398,15.5149-18.6924,0-31.4047-11.9636-31.4047-28.4135ZM524.8456,111.4658v-1.495h-20.3748c-10.2812,0-16.8236,5.0462-16.8236,13.2724,0,7.4762,5.7937,12.3374,14.5799,12.3374,14.2074,0,22.6186-10.0949,22.6186-24.1148Z" fill="#1B3A5C"></path><path d="M590.8313,139.3193v11.7762h-22.9923V16.5041h22.9923v51.7802c5.7949-7.8506,16.4499-12.898,28.2272-12.898,27.2923,0,43.7421,20.0017,43.7421,48.6021s-16.4499,48.6021-43.3684,48.6021c-12.1511,0-22.9923-5.2337-28.601-13.2712ZM639.9946,103.9884c0-17.3842-10.0949-28.7873-25.236-28.7873-15.3286,0-25.4223,11.403-25.4223,28.7873s10.0937,28.7873,25.4223,28.7873c15.1411,0,25.236-11.4024,25.236-28.7873Z" fill="#1B3A5C"></path><path d="M678.8755,16.5041h22.9923v134.5913h-22.9923V16.5041Z" fill="#1B3A5C"></path><path d="M717.5702,103.6146c0-24.8617,15.3274-48.2283,46.1721-48.2283,31.4035,0,45.6109,22.9929,45.6109,45.4246,0,3.1775-.1875,6.1687-.3737,8.0374h-69.1644c1.8687,14.9549,11.2149,24.676,25.6098,24.676,11.7762,0,19.6273-4.8612,21.8698-13.8336h22.4323c-3.365,20.0023-20.9361,32.8997-44.3021,32.8997-30.8447,0-47.8546-24.301-47.8546-48.9758ZM786.5471,93.1466c-.9338-11.9636-9.1599-20.3755-22.8048-20.3755-12.7124,0-20.7498,7.1031-23.3673,20.3755h46.1721Z" fill="#1B3A5C"></path><circle cx="845" cy="137" r="15.5" fill="#C4643A"></circle></svg></a>
    <div style="display:flex;align-items:center;gap:40px">
      <div class="nav-mid" style="display:flex;align-items:center;gap:32px;font-size:15px;font-weight:500">
        {items.map((it) => <a href={it.href} style={active === it.key ? on : off}>{it.label}</a>)}
      </div>
      <nav class="lang-switch lang-switch-bar" aria-label={t.langLabel}>
        <a href={alt.nl} hreflang="nl" lang="nl" class:list={[{ 'is-on': lang === 'nl' }]} aria-current={lang === 'nl' ? 'page' : undefined}>NL</a><span aria-hidden="true">·</span><a href={alt.en} hreflang="en" lang="en" class:list={[{ 'is-on': lang === 'en' }]} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </nav>
      <Button href={cta.href} size="sm" class="nav-cta">{cta.label} &rarr;</Button>
      <button class="nav-toggle" type="button" aria-label={t.menu} aria-expanded="false" aria-controls="nav-panel" data-nav-toggle data-label-open={t.close} data-label-closed={t.menu}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
  <div class="nav-panel" id="nav-panel" hidden>
    <div class="wrap">
      {items.map((it) => <a href={it.href} class:list={['nav-panel-link', { 'is-active': active === it.key }]}>{it.label}</a>)}
      <Button href={cta.href} class="nav-panel-cta">{cta.label} &rarr;</Button>
      <nav class="lang-switch lang-switch-panel" aria-label={t.langLabel}>
        <a href={alt.nl} hreflang="nl" lang="nl" class:list={[{ 'is-on': lang === 'nl' }]} aria-current={lang === 'nl' ? 'page' : undefined}>NL</a><span aria-hidden="true">·</span><a href={alt.en} hreflang="en" lang="en" class:list={[{ 'is-on': lang === 'en' }]} aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
      </nav>
    </div>
  </div>
</header>

<style is:global>
  .nav-toggle{display:none;width:44px;height:44px;margin:-4px -8px -4px 0;padding:0;border:none;background:none;cursor:pointer;flex-direction:column;align-items:center;justify-content:center;gap:5px}
  .nav-toggle span{display:block;width:22px;height:2px;background:var(--navy);transition:transform .2s,opacity .2s}
  .nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
  .nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .nav-panel{position:absolute;top:100%;left:0;right:0;background:var(--white);border-top:1px solid var(--line);border-bottom:1px solid var(--line);box-shadow:0 24px 40px -28px rgba(27,58,92,.35)}
  .nav-panel .wrap{display:flex;flex-direction:column;padding-top:8px;padding-bottom:20px}
  .nav-panel-link{display:flex;align-items:center;min-height:48px;font-size:17px;font-weight:500;color:var(--navy)}
  .nav-panel-link.is-active{color:var(--terracotta);font-weight:600}
  .nav-panel-cta{margin-top:12px;text-align:center}
  .lang-switch-panel{display:none;justify-content:center;margin-top:16px;min-height:44px}
  .lang-switch-panel a{padding:12px 6px!important}
  @media (max-width:1023px){
    .nav-mid{display:none!important}
    .nav-toggle{display:flex}
    .nav-cta{min-height:44px;display:inline-flex;align-items:center}
    header nav > div{gap:16px}
  }
  @media (max-width:639px){
    .nav-cta{display:none}
    .lang-switch-bar{display:none}
    .lang-switch-panel{display:inline-flex}
  }
</style>

<script>
  // Mobiel menu: één toggle, geen framework.
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('nav-panel');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? (toggle.dataset.labelOpen || 'Menu sluiten') : (toggle.dataset.labelClosed || 'Menu'));
    });
  }
</script>
