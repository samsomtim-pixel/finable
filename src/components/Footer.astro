---
import Logo from './Logo.astro';
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <Logo />
      <p class="footer-company">Finable B.V. · KVK 91234567</p>
    </div>
    <div class="footer-right">
      <div class="footer-links">
        <a href="#">Privacy</a>
        <span class="footer-sep">|</span>
        <a href="#">Voorwaarden</a>
      </div>
      <span class="footer-lang">NL</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 32px 0;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer-left {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .footer-company {
    font-size: 0.8125rem;
    color: var(--body-color);
  }
  .footer-right {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.8125rem;
  }
  .footer-links a {
    color: var(--body-color);
    transition: color 0.2s;
  }
  .footer-links a:hover {
    color: var(--navy);
  }
  .footer-sep {
    color: var(--line);
  }
  .footer-lang {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--body-color);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
