---
// Homepage-structuur, gedeeld door NL en EN. Alles wat per taal verschilt staat in copy/home.*.ts;
// secties, volgorde, componenten, beeld, layout en CSS staan hier en zijn voor elke taal gelijk.
// Nederlands is leidend: een nieuwe sectie wordt hier gebouwd en krijgt per taal copy, zodat de
// twee talen niet opnieuw uit elkaar kunnen lopen.
import Header from './Header.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import LogoMarquee from './LogoMarquee.astro';
import type { HomeCopy } from '../copy/home';

interface Props { copy: HomeCopy }
const { copy: c } = Astro.props;
---
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:64px;padding-bottom:80px">
    <div class="hero" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr);gap:clamp(36px,4.6vw,72px);align-items:center">
      <div>
        <div class="hero-brand" style="margin-bottom:26px">{c.hero.eyebrowA}<span>{c.hero.eyebrowB}</span></div>
        <h1 style="font-size:clamp(38px,4.6vw,56px);line-height:1.05;margin-bottom:26px">{c.hero.h1a} <span class="hero-h1-b">{c.hero.h1b}</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:rgba(255,255,255,.78);max-width:560px;text-wrap:pretty">{c.hero.sub}</p>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:34px">
          <Button href={c.hero.cta.href}>{c.hero.cta.label} &rarr;</Button>
          <a href={c.hero.secondary.href} class="on-dark-link" style="font-weight:600;font-size:16px;color:var(--white)">{c.hero.secondary.label} &rarr;</a>
        </div>
      </div>
      <div class="hero-media">
        <!-- Beeldslot uit het ontwerp (home-hero-still). Gevuld met de aangeleverde samenwerkingsfoto; alleen op desktop (≥1024px), daaronder bewust weggelaten (display:none), niet verkleind. -->
        <div class="hero-img" style="height:clamp(260px,26vw,352px)"><picture><source media="(min-width:1024px)" srcset="/images/hero-team-call.webp" type="image/webp"><img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt={c.hero.imgAlt} width="1600" height="797" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;display:block;border-radius:14px"></picture></div>
      </div>
    </div>
    </div>
  </section>

  <!-- HERKENNING -->
  <section class="wrap" style="padding-top:8px;padding-bottom:72px">
    <div class="rule" style="margin-bottom:44px"></div>
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:40px">
      <h2 style="font-size:clamp(26px,3.2vw,38px)">{c.herken.h2}</h2>
      <div style="font-size:15px;color:var(--body)">{c.herken.aside}</div>
    </div>
    <div class="cols4t" style="display:grid;grid-template-columns:repeat(3,1fr)">
      <div>
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:18px" aria-hidden="true"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg>
        <h3 style="font-size:20px;margin-bottom:10px">{c.herken.items[0].h3}</h3>
        <p style="font-size:15px;color:var(--body)">{c.herken.items[0].p}</p>
      </div>
      <div>
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:18px" aria-hidden="true"><circle cx="14" cy="14" r="10"/><path d="M14 8v6l4 2"/></svg>
        <h3 style="font-size:20px;margin-bottom:10px">{c.herken.items[1].h3}</h3>
        <p style="font-size:15px;color:var(--body)">{c.herken.items[1].p}</p>
      </div>
      <div>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:18px" aria-hidden="true"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg>
        <h3 style="font-size:20px;margin-bottom:10px">{c.herken.items[2].h3}</h3>
        <p style="font-size:15px;color:var(--body)">{c.herken.items[2].p}</p>
      </div>
    </div>
  </section>

  <!-- DOELGROEPEN — twee routes onder de probleemherkenning. Compact gehouden: geen tweede hero,
       alleen de splitsing naar de pagina die bij de bezoeker hoort. -->
  {c.doelgroepen && (
    <section class="wrap" style="padding-top:8px;padding-bottom:72px">
      <div class="rule" style="margin-bottom:44px"></div>
      <div class="dg-head">
        <h2 style="font-size:clamp(26px,3.2vw,38px);text-wrap:balance">{c.doelgroepen.h2}</h2>
        <p style="font-size:16px;color:var(--body);text-wrap:pretty">{c.doelgroepen.intro}</p>
      </div>
      <div class="dg">
        {c.doelgroepen.items.map((it) => (
          <div class={'dg-card' + (it.accent ? ' is-accent' : '')}>
            <h3 style="font-size:clamp(19px,2.1vw,23px);line-height:1.22;margin-bottom:12px">{it.h3}</h3>
            <p style="font-size:15.5px;color:var(--body);line-height:1.6;text-wrap:pretty">{it.p}</p>
            <a href={it.cta.href} class="dg-cta">{it.cta.label} &rarr;</a>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- ERVARING / LOGO PROOF — ervaring van de mensen achter Finable, geen klantenlijst. -->
  <section style="background:var(--terracotta-tint)">
    <div class="wrap" style="padding-top:40px;padding-bottom:0">
      <div style="margin-bottom:28px;text-align:center">
        <div class="lbl">{c.ervaring.label}</div>
      </div>
    </div>
    <div class="logo-rail" style="padding-bottom:40px">
      <LogoMarquee />
    </div>
  </section>

  <!-- NAVY ANKER · FINANCE-FUNCTIE -->
  <section class="navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:80px;padding-bottom:80px;text-align:center">
      <div class="lbl" style="color:var(--terracotta);margin-bottom:20px">{c.functie.label}</div>
      <h2 style="font-size:clamp(28px,3.6vw,44px);color:var(--white);margin-bottom:44px">{c.functie.h2}</h2>
      <div class="flow" style="max-width:1000px;margin:0 auto;text-align:left">
        <div class="fn">{c.functie.flow[0]}</div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div class="fn">{c.functie.flow[1]}</div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div class="fn">{c.functie.flow[2]}</div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div class="fn">{c.functie.flow[3]}</div>
      </div>
      <div style="height:1px;background:rgba(255,255,255,0.14);max-width:1000px;margin:44px auto 30px"></div>
      <div class="navy-trio" style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px 26px;font-family:'Playfair Display',serif;font-size:clamp(18px,1.9vw,23px);color:var(--white)">
        <span>{c.functie.trio[0]}</span>
        <span style="color:var(--on-dark-tertiary)">·</span>
        <span>{c.functie.trio[1]}</span>
        <span style="color:var(--on-dark-tertiary)">·</span>
        <span>{c.functie.trio[2]}</span>
      </div>
    </div>
  </section>

  <!-- FINANCE VERANDERT — context, geen klantenlijst. De corporate namen zijn uitsluitend
       typografisch: het zijn geen klanten, partners of endorsements van Finable. -->
  <section class="fv-sec" style="background:var(--section)">
    <div class="wrap">
      <div class="fv">
        <div>
          <div class="lbl" style="margin-bottom:18px">{c.verandert.label}</div>
          <h2 style="font-size:clamp(26px,3.2vw,38px);text-wrap:balance">{c.verandert.h2}</h2>
        </div>
        <div>
          <p class="fv-body">{c.verandert.body}</p>
          <p class="fv-concl">{c.verandert.concl}</p>
          <ul class="fv-proof">{c.verandert.proof.map((n) => <li>{n}</li>)}</ul>
          <details class="fv-src">
            <summary><span>{c.verandert.bronnenLabel}</span><span class="fv-ic" aria-hidden="true"></span></summary>
            <ul>
              {c.verandert.bronnen.map((b) => (
                <li><a href={b.url} target="_blank" rel="noopener noreferrer">{b.label} &rarr;</a></li>
              ))}
            </ul>
          </details>
          {c.verandert.read && (
            <div class="fv-read">
              <a href={c.verandert.read.href} class="fv-read-a">{c.verandert.read.label} &rarr;</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- WAT PAST BIJ JOUW SITUATIE -->
  <section class="wrap" style="padding-top:80px;padding-bottom:72px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:44px">
      <h2 style="font-size:clamp(26px,3.2vw,38px)">{c.situatie.h2}</h2>
      <a href={c.situatie.compare.href} style="font-weight:600;font-size:15px;color:var(--terracotta)">{c.situatie.compare.label} &rarr;</a>
    </div>
    <div class="cols4">
      {c.situatie.items.map((it, i) => (
        <div>
          <div class="lbl" style={i === c.situatie.items.length - 1 ? 'margin-bottom:12px' : 'color:var(--body);margin-bottom:12px'}>{it.label}</div>
          <p style={i === c.situatie.items.length - 1 ? 'font-size:15px;color:var(--navy);line-height:1.6' : 'font-size:15px;color:var(--body);line-height:1.6'}>{it.p}</p>
          {it.link && <a href={it.link.href} style="display:inline-block;margin-top:10px;font-size:14px;font-weight:600;color:var(--terracotta)">{it.link.label} &rarr;</a>}
        </div>
      ))}
    </div>
  </section>

  <!-- KLANTCASE -->
  <section class="wrap" style="padding-top:8px;padding-bottom:72px">
    <div class="rule" style="margin-bottom:52px"></div>
    <div class="case" style="display:grid;grid-template-columns:auto minmax(0,1.7fr) clamp(185px,19vw,245px);gap:clamp(24px,3.5vw,48px);align-items:center">
      <div style="display:flex;flex-direction:column;gap:16px">
        <img src="/images/the-good-roll.png" alt={c.case.logoAlt} width="662" height="663" style="width:72px;height:72px;border-radius:999px;display:block">
        <div>
          <div class="lbl" style="color:var(--body);margin-bottom:6px">{c.case.label}</div>
          <div style="font-size:15px;color:var(--body)">{c.case.persoon}</div>
        </div>
      </div>
      <div>
        <p style="font-family:'Playfair Display',serif;font-size:clamp(24px,3vw,38px);color:var(--navy);line-height:1.2;margin-bottom:22px;text-wrap:balance">{c.case.quoteA}<span style="color:var(--terracotta)">{c.case.quoteB}</span></p>
        <p style="font-size:16px;color:var(--body);max-width:640px;text-wrap:pretty">{c.case.body}</p>
        <a href={c.case.link.href} data-case-link="the_good_roll" style="display:inline-block;margin-top:18px;font-size:15px;font-weight:600">{c.case.link.label} &rarr;</a>
      </div>
      <div class="case-img" style="aspect-ratio:1200/711;border-radius:12px;overflow:hidden"><img src="/images/sander-the-good-roll.webp" alt={c.case.fotoAlt} width="1200" height="711" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
    </div>
    <div class="rule" style="margin-top:52px"></div>
  </section>

  <!-- ZEKERHEDEN -->
  <section style="background:var(--terracotta-tint)">
    <div class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-bottom:44px">
      <h2 style="font-size:clamp(26px,3.2vw,38px)">{c.zekerheden.h2}</h2>
      <div style="font-size:15px;color:var(--body)">{c.zekerheden.aside}</div>
    </div>
    <div class="cols4t" style="display:grid;grid-template-columns:repeat(4,1fr)">
      {c.zekerheden.items.map((it) => (
        <div>
          <div class="lbl" style="color:var(--navy);margin-bottom:12px">{it.label}</div>
          <p style="font-size:15px;color:var(--body);line-height:1.6">{it.p}</p>
        </div>
      ))}
    </div>
    </div>
  </section>

  <!-- FAQ + TIM (navy) -->
  <section class="faq-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:68px;padding-bottom:68px">
    <div class="endmod" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr);gap:clamp(40px,5vw,72px);align-items:start">
      <div>
        <div class="lbl" style="margin-bottom:28px">{c.faq.label}</div>
        <div style="max-width:900px">
          {c.faq.items.map((f) => (
            <details class="fin-faq"><summary><span class="fin-faq-q">{f.q}</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>{f.a}</p></div></details>
          ))}
        </div>
        <div style="margin-top:26px"><a href={c.faq.alle.href} style="font-weight:600;font-size:15px;color:var(--terracotta)">{c.faq.alle.label} &rarr;</a></div>
      </div>
      <div class="endmod-cta" style="border-left:1px solid var(--on-dark-line);padding-left:clamp(28px,3vw,48px)">
        <div class="lbl" style="margin-bottom:20px">{c.eind.label}</div>
        <div class="tim-row" style="display:grid;grid-template-columns:clamp(120px,14vw,150px) minmax(0,1fr);gap:24px;align-items:center;margin-bottom:24px">
          <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt={c.eind.timAlt} width="800" height="699" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
          <div>
            <h2 style="font-size:clamp(21px,2.2vw,28px);line-height:1.12;margin-bottom:12px;color:var(--white)">{c.eind.h2}</h2>
            <p style="font-size:15px;color:var(--on-dark-secondary);text-wrap:pretty">{c.eind.p}</p>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:20px">
          <Button href={c.eind.cta.href}>{c.eind.cta.label} &rarr;</Button>
          <div style="font-size:14px;color:var(--on-dark-secondary);line-height:1.45"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">{c.eind.timNaam}</span><br>{c.eind.timRol}</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <Footer />

</div>

<style is:global>
  /* Hero-brandline (A2): klein en uppercase boven de H1; alleen 'in-house.' krijgt het terracotta-accent. */
  .hero-brand{font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--on-dark-secondary)}
  .hero-brand span{color:var(--terracotta)}
  /* Zodra de hero éénkolommig wordt, krijgt "Elke maand." een eigen regel: hetzelfde ritme als op desktop,
     en op mobiel voorkomt het dat de balanced wrap midden in "Wij runnen je finance." breekt. */
  @media (max-width:1023px){ .hero-h1-b{display:block} }
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  .on-dark-link:hover{color:var(--terracotta);opacity:1}
  .flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:18px;align-items:start}
  .flow .fn{font-family:'Playfair Display',serif;font-size:clamp(17px,1.5vw,21px);color:var(--white)}
  .flow .fa{align-self:center;color:var(--terracotta)}
  /* DOELGROEPEN — twee kaarten, de groeimarkt met een zachte terracotta nadruk. Geen nieuwe
     visuele taal: dezelfde tint en randen als de vergelijking op /finance-hire. */
  .dg-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,3.4vw,56px);align-items:end;margin-bottom:36px}
  .dg{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
  .dg-card{border:1px solid var(--line);border-radius:12px;padding:clamp(24px,2.6vw,32px);display:flex;flex-direction:column}
  .dg-card.is-accent{border-color:rgba(196,100,58,0.22);background:var(--terracotta-soft)}
  .dg-cta{margin-top:auto;padding-top:18px;font-size:15px;font-weight:600;color:var(--terracotta)}
  @media (max-width:767px){
    .dg-head{grid-template-columns:1fr;gap:14px;align-items:start}
    .dg{grid-template-columns:1fr}
  }
  .cols4{display:grid;grid-template-columns:repeat(4,1fr)}
  .cols4>div{padding:0 30px;border-left:1px solid var(--line)}
  .cols4>div:first-child{padding-left:0;border-left:none}
  .cols4t>div{padding:0 26px;border-left:1px solid var(--line)}
  .cols4t>div:first-child{padding-left:0;border-left:none}
  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:30px;padding:24px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(17px,1.7vw,20px);color:var(--navy);line-height:1.35;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:17px;height:17px;flex-shrink:0;margin-top:6px}
  .fin-faq-ic::before,.fin-faq-ic::after{content:"";position:absolute;background:var(--terracotta);transition:opacity .2s}
  .fin-faq-ic::before{left:0;top:7.5px;width:17px;height:2px}
  .fin-faq-ic::after{left:7.5px;top:0;width:2px;height:17px}
  details.fin-faq[open] .fin-faq-ic::after{opacity:0}
  details.fin-faq>summary:hover .fin-faq-q{color:var(--terracotta)}
  .fin-faq-a{max-width:720px;padding:0 0 28px;font-size:15.5px;color:var(--body);line-height:1.72}
  @media (max-width:1023px){
  .hero{grid-template-columns:1fr!important;gap:40px!important}
  .flow{grid-template-columns:1fr;gap:16px}
  .flow .fa{transform:rotate(90deg);justify-self:start}
  .cols4,.cols4t{grid-template-columns:1fr 1fr;gap:26px 0}
  .cols4>div,.cols4t>div{padding:22px 0;border-left:none;border-top:1px solid var(--line)}
  .cols4>div:nth-child(-n+2),.cols4t>div:nth-child(-n+2){border-top:none}
  .case{grid-template-columns:1fr!important;gap:28px!important}
  .case-img{max-width:420px}
  .endmod{grid-template-columns:1fr!important;gap:36px!important}
  .endmod>div:last-child{border-left:none!important;padding-left:0!important;border-top:1px solid var(--on-dark-line);padding-top:36px!important}
  }
  /* Responsive (bouwopdracht §5): 1024 / 640 */
  @media (max-width:1023px){
    .hero-media{display:none}
    .cols4,.cols4t{grid-template-columns:1fr 1fr!important}
    .tim-row{grid-template-columns:1fr!important}
    .tim-row>div:first-child{max-width:150px}
  }
  /* Mobiel (≤639): compositie */
  @media (max-width:639px){
    .navy-trio{flex-direction:column;gap:6px!important}
    .navy-trio>span[style]{display:none}
    .flow{gap:12px}
    .cols4>div,.cols4t>div{padding:18px 0!important}
    .logo-rail{padding-bottom:36px!important}
  }
  @media (max-width:639px){
    .cols4,.cols4t{grid-template-columns:1fr!important;gap:0}
    .cols4>div:nth-child(-n+2),.cols4t>div:nth-child(-n+2){border-top:1px solid var(--line)}
    .cols4>div:first-child,.cols4t>div:first-child{border-top:none;padding-top:0}
  }

  /* FINANCE VERANDERT — twee kolommen op desktop, gestapeld op mobiel. */
  .fv{display:grid;grid-template-columns:minmax(0,0.85fr) minmax(0,1.15fr);gap:clamp(32px,4.4vw,72px);align-items:start}
  .fv-body{font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty}
  /* De Finable-conclusie is visueel het belangrijkste rechts: terracotta accentlijn. */
  .fv-concl{margin-top:20px;padding-left:18px;border-left:3px solid var(--terracotta);font-family:'Playfair Display',Georgia,serif;font-size:clamp(18px,1.9vw,23px);line-height:1.35;color:var(--navy);text-wrap:balance}
  /* Corporate namen: context, geen logo's, geen badges. Bewust kleiner dan de conclusie.
     Een lijst met flex-wrap in plaats van losse tekst met ' · ' ertussen: zo kan een regel niet
