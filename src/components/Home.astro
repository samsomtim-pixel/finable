---
// Homepage-structuur, gedeeld door NL en EN. Alles wat per taal verschilt staat in copy/home.*.ts;
// secties, volgorde, componenten, beeld, layout en CSS staan hier en zijn voor elke taal gelijk.
// Nederlands is leidend: een nieuwe sectie wordt hier gebouwd en krijgt per taal copy, zodat de
// twee talen niet opnieuw uit elkaar kunnen lopen.
//
// Sectievolgorde: hero · bewijs · herkenning · werk · case · mensen · kantoren · faq · starten.
// De hero is bewust de eerste <section> en 'starten' de laatste: site-analytics.ts leidt
// cta_location af uit de index van de sectie, dus 'hero' en 'closing' hangen aan die posities.
import Header from './Header.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import type { HomeCopy } from '../copy/home';

interface Props { copy: HomeCopy }
const { copy: c } = Astro.props;
---
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) — links de claim, rechts de vier werkgebieden puur typografisch. Geen beeld,
       geen cijfers, geen nagebootste software: de kop is het beeld. -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:60px">
    <div class="hero" style="display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,0.8fr);gap:clamp(36px,4.6vw,72px);align-items:center">
      <div>
        <div class="hero-brand" style="margin-bottom:24px">{c.hero.eyebrowA}<span>{c.hero.eyebrowB}</span></div>
        <h1 style="font-size:clamp(38px,4.6vw,56px);line-height:1.05;margin-bottom:24px">{c.hero.h1a} <span class="hero-h1-b">{c.hero.h1b}</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:rgba(255,255,255,.78);max-width:560px;text-wrap:pretty">{c.hero.sub}</p>
        <p class="hero-start">{c.hero.start}</p>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:30px">
          <Button href={c.hero.cta.href}>{c.hero.cta.label} &rarr;</Button>
          <a href={c.hero.secondary.href} class="on-dark-link" style="font-weight:600;font-size:16px;color:var(--white)">{c.hero.secondary.label} &rarr;</a>
        </div>
      </div>
      <div class="hv">
        <div class="hv-lbl">{c.hero.veldenLabel}</div>
        <ul class="hv-list">{c.hero.velden.map((v) => <li>{v}</li>)}</ul>
      </div>
    </div>
    </div>
  </section>

  <!-- BEWIJSREGEL — expertise die achter Finable beschikbaar is. De noot staat er bewust bij:
       zonder die afbakening leest de regel als de bezetting die iedere klant krijgt. -->
  <section class="wrap bw-sec">
    <div class="bw">
      {c.bewijs.items.map((it) => (
        <div class="bw-i"><span class="bw-k">{it.k}</span><span class="bw-p">{it.p}</span></div>
      ))}
    </div>
    <p class="bw-note">{c.bewijs.note}</p>
  </section>

  <!-- HERKENNING — situaties, geen diagnose: niet ieder groeiend bedrijf heeft deze vanzelf. -->
  <section class="wrap" style="padding-top:clamp(44px,4.4vw,60px);padding-bottom:clamp(44px,4.4vw,60px)">
    <div class="lbl" style="margin-bottom:18px">{c.herken.label}</div>
    <h2 style="font-size:clamp(26px,3.2vw,38px);margin-bottom:clamp(28px,3vw,38px);text-wrap:balance">{c.herken.h2}</h2>
    <div class="cols3">
      {c.herken.items.map((it) => (
        <div>
          <h3 style="font-size:19px;margin-bottom:10px;text-wrap:balance">{it.h3}</h3>
          <p style="font-size:15px;color:var(--body);line-height:1.6;text-wrap:pretty">{it.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WERK EN OPLEVERING — vier regels, geen kaarten. Doel van de hero-link 'Dit kunnen we
       overnemen'; vandaar het id en de scroll-marge onder de header. -->
  <section id="werk" class="werk-sec" style="background:var(--section)">
    <div class="wrap" style="padding-top:clamp(44px,4.4vw,60px);padding-bottom:clamp(44px,4.4vw,60px)">
      <div class="lbl" style="margin-bottom:18px">{c.werk.label}</div>
      <h2 style="font-size:clamp(26px,3.2vw,38px);margin-bottom:12px;text-wrap:balance">{c.werk.h2}</h2>
      <p style="font-size:16px;color:var(--body);max-width:640px;margin-bottom:clamp(28px,3vw,38px);text-wrap:pretty">{c.werk.sub}</p>
      <div class="wk">
        {c.werk.items.map((it) => (
          <div class="wk-r">
            <h3 class="wk-h">{it.h3}</h3>
            <p class="wk-p">{it.p}</p>
          </div>
        ))}
      </div>
      {c.werk.verderLezen.length > 0 && (
        <p class="wk-meer">{c.werk.verderLezenLabel}: {c.werk.verderLezen.map((l, i) => (
          <>{i > 0 && <span class="wk-sep"> &middot; </span>}<a href={l.href}>{l.label}</a></>
        ))}</p>
      )}
    </div>
  </section>

  <!-- KLANTCASE — de goedgekeurde quote en de case dragen het bewijs. Geen resultaten,
       percentages of aantallen: die zijn niet bevestigd. -->
  <section class="wrap" style="padding-top:clamp(44px,4.4vw,60px);padding-bottom:clamp(44px,4.4vw,60px)">
    <div class="lbl" style="margin-bottom:18px">{c.case.label}</div>
    <h2 style="font-size:clamp(24px,2.8vw,34px);margin-bottom:clamp(28px,3vw,38px);text-wrap:balance">{c.case.h2}</h2>
    <div class="case">
      <div class="case-l">
        <img src="/images/the-good-roll.png" alt={c.case.logoAlt} width="662" height="663" loading="lazy" style="width:64px;height:64px;border-radius:999px;display:block;margin-bottom:16px">
        <div style="font-size:15px;color:var(--body)">{c.case.persoon}</div>
      </div>
      <div>
        <p class="case-q">{c.case.quoteA}<span style="color:var(--terracotta)">{c.case.quoteB}</span></p>
        <p style="font-size:16px;color:var(--body);max-width:620px;text-wrap:pretty">{c.case.body}</p>
        <a href={c.case.link.href} data-case-link="the_good_roll" style="display:inline-block;margin-top:16px;font-size:15px;font-weight:600">{c.case.link.label} &rarr;</a>
      </div>
      <div class="case-img"><img src="/images/sander-the-good-roll.webp" alt={c.case.fotoAlt} width="1200" height="711" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
    </div>
  </section>

  <!-- MENSEN EN EXPERTISE — inclusief de transparante toelichting over waar het team werkt.
       Die hoort hier en niet in de hero. -->
  <section class="mn-sec" style="background:var(--terracotta-tint)">
    <div class="wrap" style="padding-top:clamp(44px,4.4vw,60px);padding-bottom:clamp(44px,4.4vw,60px)">
      <div class="mn">
        <div>
          <div class="lbl" style="margin-bottom:18px">{c.mensen.label}</div>
          <h2 style="font-size:clamp(24px,2.8vw,34px);margin-bottom:18px;text-wrap:balance">{c.mensen.h2}</h2>
          <p style="font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty">{c.mensen.body}</p>
          <p class="mn-toe">{c.mensen.toelichting}</p>
          <a href={c.mensen.link.href} class="mn-a">{c.mensen.link.label} &rarr;</a>
        </div>
        <div class="mn-p">
          {c.mensen.personen.map((p) => (
            <div class="mn-c">
              <img src={p.foto} alt={p.alt} width="800" height="699" loading="lazy" class="mn-img">
              <div>
                <div class="mn-n">{p.naam}</div>
                <div class="mn-r">{p.rol}</div>
                <div class="mn-s">{p.sub}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* KANTOREN — aanvullende markt, bewust ingetogen: een dunne regel, geen kaart, geen tint en een
      tekstlink in plaats van een knop. De homepage blijft van de hoofdclaim. De toelichting staat
      in een JSX-comment: een HTML-comment zou ook op /en belanden, waar de banner niet bestaat. */}
  {c.kantoren && (
    <section class="wrap" style="padding-top:clamp(32px,2.8vw,40px);padding-bottom:28px">
      <div class="rule" style="margin-bottom:clamp(20px,1.8vw,24px)"></div>
      <div class="kb">
        <div>
          <div class="lbl" style="margin-bottom:10px">{c.kantoren.label}</div>
          <h2 class="kb-h">{c.kantoren.h2}</h2>
          <p class="kb-p">{c.kantoren.p}</p>
        </div>
        <a href={c.kantoren.cta.href} class="kb-a">{c.kantoren.cta.label} &rarr;</a>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="wrap" style="padding-top:clamp(38px,4vw,50px);padding-bottom:clamp(42px,4.4vw,56px)">
    <div class="lbl" style="margin-bottom:22px">{c.faq.label}</div>
    <div style="max-width:900px">
      {c.faq.items.map((f) => (
        <details class="fin-faq"><summary><span class="fin-faq-q">{f.q}</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>{f.a}</p></div></details>
      ))}
    </div>
    <div style="margin-top:24px"><a href={c.faq.alle.href} style="font-weight:600;font-size:15px;color:var(--terracotta)">{c.faq.alle.label} &rarr;</a></div>
  </section>

  <!-- STARTEN (navy) — laatste sectie, en daarmee de 'closing' CTA in de meetlaag. -->
  <section class="st-sec" style="background:var(--navy)">
    <div class="wrap" style="padding-top:clamp(46px,4.6vw,62px);padding-bottom:clamp(46px,4.6vw,62px)">
      <div class="st">
        <div>
          <div class="lbl" style="margin-bottom:18px">{c.starten.label}</div>
          <h2 style="font-size:clamp(26px,3.2vw,38px);color:var(--white);margin-bottom:16px;text-wrap:balance">{c.starten.h2}</h2>
          <p style="font-size:16px;color:var(--on-dark-secondary);max-width:560px;text-wrap:pretty">{c.starten.p}</p>
          <ol class="st-steps">
            {c.starten.stappen.map((s, i) => (
              <li>
                <span class="st-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="st-h">{s.h3}</span>
                <span class="st-p">{s.p}</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="st-cta">
          <div class="tim-row" style="display:grid;grid-template-columns:clamp(110px,13vw,140px) minmax(0,1fr);gap:22px;align-items:center;margin-bottom:24px">
            <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt={c.starten.timAlt} width="800" height="699" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
            <div style="font-size:14px;color:var(--on-dark-secondary);line-height:1.45"><span style="font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--white)">{c.starten.timNaam}</span><br>{c.starten.timRol}</div>
          </div>
          <Button href={c.starten.cta.href}>{c.starten.cta.label} &rarr;</Button>
          <p class="st-ger">{c.starten.gerust}</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</div>

<style is:global>
  /* Hero-brandline: klein en uppercase boven de H1; alleen 'in-house.' krijgt het terracotta-accent. */
  .hero-brand{font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--on-dark-secondary)}
  .hero-brand span{color:var(--terracotta)}
  /* Zodra de hero éénkolommig wordt, krijgt "Elke maand." een eigen regel: hetzelfde ritme als op desktop,
     en op mobiel voorkomt het dat de balanced wrap midden in "Wij runnen je finance." breekt. */
  @media (max-width:1023px){ .hero-h1-b{display:block} }
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  .on-dark-link:hover{color:var(--terracotta);opacity:1}

  /* De 'begin met één onderdeel'-regel: direct onder de introductie, iets rustiger gezet zodat de
     introductie de kop blijft dragen en deze regel de drempel verlaagt. */
  .hero-start{margin-top:16px;padding-left:16px;border-left:2px solid var(--terracotta);font-size:16px;color:var(--on-dark-secondary);line-height:1.6;max-width:560px;text-wrap:pretty}

  /* Hero-kolom rechts: de vier werkgebieden, puur typografisch op dunne lijnen. */
  .hv-lbl{font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;color:var(--terracotta);margin-bottom:14px}
  .hv-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--on-dark-line)}
  .hv-list li{padding:14px 0;border-bottom:1px solid var(--on-dark-line);font-family:'Playfair Display',Georgia,serif;font-size:clamp(17px,1.5vw,21px);color:var(--white);line-height:1.25}

  /* BEWIJSREGEL: één compacte strook tussen twee dunne lijnen, geen kaarten. */
  .bw-sec{padding-top:clamp(26px,2.6vw,34px);padding-bottom:clamp(26px,2.6vw,34px)}
  .bw{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .bw-i{display:flex;align-items:baseline;gap:12px;padding:18px 26px}
  .bw-i:first-child{padding-left:0}
  .bw-i+.bw-i{border-left:1px solid var(--line)}
  .bw-k{font-family:'Playfair Display',Georgia,serif;font-size:clamp(22px,2.4vw,30px);color:var(--terracotta);line-height:1;flex-shrink:0}
  .bw-p{font-size:15px;color:var(--body);line-height:1.5;text-wrap:pretty}
  .bw-note{margin-top:16px;max-width:760px;font-size:14px;color:var(--body);line-height:1.6;text-wrap:pretty}

  .cols3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}
  .cols3>div{padding:0 28px;border-left:1px solid var(--line)}
  .cols3>div:first-child{padding-left:0;border-left:none}

  /* WERK: vier regels op dunne lijnen. Titel links, oplevering rechts, zodat het blok in één
     oogopslag te scannen is en op mobiel netjes onder elkaar valt. */
  .wk{border-top:1px solid var(--line)}
  .wk-r{display:grid;grid-template-columns:minmax(0,0.42fr) minmax(0,1fr);gap:clamp(16px,3vw,48px);align-items:baseline;padding:15px 0;border-bottom:1px solid var(--line)}
  .wk-h{font-size:clamp(17px,1.7vw,20px);line-height:1.3}
  .wk-p{font-size:15.5px;color:var(--body);line-height:1.6;text-wrap:pretty}
  .wk-meer{margin-top:22px;font-size:14.5px;color:var(--body);line-height:1.7;text-wrap:pretty}
  .wk-meer a{font-weight:600;color:var(--navy)}
  .wk-sep{color:var(--body);opacity:.5}
  /* De hero-link springt hierheen; de ankerpositie moet niet onder de header vallen. */
  .werk-sec{scroll-margin-top:12px}

  /* KLANTCASE */
  .case{display:grid;grid-template-columns:auto minmax(0,1.7fr) clamp(185px,19vw,245px);gap:clamp(24px,3.5vw,48px);align-items:center}
  .case-q{font-family:'Playfair Display',serif;font-size:clamp(23px,2.8vw,34px);color:var(--navy);line-height:1.2;margin-bottom:20px;text-wrap:balance}
  .case-img{aspect-ratio:1200/711;border-radius:12px;overflow:hidden}

  /* MENSEN: tekst links, twee profielen rechts. Bestaande foto's, geen nieuwe beeldtaal. */
  .mn{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,0.95fr);gap:clamp(32px,4.4vw,64px);align-items:start}
  .mn-toe{margin-top:18px;padding-left:16px;border-left:2px solid var(--terracotta);font-size:15px;color:var(--body);line-height:1.65;text-wrap:pretty}
  .mn-a{display:inline-block;margin-top:20px;font-size:15px;font-weight:600;color:var(--terracotta)}
  .mn-p{display:grid;gap:20px}
  .mn-c{display:grid;grid-template-columns:clamp(84px,9vw,104px) minmax(0,1fr);gap:20px;align-items:center;padding-top:20px;border-top:1px solid var(--line)}
  .mn-c:first-child{padding-top:0;border-top:none}
  .mn-img{width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:12px;display:block}
  .mn-n{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:18px;color:var(--navy);line-height:1.2}
  .mn-r{margin-top:4px;font-size:14px;color:var(--terracotta);font-weight:600}
  .mn-s{margin-top:3px;font-size:14px;color:var(--body);line-height:1.5}

  /* KANTOREN-banner: tekst links, tekstlink rechts. Geen kaart, geen achtergrond, alleen een
     dunne regel erboven. Zo blijft de aanvullende markt zichtbaar zonder een tweede propositie
     te suggereren. */
  .kb{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(20px,3vw,48px);align-items:center}
  .kb-h{font-size:clamp(19px,1.6vw,22px);line-height:1.22;margin-bottom:8px;text-wrap:balance}
  .kb-p{font-size:15.5px;color:var(--body);line-height:1.6;max-width:620px;text-wrap:pretty}
  .kb-a{font-size:15px;font-weight:600;color:var(--terracotta);white-space:nowrap}

  /* FAQ */
  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:30px;padding:22px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(17px,1.7vw,20px);color:var(--navy);line-height:1.35;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:17px;height:17px;flex-shrink:0;margin-top:6px}
  .fin-faq-ic::before,.fin-faq-ic::after{content:"";position:absolute;background:var(--terracotta);transition:opacity .2s}
  .fin-faq-ic::before{left:0;top:7.5px;width:17px;height:2px}
  .fin-faq-ic::after{left:7.5px;top:0;width:2px;height:17px}
  details.fin-faq[open] .fin-faq-ic::after{opacity:0}
  details.fin-faq>summary:hover .fin-faq-q{color:var(--terracotta)}
  .fin-faq-a{max-width:720px;padding:0 0 26px;font-size:15.5px;color:var(--body);line-height:1.72}

  /* STARTEN: drie stappen links, Tim en de CTA rechts. */
  .st{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,0.9fr);gap:clamp(36px,4.6vw,68px);align-items:start}
  .st-steps{list-style:none;margin:clamp(28px,3vw,36px) 0 0;padding:0;border-top:1px solid var(--on-dark-line)}
  .st-steps li{display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:18px;padding:14px 0;border-bottom:1px solid var(--on-dark-line)}
  .st-n{grid-row:1/3;font-size:12px;font-weight:600;letter-spacing:0.14em;color:var(--terracotta);padding-top:4px}
  .st-h{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:17px;color:var(--white);line-height:1.3}
  .st-p{margin-top:4px;font-size:15px;color:var(--on-dark-secondary);line-height:1.55;text-wrap:pretty}
  .st-cta{border-left:1px solid var(--on-dark-line);padding-left:clamp(28px,3vw,48px)}
  .st-ger{margin-top:20px;font-size:14.5px;color:var(--on-dark-secondary);line-height:1.6;text-wrap:pretty}

  /* ---------- Responsief ---------- */
  @media (max-width:1023px){
    .hero{grid-template-columns:1fr!important;gap:36px!important}
    .cols3{grid-template-columns:1fr 1fr}
    .cols3>div{padding:20px 0 0;border-left:none;border-top:1px solid var(--line)}
    .cols3>div:nth-child(-n+2){border-top:none;padding-top:0}
    .case{grid-template-columns:1fr!important;gap:26px!important}
    .case-img{max-width:420px}
    .mn{grid-template-columns:1fr;gap:32px}
    .st{grid-template-columns:1fr!important;gap:36px!important}
    .st-cta{border-left:none;padding-left:0;border-top:1px solid var(--on-dark-line);padding-top:32px}
    .tim-row{grid-template-columns:clamp(110px,16vw,140px) minmax(0,1fr)!important}
  }
  @media (max-width:767px){
    .bw{grid-template-columns:1fr;border-bottom:none}
    .bw-i{padding:14px 0;border-left:none!important;border-bottom:1px solid var(--line)}
    .wk-r{grid-template-columns:1fr;gap:6px;padding:16px 0}
    .kb{grid-template-columns:1fr;gap:4px;align-items:start}
    .kb-a{white-space:normal}
  }
  @media (max-width:639px){
    .cols3{grid-template-columns:1fr!important}
    .cols3>div{padding:18px 0 0!important;border-top:1px solid var(--line)!important}
    .cols3>div:first-child{border-top:none!important;padding-top:0!important}
    .mn-c{grid-template-columns:72px minmax(0,1fr);gap:16px}
    .hv-list li{padding:12px 0}
  }
</style>
