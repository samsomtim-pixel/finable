---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

const stages = [
  { title: 'Transaction volumes rise', text: 'There are more invoices, bank transactions and exceptions to handle. A month-end close that once took a few checks starts to slip.' },
  { title: 'The work gets more complex', text: 'A second entity, an overseas customer or a new investment can add work that your existing processes weren’t set up to handle.' },
  { title: 'More people need answers', text: 'Management, investors, your bank and your accountant need reliable figures. Late reports make it harder to see where your cash and margins stand.' },
];

const work = [
  { title: 'Day-to-day finance', text: 'Bookkeeping, invoicing, banking, accounts receivable and accounts payable.' },
  { title: 'Month-end close', text: 'Reconciliations, checks and a predictable close.' },
  { title: 'Financial control', text: 'Checks on the quality of the figures, analysis of variances, margins and cash flow.' },
  { title: 'Reporting and insight', text: 'Management reporting, KPIs and forecasts where appropriate.' },
];

const faq = [
  { question: 'Can we keep working with our bookkeeper or accountant?', answer: 'Yes. We look at what already works and agree who takes care of each part before we start.' },
  { question: 'Will our CFO or finance manager stay in charge?', answer: 'Yes. Your team keeps control of strategy, budgets and approvals. Finable runs the agreed work and prepares the numbers and reports you use to decide.' },
  { question: 'Who does the work?', answer: 'You have one dedicated point of contact in the Netherlands. The team working from India gets to know your business, processes and systems. Checks and reviews are part of the way we work.' },
  { question: 'How is the monthly price set?', answer: 'We agree a fixed monthly price before we start, based on the work we take on, its volume and its complexity.' },
];
---
<Layout
  title="Finance for scale-ups and growing businesses | Finable"
  description="Finable runs bookkeeping, month-end close, financial control and reporting for growing businesses. Get a dedicated team or support for your existing team."
  breadcrumbs={[{ name: 'Home', path: '/en' }, { name: 'Growing businesses' }]}
>
  <Header />
  <main>
    <section class="hero-navy growth-hero">
      <div class="wrap growth-section">
        <div class="lbl">Finance for scale-ups</div>
        <h1>Your business is growing. <span class="em">Your finance needs to keep up.</span></h1>
        <p>More customers, transactions and reporting requirements can stretch the finance setup you started with. Finable runs the day-to-day work, from bookkeeping and month-end close to financial control and reporting.</p>
        <Button href="/en/book-a-call">Book a call &rarr;</Button>
      </div>
    </section>

    <section class="wrap growth-section">
      <h2>What changes as you grow?</h2>
      <div class="growth-grid">
        {stages.map(({ title, text }) => (
          <div><h3>{title}</h3><p>{text}</p></div>
        ))}
      </div>
      <p>Considering a bookkeeper, controller or finance manager? <a href="/en/finance-hire">Compare an in-house hire with a finance team &rarr;</a></p>
    </section>

    <section class="growth-model">
      <div class="wrap growth-section">
        <h2>One finance team, with a scope that can grow with you</h2>
        <p>Start with a specific part of the work, add capacity alongside your CFO or finance manager, or ask us to run the full finance function. We agree who owns each task and work in your systems, with one dedicated point of contact in the Netherlands.</p>
        <div class="growth-grid">
          {work.map(({ title, text }) => (
            <div><h3>{title}</h3><p>{text}</p></div>
          ))}
        </div>
        <p><a href="/en/how-it-works">See how we agree the scope and work together each month &rarr;</a></p>
      </div>
    </section>

    <section class="wrap growth-section">
      <div class="lbl">Customer story</div>
      <h2>The Good Roll</h2>
      <p>The Good Roll started with bookkeeping support. Finable now handles almost all of its day-to-day finance, with one point of contact and a team behind it.</p>
      <a href="/en/cases/the-good-roll">Read The Good Roll case study &rarr;</a>
    </section>

    <section class="wrap growth-section growth-faq">
      <h2>Frequently asked questions</h2>
      {faq.map(({ question, answer }) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </section>

    <section class="hero-navy growth-hero">
      <div class="wrap growth-section">
        <h2>What does your next stage of growth need from finance?</h2>
        <p>Talk to Tim about how your finance works today and what your team could use help with.</p>
        <div class="growth-actions">
          <Button href="/en/book-a-call">Book a call &rarr;</Button>
          <a href="/en/estimate">Get an estimate &rarr;</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .growth-hero { background: var(--navy); color: var(--white); }
  .growth-hero p { color: var(--on-dark-secondary); }
  .growth-hero h2, .growth-hero a { color: var(--white); }
  .growth-section { padding-block: clamp(44px, 6vw, 80px); }
  h1 { font-size: clamp(34px, 5vw, 62px); line-height: 1.08; max-width: 850px; }
  h2 { font-size: clamp(26px, 3.5vw, 42px); line-height: 1.15; max-width: 780px; }
  h3 { font-size: 20px; line-height: 1.25; }
  h1, h2 { text-wrap: balance; }
  p { max-width: 680px; margin-block: 16px 24px; text-wrap: pretty; }
  .lbl { margin-bottom: 16px; }
  a { font-weight: 600; }
  .growth-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 24px 32px;
    margin-block: 28px;
  }
  .growth-grid > div { border-top: 1px solid var(--line); padding-top: 18px; }
  .growth-grid p { margin-bottom: 0; }
  .growth-model { background: #f3f3f1; }
  .growth-faq { border-top: 1px solid var(--line); }
  .growth-faq h2 { margin-bottom: 22px; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; color: var(--navy); padding-block: 16px; }
  .growth-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
</style>
