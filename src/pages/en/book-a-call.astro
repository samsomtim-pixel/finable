---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
// Booking runs through Calendly (inline embed, loaded on this page only). See the script at the bottom.
---
<Layout title="Book a call · Finable" description="Book 30 minutes with Tim. We'll look at how your finance is organised today, where things get stuck and what Finable could take over.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- The whole page sits on navy; the booking card is white. -->
  <section class="talk-navy hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:72px">
    <div class="layout">

      <!-- LEFT -->
      <div class="talk-left">
        <div class="lbl" style="margin-bottom:20px">Book a call</div>
        <h1 style="font-size:clamp(32px,4.4vw,52px);margin-bottom:22px;text-wrap:balance">Let's look at how your finance <span class="em">works today.</span></h1>
        <p style="font-size:clamp(16px,1.8vw,19px);color:var(--on-dark-secondary);max-width:500px;margin-bottom:44px;text-wrap:pretty">In 30 minutes, we'll talk through how your finance is organised today, where things get stuck and what Finable could take over. No lengthy intake. Just a conversation to see if there's a fit.</p>

        <div style="position:relative">
          <div style="position:absolute;left:9px;top:12px;bottom:60px;width:1px;background:var(--line)"></div>
          <div style="display:flex;flex-direction:column;gap:26px">
            <div style="display:flex;gap:20px">
              <span class="stepnum">01</span>
              <div><div class="st">Where you are today</div><div class="sd">How finance is currently organised and where things are getting stuck.</div></div>
            </div>
            <div style="display:flex;gap:20px">
              <span class="stepnum">02</span>
              <div><div class="st">What Finable could take over</div><div class="sd">From one part of finance to almost the entire day-to-day function.</div></div>
            </div>
            <div style="display:flex;gap:20px">
              <span class="stepnum">03</span>
              <div><div class="st">Whether it's a good fit</div><div class="sd">A straightforward view of what makes sense for your organisation, even if Finable isn't the answer.</div></div>
            </div>
          </div>
        </div>

        <div style="border-top:1px solid var(--on-dark-line);margin-top:36px;padding-top:26px;position:relative">
          <div style="font-size:15px;color:var(--on-dark-secondary);margin-bottom:8px">Prefer to write first?</div>
          <a href="mailto:tim@finable.nl" style="display:inline-flex;align-items:center;gap:10px;font-family:'Playfair Display',serif;font-size:21px;color:var(--terracotta)">
            <svg width="20" height="20" viewBox="0 0 22 22" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><rect x="2" y="4" width="18" height="14" rx="2"/><path d="M3 6l8 6 8-6"/></svg>
            tim@finable.nl &rarr;
          </a>
          <div class="mail-note" style="position:absolute;right:0;top:14px;width:130px;text-align:center;pointer-events:none">
            <div class="cav" style="font-size:21px">Direct contact with the founder.</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: BOOKING (white on navy) — Calendly inline; the script is loaded on this page only -->
      <div class="book-card" style="background:var(--white);border:1px solid var(--line);border-radius:14px;padding:clamp(24px,3vw,34px)">
        <div class="book-split" style="display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;margin-bottom:26px">
          <div>
            <div class="lbl" style="margin-bottom:12px">You'll speak with Tim</div>
            <h2 style="font-size:clamp(22px,2.4vw,28px);line-height:1.14;margin-bottom:8px;color:var(--navy)">Book your call with Tim.</h2>
            <div style="font-size:15px;color:var(--body)">30 minutes · Online</div>
          </div>
          <div style="width:84px;height:84px;border-radius:14px;overflow:hidden;flex-shrink:0"><img src="/images/tim-samsom.webp" alt="Tim Samsom, founder of Finable" width="800" height="699" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        </div>

        <div style="height:1px;background:var(--line);margin-bottom:8px"></div>

        <div class="calendly-inline-widget" data-calendly data-url="https://calendly.com/tim-finable/30min?hide_gdpr_banner=1&amp;hide_event_type_details=1&amp;background_color=ffffff&amp;text_color=1b3a5c&amp;primary_color=c4643a" style="width:100%;min-width:0;overflow:hidden" aria-label="Pick a date and time for your call with Tim"></div>
        <noscript><p style="font-size:15px;color:var(--body)">Book your call via <a href="https://calendly.com/tim-finable/30min" style="font-weight:600">Calendly</a>.</p></noscript>
        <div style="display:flex;align-items:center;gap:8px;justify-content:center;margin-top:14px">
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><rect x="3" y="8" width="12" height="8" rx="1.5"/><path d="M6 8V6a3 3 0 016 0v2"/></svg>
          <span style="font-size:13px;color:var(--body)">No obligations. You'll receive a confirmation by email.</span>
        </div>
      </div>

    </div>

    <div class="talk-foot" style="max-width:1240px;margin-top:28px;font-size:15px;color:var(--on-dark-secondary)">Prefer an estimate first? <a href="/en/estimate" style="font-weight:600">Get an estimate &rarr;</a></div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  body{line-height:1.6}
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  h1,h2,h3{line-height:1.12}
  .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--terracotta);line-height:1.1}
  .layout{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,0.98fr);gap:clamp(40px,4.6vw,64px);align-items:start}
  .stepnum{position:relative;z-index:1;width:20px;height:20px;border-radius:999px;background:rgba(196,100,58,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:'Playfair Display',serif;font-size:11px;font-weight:600;color:var(--terracotta);margin-top:2px}
  .talk-left .st{font-family:'Playfair Display',serif;font-weight:600;color:var(--white);font-size:19px;margin-bottom:3px}
  .talk-left .sd{font-size:15px;color:var(--on-dark-secondary)}
  /* Calendly: basis- én minimumhoogte in CSS. De iframe is 100% van deze container; de min-height voorkomt dat een
     (te) kleine page_height-melding de widget ooit kan laten dichtklappen. Groei komt uit het script hieronder. */
  .calendly-inline-widget{height:660px;min-height:660px}
  @media (max-width:1023px){
    .layout{grid-template-columns:1fr!important;gap:40px!important}
    .book-split{grid-template-columns:1fr!important}
  }
  @media (max-width:639px){
    .mail-note{display:none}
    /* Calendly iframe out to the card edge so the calendar is not cramped on narrow screens */
    .calendly-inline-widget{margin:0 -24px;width:auto!important;height:640px;min-height:640px}
    /* Order: intro → 01–03 → Tim/booking → direct contact */
    .layout{display:flex!important;flex-direction:column;gap:0!important}
    .layout>div:first-child{display:contents}
    .layout>div:first-child>div:last-child{order:2}
    .layout>div:last-child{order:1;margin-top:36px}
    .book-split{grid-template-columns:1fr auto!important;gap:16px!important}
  }
</style>

<script>
  // Calendly inline embed, alleen op deze pagina. Het externe script wordt één keer toegevoegd (guard op src).
  // Luistert naar Calendly's postMessage-events: hoogte volgen (geen geneste scrollbalk) en, uitsluitend na een
  // bevestigde afspraak (calendly.event_scheduled), 'book_call_complete' naar de dataLayer voor GTM/GA4.
  const widget = document.querySelector<HTMLElement>('[data-calendly]');
  if (widget) {
    const SRC = 'https://assets.calendly.com/assets/external/widget.js';
    if (!document.querySelector('script[src="' + SRC + '"]')) {
      const s = document.createElement('script');
      s.src = SRC; s.async = true;
      document.head.appendChild(s);
    }
    type CalendlyMessage = { event?: string; payload?: { height?: string } };
    window.addEventListener('message', (e: MessageEvent<CalendlyMessage | null>) => {
      if (e.origin !== 'https://calendly.com') return;
      const d = e.data;
      if (!d || typeof d.event !== 'string') return;
      if (d.event === 'calendly.page_height') {
        // Calendly stuurt body.scrollHeight + 2 via een ResizeObserver; de eerste melding komt vóór de inhoud is
        // gerenderd (dus "2px"). Blind overnemen klapt de iframe dicht en houdt hem dicht. Daarom: alleen groeien
        // boven de CSS-ondergrens, anders terug naar de basis (geen leeg vlak onder de widget).
        const h = parseFloat(String(d.payload?.height ?? ''));
        const min = parseFloat(getComputedStyle(widget).minHeight) || 600;
        if (Number.isFinite(h) && h > 0 && h < 6000) widget.style.height = h > min ? Math.ceil(h) + 'px' : '';
      }
      if (d.event === 'calendly.event_scheduled') {
        const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
        w.dataLayer = w.dataLayer || [];
        w.dataLayer.push({ event: 'book_call_complete', booking_provider: 'calendly', booking_type: '30min' });
      }
    });
  }
</script>
