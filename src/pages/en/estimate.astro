---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT_INDICATIE ?? '';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
---
<Layout title="Get an estimate — Finable" description="Answer a few questions about your organisation and finance setup. The Finable team reviews your situation and sends you an initial estimate of the monthly cost.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) -->
  <section class="hero-navy ind-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:52px;padding-bottom:52px">
    <div class="ind-hero" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,0.9fr);gap:48px;align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:20px">Get an estimate</div>
        <h1 style="font-size:clamp(34px,4.6vw,54px);margin-bottom:22px;text-wrap:balance">What would Finable cost for your organisation?</h1>
        <p style="font-size:clamp(16px,1.9vw,19px);color:rgba(255,255,255,.78);max-width:500px;margin-bottom:22px;text-wrap:pretty">Answer a few questions about your organisation and finance setup. The Finable team will review your situation and send you an initial estimate of the monthly cost within two business days.</p>
        <div style="display:flex;align-items:center;gap:14px"><span style="width:32px;height:2px;background:var(--terracotta);flex-shrink:0"></span><span style="font-size:14px;color:rgba(255,255,255,.78)">No standard package. No price based on revenue.</span></div>
      </div>
      <!-- STEP INDICATOR (kleuren via [data-active] in CSS) -->
      <div class="ind-steps" style="display:flex;align-items:center;justify-content:center;gap:0">
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px">
          <div class="stepdot" data-stepdot="1" data-active="1">01</div>
          <div class="steplabel" data-steplabel="1" data-active="1">Organisation</div>
        </div>
        <div class="stepline" data-stepline="1"></div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px">
          <div class="stepdot" data-stepdot="2" data-active="0">02</div>
          <div class="steplabel" data-steplabel="2" data-active="0">Finance</div>
        </div>
        <div class="stepline" data-stepline="2"></div>
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px">
          <div class="stepdot" data-stepdot="3" data-active="0">03</div>
          <div class="steplabel" data-steplabel="3" data-active="0">Estimate</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- MAIN LAYOUT -->
  <section class="wrap" style="padding-top:16px;padding-bottom:80px">
    <div class="fin-layout">

      <!-- LEFT CONTEXT (sticky) -->
      <div class="fin-left">
        <div style="min-height:200px">
          <div data-leftstep="1">
            <div style="font-family:'Playfair Display',serif;font-size:clamp(48px,6vw,72px);color:var(--terracotta);line-height:.9;margin-bottom:16px">01</div>
            <h2 style="font-size:clamp(24px,3vw,32px);color:var(--navy);margin-bottom:14px">Your organisation.</h2>
            <p style="font-size:16px;color:var(--body);max-width:340px">First, tell us a little about your organisation. Its size and structure help us estimate how much finance work sits behind it.</p>
          </div>
          <div data-leftstep="2" style="display:none">
            <div style="font-family:'Playfair Display',serif;font-size:clamp(48px,6vw,72px);color:var(--terracotta);line-height:.9;margin-bottom:16px">02</div>
            <h2 style="font-size:clamp(24px,3vw,32px);color:var(--navy);margin-bottom:14px">Your finance.</h2>
            <p style="font-size:16px;color:var(--body);max-width:340px">We don't have to take over everything. Tell us how finance is organised today and which parts Finable might take over.</p>
          </div>
          <div data-leftstep="3" style="display:none">
            <div style="font-family:'Playfair Display',serif;font-size:clamp(48px,6vw,72px);color:var(--terracotta);line-height:.9;margin-bottom:16px">03</div>
            <h2 style="font-size:clamp(24px,3vw,32px);color:var(--navy);margin-bottom:14px">Your estimate.</h2>
            <p style="font-size:16px;color:var(--body);max-width:340px">Enough to make an initial assessment. Leave your details below and the Finable team will review your answers and send you a personalised estimate within two business days.</p>
          </div>
        </div>

        <!-- personal module -->
        <div style="background:var(--terracotta-soft);border-radius:12px;padding:28px 30px;margin:28px 0;max-width:360px">
          <div class="lbl" style="margin-bottom:14px">Personally reviewed</div>
          <h3 style="font-family:'Playfair Display',serif;font-size:22px;color:var(--navy);margin-bottom:12px">Reviewed by the Finable team.</h3>
          <p style="font-size:14px;color:var(--body);line-height:1.6">The Finable team reviews your answers and prepares an initial estimate based on your situation. So you'll quickly have an idea of what Finable could look like for your organisation.</p>
        </div>
      </div>

      <!-- RIGHT: FORM CARD -->
      <form data-indicatie-form data-endpoint={endpoint} data-access-key={accessKey} data-lang="en" data-subject="New estimate request via finable.nl" data-busy="Sending…" novalidate style="background:var(--white);border:1px solid var(--line);border-radius:12px;padding:clamp(28px,3.5vw,44px)">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" aria-hidden="true">

        <!-- STEP 1 -->
        <div data-formstep="1">
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:4px">How many people work at your company?</h3>
            <p style="font-size:14px;color:var(--body);margin-bottom:16px">Choose the number of employees.</p>
            <div class="fin-grid4">
              <button type="button" class="fin-tile" data-tile data-group="grootte" data-value="1–10"><svg width="26" height="26" viewBox="0 0 28 28" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><circle cx="14" cy="10" r="4.5"/><path d="M6 23c0-4.5 3.5-7 8-7s8 2.5 8 7"/></svg>1–10</button>
              <button type="button" class="fin-tile" data-tile data-group="grootte" data-value="10–25"><svg width="30" height="26" viewBox="0 0 34 28" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><circle cx="17" cy="9" r="4"/><circle cx="7" cy="12" r="3"/><path d="M9 23c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"/></svg>10–25</button>
              <button type="button" class="fin-tile" data-tile data-group="grootte" data-value="25–50"><svg width="32" height="26" viewBox="0 0 38 28" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><circle cx="19" cy="9" r="4"/><circle cx="8" cy="12" r="3"/><circle cx="30" cy="12" r="3"/><path d="M10 23c0-4 4-6.5 9-6.5s9 2.5 9 6.5"/></svg>25–50</button>
              <button type="button" class="fin-tile" data-tile data-group="grootte" data-value="50+"><svg width="34" height="26" viewBox="0 0 40 28" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><circle cx="20" cy="8" r="3.5"/><circle cx="9" cy="11" r="3"/><circle cx="31" cy="11" r="3"/><circle cx="14" cy="13" r="2.5"/><circle cx="26" cy="13" r="2.5"/><path d="M8 24c0-4 5-6 12-6s12 2 12 6"/></svg>50+</button>
            </div>
          </div>
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:4px">How many legal entities do you have?</h3>
            <p style="font-size:14px;color:var(--body);margin-bottom:16px">Think of companies, countries or divisions.</p>
            <div class="fin-grid3">
              <button type="button" class="fin-tile" data-tile data-group="entiteiten" data-value="1">1</button>
              <button type="button" class="fin-tile" data-tile data-group="entiteiten" data-value="2–3">2–3</button>
              <button type="button" class="fin-tile" data-tile data-group="entiteiten" data-value="4+">4+</button>
            </div>
          </div>
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:4px"><label for="fin-branche" style="font:inherit;color:inherit">Which industry is your organisation in?</label></h3>
            <p style="font-size:14px;color:var(--body);margin-bottom:16px">It gives us an early picture of your environment.</p>
            <select id="fin-branche" name="branche" data-branche class="fin-select">
              <option value="">Choose your industry…</option>
              <option>Professional services</option>
              <option>SaaS / Technology</option>
              <option>E-commerce / Retail</option>
              <option>Manufacturing</option>
              <option>Financial services</option>
              <option>Healthcare</option>
              <option>Hospitality</option>
              <option>Other</option>
            </select>
          </div>
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:4px">Where does your company operate?</h3>
            <p style="font-size:14px;color:var(--body);margin-bottom:16px">Select all that apply.</p>
            <div class="fin-grid3">
              <button type="button" class="fin-tile" data-tile data-group="landen" data-multi="1" data-value="Netherlands" style="flex-direction:row;gap:10px"><svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true"><rect width="22" height="16" rx="2" fill="#AE1C28"/><rect y="5.3" width="22" height="5.3" fill="#fff"/><rect y="10.6" width="22" height="5.3" fill="#21468B"/></svg>Netherlands</button>
              <button type="button" class="fin-tile" data-tile data-group="landen" data-multi="1" data-value="Europe" style="flex-direction:row;gap:10px"><svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true"><rect width="22" height="16" rx="2" fill="#164194"/><g fill="#FFD200"><circle cx="11" cy="4" r="0.9"/><circle cx="11" cy="12" r="0.9"/><circle cx="7" cy="8" r="0.9"/><circle cx="15" cy="8" r="0.9"/><circle cx="8.5" cy="5" r="0.9"/><circle cx="13.5" cy="5" r="0.9"/><circle cx="8.5" cy="11" r="0.9"/><circle cx="13.5" cy="11" r="0.9"/></g></svg>Europe</button>
              <button type="button" class="fin-tile" data-tile data-group="landen" data-multi="1" data-value="International" style="flex-direction:row;gap:10px"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/></svg>International</button>
            </div>
          </div>
          <div class="ind-actions" style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:32px;padding-top:24px;border-top:1px solid var(--line)">
            <span style="font-size:14px;color:var(--body)">Step 1 of 3</span>
            <button type="button" data-step-next class="btn" style="background:var(--terracotta);color:var(--white);font-weight:600;font-size:15px;font-family:inherit;padding:14px 26px;border:none;border-radius:999px;cursor:pointer">Continue →</button>
          </div>
        </div>

        <!-- STEP 2 -->
        <div data-formstep="2" style="display:none">
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:4px">What would you like Finable to help with?</h3>
            <p style="font-size:14px;color:var(--body);margin-bottom:16px">Select all that apply.</p>
            <div class="fin-grid2">
              <button type="button" class="fin-card-opt" data-tile data-group="hulp" data-multi="1" data-value="Day-to-day finance"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg><span><span style="display:block;font-weight:600;font-size:16px;color:var(--navy)">Day-to-day finance</span><span style="font-size:13px;color:var(--body)">Invoices · bank · receivables</span></span></button>
              <button type="button" class="fin-card-opt" data-tile data-group="hulp" data-multi="1" data-value="Month-end close"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.6 3.1 3 7 3s7-1.4 7-3V6M5 12v6c0 1.6 3.1 3 7 3s7-1.4 7-3v-6"/></svg><span><span style="display:block;font-weight:600;font-size:16px;color:var(--navy)">Month-end close</span><span style="font-size:13px;color:var(--body)">Reconciliations · VAT · month-end file</span></span></button>
              <button type="button" class="fin-card-opt" data-tile data-group="hulp" data-multi="1" data-value="Controlling"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg><span><span style="display:block;font-weight:600;font-size:16px;color:var(--navy)">Controlling</span><span style="font-size:13px;color:var(--body)">Margins · cash · variances</span></span></button>
              <button type="button" class="fin-card-opt" data-tile data-group="hulp" data-multi="1" data-value="Reporting & insight"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 12V4M12 12l6 3"/></svg><span><span style="display:block;font-weight:600;font-size:16px;color:var(--navy)">Reporting &amp; insight</span><span style="font-size:13px;color:var(--body)">Numbers · context · discussion</span></span></button>
              <button type="button" class="fin-card-opt" data-tile data-group="hulp" data-multi="1" data-value="Payroll"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><rect x="4" y="6" width="16" height="12" rx="2"/><circle cx="9" cy="12" r="2.5"/><path d="M14 10h3M14 14h3"/></svg><span><span style="display:block;font-weight:600;font-size:16px;color:var(--navy)">Payroll</span><span style="font-size:13px;color:var(--body)">Payroll administration</span></span></button>
              <button type="button" class="fin-card-opt" data-tile data-group="hulp" data-multi="1" data-value="I'm not sure yet"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#5F6B76" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 015 0c0 1.7-2.5 2-2.5 4"/><circle cx="12" cy="18" r="0.6" fill="#5F6B76"/></svg><span><span style="display:block;font-weight:600;font-size:16px;color:var(--navy)">I'm not sure yet</span><span style="font-size:13px;color:var(--body)">Happy to work it out together</span></span></button>
            </div>
          </div>
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:14px">How is your finance currently organised?</h3>
            <div class="fin-grid4">
              <button type="button" class="fin-tile" data-tile data-group="wie" data-value="External bookkeeper or accountant">External bookkeeper or accountant</button>
              <button type="button" class="fin-tile" data-tile data-group="wie" data-value="Internal finance team">Internal finance team</button>
              <button type="button" class="fin-tile" data-tile data-group="wie" data-value="We handle it ourselves">We handle it ourselves</button>
              <button type="button" class="fin-tile" data-tile data-group="wie" data-value="A combination">A combination</button>
            </div>
          </div>
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:4px">Roughly how many invoices do you process each month?</h3>
            <p style="font-size:14px;color:var(--body);margin-bottom:16px">Purchase and sales combined.</p>
            <div class="fin-grid4">
              <button type="button" class="fin-tile" data-tile data-group="facturen" data-value="Up to 100">Up to 100</button>
              <button type="button" class="fin-tile" data-tile data-group="facturen" data-value="100–300">100–300</button>
              <button type="button" class="fin-tile" data-tile data-group="facturen" data-value="300–800">300–800</button>
              <button type="button" class="fin-tile" data-tile data-group="facturen" data-value="800+">800+</button>
            </div>
          </div>
          <div>
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:14px">Which accounting software do you use?</h3>
            <div class="fin-grid4">
              <button type="button" class="fin-tile" data-tile data-group="pakket" data-value="Exact">Exact</button>
              <button type="button" class="fin-tile" data-tile data-group="pakket" data-value="Twinfield">Twinfield</button>
              <button type="button" class="fin-tile" data-tile data-group="pakket" data-value="Moneybird">Moneybird</button>
              <button type="button" class="fin-tile" data-tile data-group="pakket" data-value="Something else or none yet">Something else or none yet</button>
            </div>
          </div>
          <div class="ind-actions" style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:32px;padding-top:24px;border-top:1px solid var(--line)">
            <span style="font-size:14px;color:var(--body)">Step 2 of 3</span>
            <div style="display:flex;align-items:center;gap:18px">
              <button type="button" data-step-prev class="btn-prev" style="background:none;border:none;font-family:inherit;font-size:15px;font-weight:600;color:var(--body);cursor:pointer">← Back</button>
              <button type="button" data-step-next class="btn" style="background:var(--terracotta);color:var(--white);font-weight:600;font-size:15px;font-family:inherit;padding:14px 26px;border:none;border-radius:999px;cursor:pointer">Continue →</button>
            </div>
          </div>
        </div>

        <!-- STEP 3 -->
        <div data-formstep="3" style="display:none">
          <div style="margin-bottom:28px">
            <h3 style="font-size:21px;color:var(--navy);margin-bottom:14px">When would you like to get started?</h3>
            <div class="fin-grid4">
              <button type="button" class="fin-tile" data-tile data-group="start" data-value="As soon as possible">As soon as possible</button>
              <button type="button" class="fin-tile" data-tile data-group="start" data-value="Within 1–3 months">Within 1–3 months</button>
              <button type="button" class="fin-tile" data-tile data-group="start" data-value="Later">Later</button>
              <button type="button" class="fin-tile" data-tile data-group="start" data-value="I'm not sure yet">I'm not sure yet</button>
            </div>
          </div>
          <div style="height:1px;background:var(--line);margin:28px 0"></div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 20px">
            <div style="margin-bottom:20px"><label for="fin-naam" style="display:block;font-size:14px;font-weight:600;color:var(--navy);margin-bottom:8px">Name</label><input type="text" id="fin-naam" name="naam" required class="fin-input" placeholder="Your name" autocomplete="name"></div>
            <div style="margin-bottom:20px"><label for="fin-email" style="display:block;font-size:14px;font-weight:600;color:var(--navy);margin-bottom:8px">Business email</label><input type="email" id="fin-email" name="email" required class="fin-input" placeholder="name@company.com" autocomplete="email"></div>
          </div>
          <div style="margin-bottom:20px"><label for="fin-website" style="display:block;font-size:14px;font-weight:600;color:var(--navy);margin-bottom:8px">Company website <span style="font-weight:400;color:var(--body)">(optional)</span></label><input type="text" inputmode="url" id="fin-website" name="website" class="fin-input" placeholder="company.com" autocomplete="url"></div>
          <div style="margin-bottom:20px"><label for="fin-tel" style="display:block;font-size:14px;font-weight:600;color:var(--navy);margin-bottom:8px">Phone number <span style="font-weight:400;color:var(--body)">(optional)</span></label><input type="tel" id="fin-tel" name="tel" class="fin-input" placeholder="Optional" autocomplete="tel"></div>
          <p style="font-size:13px;color:var(--body);margin-top:14px">We only use your details to prepare your estimate and get in touch with you.</p>
          <p data-formerror style="display:none;font-size:14px;color:var(--terracotta);background:var(--terracotta-soft);border:1px solid rgba(196,100,58,0.35);border-radius:10px;padding:14px 16px;margin-top:14px">Something went wrong while sending your request. Email it to <a href="mailto:tim@finable.nl" style="font-weight:600">tim@finable.nl</a> and we'll pick it up from there.</p>
          <div class="ind-actions" style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:28px;padding-top:24px;border-top:1px solid var(--line)">
            <span style="font-size:14px;color:var(--body)">Step 3 of 3</span>
            <div style="display:flex;align-items:center;gap:18px">
              <button type="button" data-step-prev class="btn-prev" style="background:none;border:none;font-family:inherit;font-size:15px;font-weight:600;color:var(--body);cursor:pointer">← Back</button>
              <button type="submit" data-submit class="btn" style="background:var(--terracotta);color:var(--white);font-weight:600;font-size:15px;font-family:inherit;padding:14px 26px;border:none;border-radius:999px;cursor:pointer">Get my estimate →</button>
            </div>
          </div>
        </div>

        <!-- END SCREEN -->
        <div data-formstep="done" style="display:none">
          <div style="width:56px;height:56px;border-radius:999px;background:var(--terracotta);display:flex;align-items:center;justify-content:center;margin-bottom:26px">
            <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="#fff" stroke-width="2.5" aria-hidden="true"><path d="M5 13l5 5L21 7"/></svg>
          </div>
          <h2 style="font-size:clamp(26px,3vw,34px);color:var(--navy);margin-bottom:28px;text-wrap:balance">Thanks. We've got what we need.</h2>
          <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:32px">
            <div style="display:flex;gap:16px;align-items:baseline"><span style="font-family:'Playfair Display',serif;font-size:18px;color:var(--terracotta);flex-shrink:0">01</span><span style="font-size:16px;color:var(--body)">The Finable team reviews your request.</span></div>
