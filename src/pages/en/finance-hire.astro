---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

const vormen = [
  { n: '01', h: 'A complete finance function',
    p: 'From bookkeeping and month-end close to financial control and reporting. Finable runs the agreed work, with clear responsibilities and a dedicated point of contact.' },
  { n: '02', h: 'Support for your existing team',
    p: 'Your CFO or finance manager stays in charge. Finable adds capacity and expertise, working in your systems and following your existing processes.' },
  { n: '03', h: 'Help with specific parts of finance',
    p: 'Need help with bookkeeping, month-end close, analysis or reporting? We start where you need us most.' },
  { n: '04', h: 'A setup that grows with you',
    p: 'Start with one area, expand when you need to or bring work in-house later. The division of work can change as your organisation grows.' },
];
---
<Layout title="Finance hire or Finable? Compare a hire with a finance team | Finable" description="Hiring a bookkeeper, controller or finance manager? See how Finable can run your finance function, support your team or take on specific work.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy, single column: typography is the visual) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:48px;padding-bottom:64px">
    <div class="hero" style="display:grid;grid-template-columns:1fr;gap:clamp(36px,4.6vw,68px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:20px">Considering a finance hire?</div>
        <h1 class="fh-h1" style="font-size:clamp(32px,4vw,50px);line-height:1.07;margin-bottom:20px"><span>You’re looking for finance professionals.</span><span class="em">What does your organisation actually need?</span></h1>
        <p style="font-size:clamp(16px,1.6vw,19px);color:rgba(255,255,255,.78);max-width:600px;text-wrap:pretty">You may be looking for a bookkeeper, a controller, a finance manager or several people at once. Before you recruit, look at the work that needs doing and the expertise it calls for.</p>
        <p style="font-size:16px;color:rgba(255,255,255,.72);max-width:600px;margin-top:14px;text-wrap:pretty">Finable can run your full finance function, strengthen your existing team or take on specific tasks. You have one dedicated point of contact in the Netherlands and the team works in your systems.</p>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:28px">
          <Button href="#alternative">See how Finable can help &rarr;</Button>
          <a href="/en/book-a-call" style="font-weight:600;font-size:16px;color:var(--terracotta)">Discuss your finance needs &rarr;</a>
        </div>
      </div>
    </div>
    </div>
  </section>

  <div class="wrap"><div class="rule"></div></div>

  <!-- THE ROLE -->
  <section class="wrap" style="padding-top:64px;padding-bottom:72px">
    <div class="split" style="display:grid;grid-template-columns:minmax(0,1fr) 1px minmax(0,1fr);gap:clamp(40px,5vw,72px);align-items:start">
      <div>
        <div class="lbl" style="margin-bottom:22px">The role</div>
        <h2 style="font-size:clamp(26px,3vw,36px);margin-bottom:26px">It often starts with one job description.</h2>
        <div>
          <div class="cat">Accounting</div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Oversee the financial administration</span></div>
          <div class="cat" style="margin-top:16px">Financial control</div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Run the month-end close</span></div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Review the numbers and explain variances</span></div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Monitor cash flow and working capital</span></div>
          <div class="cat" style="margin-top:16px">Reporting &amp; planning</div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Prepare management reports</span></div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Build budgets and forecasts</span></div>
          <div class="cat" style="margin-top:16px">Business control</div>
          <div class="chk"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--navy)">Advise management based on the numbers</span></div>
        </div>
      </div>
      <div class="vdiv" style="background:var(--line)"></div>
      <div class="reveal" style="padding-top:44px">
        <div style="width:44px;height:2px;background:var(--terracotta);margin-bottom:24px"></div>
        <h2 style="font-size:clamp(28px,3.4vw,42px);line-height:1.14;margin-bottom:24px">That's not just one role.<br>That's a finance function.</h2>
        <p style="font-size:16px;color:var(--body);max-width:520px;text-wrap:pretty">What starts as one vacancy often combines accounting, financial control, reporting and business control. That does not mean one employee is unsuitable: it depends on the volume per area and on the level you need in each. It is the question worth answering before you start recruiting.</p>
      </div>
    </div>
  </section>

  <div class="wrap"><div class="rule"></div></div>

  <section class="wrap" style="padding-top:64px;padding-bottom:72px">
    <div style="max-width:700px">
      <div class="lbl" style="margin-bottom:22px">While you’re hiring</div>
      <h2 style="font-size:clamp(26px,3vw,36px);margin-bottom:26px">The vacancy is open. The work carries on.</h2>
      <p style="font-size:16px;color:var(--body);margin-bottom:18px;text-wrap:pretty">Invoices, bank transactions and month-end close continue while you recruit. Interim cover can help during the search.</p>
      <p style="font-size:16px;color:var(--body);text-wrap:pretty">If you redistribute the work in the meantime, take another look at the original job description. You may still need that role, or you may find that the work is better shared between an employee and a team.</p>
    </div>
  </section>

  <div class="wrap"><div class="rule"></div></div>

  <!-- THE DECISION -->
  <section class="wrap" style="padding-top:64px;padding-bottom:72px">
    <div class="lbl" style="margin-bottom:22px">The decision</div>
    <h2 style="font-size:clamp(26px,3.2vw,38px);margin-bottom:40px">One finance hire or Finable?</h2>

    <div class="vgl">
      <div class="vgl-head">
        <div class="vgl-dim"></div>
        <div class="vgl-a">One internal employee</div>
        <div class="vgl-b">Finable</div>
      </div>
      <div class="vgl-row">
        <div class="vgl-dim">Expertise</div>
        <div class="vgl-a"><span class="vgl-lbl">One internal employee</span>One profile inside your organisation</div>
        <div class="vgl-b"><span class="vgl-lbl">Finable</span>Several finance disciplines in one team</div>
      </div>
      <div class="vgl-row">
        <div class="vgl-dim">Direction</div>
        <div class="vgl-a"><span class="vgl-lbl">One internal employee</span>You manage that employee yourself</div>
        <div class="vgl-b"><span class="vgl-lbl">Finable</span>One fixed point of contact in the Netherlands</div>
      </div>
      <div class="vgl-row">
        <div class="vgl-dim">Continuity</div>
        <div class="vgl-a"><span class="vgl-lbl">One internal employee</span>You arrange cover when someone is away</div>
        <div class="vgl-b"><span class="vgl-lbl">Finable</span>The team can absorb the work</div>
      </div>
      <div class="vgl-row">
        <div class="vgl-dim">Cost</div>
        <div class="vgl-a"><span class="vgl-lbl">One internal employee</span>Salary, employer costs and recruitment</div>
        <div class="vgl-b"><span class="vgl-lbl">Finable</span>A monthly fee for the agreed scope</div>
      </div>
      <div class="vgl-row">
        <div class="vgl-dim">Start</div>
        <div class="vgl-a"><span class="vgl-lbl">One internal employee</span>Recruiting and onboarding</div>
        <div class="vgl-b"><span class="vgl-lbl">Finable</span>Onboarding the team onto your business</div>
      </div>
    </div>
    <p class="vgl-note">An internal employee can work alongside your bookkeeper or accountant. With Finable we agree capacity, onboarding and cover up front. Which setup fits best depends on your organisation.</p>
  </section>

  <!-- THE ALTERNATIVE · NAVY ANCHOR -->
  <section id="alternative" style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:76px">
      <div class="lbl" style="color:var(--terracotta);margin-bottom:20px">The alternative</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);color:var(--white);margin-bottom:20px">Your finance handled. By one team.</h2>
      <p style="font-size:16px;color:var(--on-dark-secondary);max-width:720px;margin-bottom:48px;text-wrap:pretty">From day-to-day administration to close, controlling and reporting. Together we agree what Finable takes over and what stays in-house.</p>
      <div class="navy-grid" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:clamp(36px,4vw,64px);align-items:center">
        <div class="flow">
          <div>
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px" aria-hidden="true"><rect x="7" y="4" width="18" height="24" rx="2"/><path d="M11 10h10M11 15h10M11 20h6"/></svg>
            <h3 style="font-size:15px;color:var(--white);margin-bottom:8px;font-family:'Inter',sans-serif;font-weight:600">Daily finance</h3>
            <p style="font-size:13px;color:var(--on-dark-secondary);line-height:1.55">The recurring work that keeps finance running.</p>
          </div>
          <svg class="fa" width="24" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
          <div>
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px" aria-hidden="true"><path d="M6 8h20M6 8v18h20V8M6 8V5h20v3"/><path d="M11 14l3 3 6-6"/></svg>
            <h3 style="font-size:15px;color:var(--white);margin-bottom:8px;font-family:'Inter',sans-serif;font-weight:600">Month-end close</h3>
            <p style="font-size:13px;color:var(--on-dark-secondary);line-height:1.55">Closing each month in a structured and reliable way.</p>
          </div>
          <svg class="fa" width="24" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
          <div>
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px" aria-hidden="true"><path d="M5 27h22"/><rect x="7" y="17" width="4" height="7"/><rect x="14" y="11" width="4" height="13"/><rect x="21" y="14" width="4" height="10"/></svg>
            <h3 style="font-size:15px;color:var(--white);margin-bottom:8px;font-family:'Inter',sans-serif;font-weight:600">Controlling</h3>
            <p style="font-size:13px;color:var(--on-dark-secondary);line-height:1.55">Reviewing performance, cash flow and variances.</p>
          </div>
          <svg class="fa" width="24" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
          <div>
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px" aria-hidden="true"><path d="M8 4h12l6 6v18H8z"/><path d="M19 4v7h7"/><path d="M12 18l3 3 5-6"/></svg>
            <h3 style="font-size:15px;color:var(--white);margin-bottom:8px;font-family:'Inter',sans-serif;font-weight:600">Reporting &amp; insight</h3>
            <p style="font-size:13px;color:var(--on-dark-secondary);line-height:1.55">Turning the numbers into useful information for management.</p>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:16px;border-left:1px solid rgba(255,255,255,.14);padding-left:clamp(24px,3vw,44px)">
          <div style="display:flex;align-items:center;gap:12px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--white);font-weight:500">A fixed team</span></div>
          <div style="display:flex;align-items:center;gap:12px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--white);font-weight:500">One point of contact</span></div>
          <div style="display:flex;align-items:center;gap:12px"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><circle cx="10" cy="10" r="8.5"/><path d="M6 10l2.5 2.5L14 7"/></svg><span style="font-size:16px;color:var(--white);font-weight:500">One fixed monthly fee</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE SPLIT — what stays internal and what Finable runs. No new guarantees: this is the
       agreement made before the start, not a standard package. -->
  <section class="wrap" style="padding-top:72px;padding-bottom:72px">
    <div class="lbl" style="margin-bottom:22px">The split</div>
    <h2 style="font-size:clamp(26px,3vw,36px);margin-bottom:12px">What stays in-house and what does Finable take on?</h2>
    <p style="font-size:16px;color:var(--body);max-width:700px;margin-bottom:40px;text-wrap:pretty">Finable takes responsibility for the agreed parts of your finance function. Together we decide what our team runs, what stays in-house and how the two fit together.</p>
    <div class="split" style="display:grid;grid-template-columns:minmax(0,1fr) 1px minmax(0,1fr);gap:clamp(40px,5vw,72px);align-items:start">
      <div>
        <h3 style="font-size:clamp(19px,2vw,23px);margin-bottom:20px">Finable carries out</h3>
        <div class="chk"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg><span style="font-size:16px;color:var(--body)">The work you agree on together, with the responsibility that comes with it set out in advance</span></div>
        <div class="chk"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg><span style="font-size:16px;color:var(--body)">The preparation of the figures, reports and forecast you base your decisions on</span></div>
        <div class="chk"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg><span style="font-size:16px;color:var(--body)">Flagging what stands out in the numbers and what it means for the month ahead</span></div>
      </div>
      <div class="vdiv" style="background:var(--line)"></div>
      <div>
        <h3 style="font-size:clamp(19px,2vw,23px);margin-bottom:20px">You keep</h3>
        <div class="chk"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg><span style="font-size:16px;color:var(--body)">Strategic choices, budget decisions and the approvals you have agreed on</span></div>
        <div class="chk"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg><span style="font-size:16px;color:var(--body)">The work you deliberately keep in-house, with your own people</span></div>
        <div class="chk"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="#C4643A" stroke-width="1.7" aria-hidden="true"><path d="M4 10.5l4 4L16 6"/></svg><span style="font-size:16px;color:var(--body)">The relationship with your bookkeeper, accountant or CFO, who can stay involved</span></div>
      </div>
    </div>
    <p style="font-size:16px;color:var(--body);max-width:760px;margin-top:clamp(32px,3.4vw,44px);padding-top:26px;border-top:1px solid var(--line);text-wrap:pretty">You have one fixed point of contact in the Netherlands. The delivery team works from India. Before the start we set out who does what, who gets which access, which checks are part of the work and how we work together. If the situation changes, the split changes with it.</p>
  </section>

  <div class="wrap"><div class="rule"></div></div>

  <section class="wrap" style="padding-top:64px;padding-bottom:64px">
    <div class="lbl" style="margin-bottom:22px">Ways to work together</div>
    <h2 style="font-size:clamp(26px,3vw,36px);margin-bottom:18px">How much of your finance work can we take on?</h2>
    <p style="font-size:16px;color:var(--body);max-width:720px;margin-bottom:clamp(26px,2.8vw,36px);text-wrap:pretty">Whether you are setting up finance, working with a CFO or finance manager, or filling several vacancies, Finable builds on the team and processes you already have.</p>
    <div class="vorm">
      {vormen.map((v) => (
        <div class="vorm-i">
          <div class="vorm-n">{v.n}</div>
          <h3 class="vorm-h">{v.h}</h3>
          <p class="vorm-p">{v.p}</p>
        </div>
      ))}
    </div>
    <p class="fh-alt is-plain">Hiring in-house and working with Finable can work well together.</p>
    <div class="vorm-cta">
      <Button href="/en/book-a-call">Discuss your finance needs &rarr;</Button>
      <a href="/en/how-it-works" class="vorm-sec">See how Finable works month to month &rarr;</a>
    </div>
    <p class="fh-meer">See how <a href="/en/finance-for-scaleups">finance needs change as your business grows</a>.</p>
  </section>

  <div class="wrap"><div class="rule"></div></div>

  <!-- FAQ + TIM (navy) -->
  <section class="faq-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:68px;padding-bottom:72px">
    <div class="end" style="display:grid;grid-template-columns:minmax(0,1.1fr) 1px minmax(0,0.9fr);gap:clamp(40px,5vw,68px);align-items:start">
      <div>
        <div class="lbl" style="margin-bottom:26px">Frequently asked questions</div>
        <details class="fin-faq"><summary><span class="fin-faq-q">Can Finable replace a finance hire?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>It depends on the work and how much of it there is. A team can make sense if the role calls for several kinds of expertise. If there is enough recurring work for a clearly defined full-time role, hiring in-house may be a better fit.</p></div></details>
        <details class="fin-faq"><summary><span class="fin-faq-q">What if we want to hire someone later?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>We agree which tasks move to your new colleague and which Finable keeps. Where needed, we organise a handover so the scope can change as your business grows.</p></div></details>
        <details class="fin-faq"><summary><span class="fin-faq-q">What happens during illness or holidays?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>A team makes you less dependent on one person. We document the work and share knowledge as part of the setup so colleagues can cover for each other when someone is away.</p></div></details>
        <details class="fin-faq"><summary><span class="fin-faq-q">When is an in-house hire the better choice?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>An in-house hire can make sense when there is enough work for a clearly defined role, when finance needs to work closely with internal teams every day, or when you want to recruit and develop your own team. Finable can take on specific tasks alongside that role.</p></div></details>
      </div>
      <div class="vdiv" style="background:var(--on-dark-line)"></div>
      <div class="cta-p" style="display:grid;grid-template-columns:clamp(120px,15vw,160px) minmax(0,1fr);gap:26px;align-items:start">
        <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt="Tim Samsom, founder of Finable" width="800" height="699" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        <div>
          <div class="lbl" style="margin-bottom:16px">Personal introduction</div>
          <h2 style="font-size:clamp(21px,2.2vw,27px);line-height:1.14;margin-bottom:14px;color:var(--white)">Discuss your finance needs</h2>
          <p style="font-size:15px;color:var(--on-dark-secondary);margin-bottom:22px;text-wrap:pretty">In 30 minutes with Tim, we look at the work on your plate, what should stay in-house and where Finable could take over or support your team.</p>
          <div style="display:flex;align-items:center;gap:24px;flex-wrap:wrap">
            <Button href="/en/book-a-call">Discuss your finance needs &rarr;</Button>
            <a href="/en/estimate" style="font-weight:600;font-size:15px;color:var(--white)">Get an estimate &rarr;</a>
          </div>
          <div style="font-size:14px;color:var(--on-dark-secondary);line-height:1.45;margin-top:20px"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">Tim Samsom</span><br>Founder, Finable</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  .fh-h1>span{display:block}
  .fh-alt{margin-top:clamp(32px,3.4vw,44px);padding-top:26px;border-top:1px solid var(--line);font-size:16px;color:var(--body);text-wrap:pretty}
  .fh-alt a{font-weight:600}
  .vorm{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
  .vorm-i{padding:22px 0 26px;border-top:1px solid var(--line)}
