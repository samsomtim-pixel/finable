---
// English version for bookkeeping and accounting firms in the Netherlands.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

const herkenning = [
  { n: '01', t: 'Your client base is growing', d: 'More work is coming in than your current team can handle.' },
  { n: '02', t: 'You have a busy period or a backlog', d: 'Bring in extra capacity to get the workload back under control.' },
  { n: '03', t: 'A vacancy stays open', d: 'Keep the work moving while you recruit.' },
  { n: '04', t: 'Recurring work takes up time', d: 'Add capacity for tasks that come back every week or month.' },
  { n: '05', t: 'A client needs more help', d: 'Get extra support when a client asks for additional finance work.' },
  { n: '06', t: 'You want room to grow', d: 'Handle more work without having to hire each time your client base grows.' },
];

const markt = ['Staff shortages', 'Reorganising the workload', 'More time for clients and advice'];

const capabilities = [
  {
    t: '01 · Day-to-day finance',
    items: ['Processing and coding purchase invoices', 'Processing sales invoices', 'Posting bank and credit card transactions', 'Processing expense claims', 'Following up on outstanding invoices', 'Maintaining bookkeeping records'],
  },
  {
    t: '02 · Close and review',
    items: ['Bank and balance sheet reconciliations', 'Accruals and prepayments', 'Fixed assets and depreciation', 'VAT preparation', 'Month-end close', 'Working papers and reconciliations', 'Preparation for year-end work'],
  },
  {
    t: '03 · Reporting and support',
    items: ['Preparing management reports', 'Comparing actuals with budgets', 'Cash flow summaries', 'Preparing financial analyses', 'Consolidation support', 'Investigating discrepancies and answering ad hoc finance questions'],
  },
];

const grens = [
  { t: 'Finable does the work', d: '→ you review' },
  { t: 'Finable does and reviews the work', d: '→ you approve' },
  { t: 'Finable runs the agreed process', d: '→ you advise clients and manage the relationship' },
];

const zekerheden = [
  { t: 'A dedicated team', d: 'A consistent team gets to know your firm, processes and systems.' },
  { t: 'One point of contact', d: 'One person knows how the work is organised and talks through any issues with you.' },
  { t: 'Checks built into the process', d: 'Clear agreements on who does the work, who reviews it and who approves it.' },
  { t: 'Predictable costs', d: 'You know in advance what work and capacity you are paying for.' },
];

const vormen = [
  { n: '01', t: 'One set of books', d: 'Start with a clearly defined pilot.' },
  { n: '02', t: 'Fixed days each week', d: 'Cover recurring work across several clients.' },
  { n: '03', t: 'Ongoing capacity', d: 'Bring in Finable as an extension of your team.' },
];

const faq = [
  { q: 'Do we keep the client relationship?', a: 'Yes. Your firm keeps the client relationship. We agree beforehand what Finable will do behind the scenes.' },
  { q: 'What work can we outsource?', a: 'We can help with day-to-day bookkeeping, reconciliations, month-end close, reporting and preparation for year-end work. We agree the scope together.' },
  { q: 'Can we start with one set of books?', a: 'Yes. Starting with one set of books gives both teams a chance to test how the arrangement works.' },
  { q: 'Can we book a fixed number of days each week?', a: 'Yes. For recurring work, we can agree a fixed number of days per week and adjust it later.' },
  { q: 'Who does the work?', a: 'Finable is your dedicated point of contact in the Netherlands. An international team of finance professionals carries out the work under Dutch management. We agree in advance who does the work and who reviews it.' },
  { q: 'How do we keep control of the work and data?', a: 'We agree the processes, responsibilities, checks and review points in advance. We also set up access and data processing for your firm and document the arrangements when we start.' },
  { q: 'How is the price set?', a: 'The price depends on the scope, workload, capacity and division of responsibilities. You know what Finable will do and what it will cost before we start.' },
];

const arrow = 'M0 9h24M18 2l8 7-8 7';
---
<Layout
  title="Finance support for Dutch bookkeeping and accounting firms | Finable"
  breadcrumbs={[{ name: 'Home', path: '/en' }, { name: 'Dutch bookkeeping and accounting firms' }]}
  description="Extra capacity for bookkeeping and accounting firms in the Netherlands, from recurring bookkeeping and month-end close to preparation for year-end work."
>
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:64px">
      <div style="max-width:840px">
        <div class="lbl" style="margin-bottom:22px">For bookkeeping and accounting firms in the Netherlands</div>
        <h1 style="font-size:clamp(34px,4.6vw,58px);line-height:1.05;margin-bottom:24px;text-wrap:balance">Serve more clients. <span class="em">Keep your team size manageable.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:var(--on-dark-secondary);max-width:640px;text-wrap:pretty">Finable gives firms in the Netherlands extra capacity for recurring finance work, month-end close, working papers and preparation for year-end work. We work as an extension of your team, using your processes and systems.</p>
        <div class="vb-hero-cta">
          <Button href="/en/book-a-call">Book an introductory call &rarr;</Button>
          <a href="#work-you-can-outsource" class="vb-hero-alt">See what you can outsource &darr;</a>
        </div>
        <div class="vb-trust">
          <div><span aria-hidden="true"></span>One point of contact</div>
          <div><span aria-hidden="true"></span>Checks built into the process</div>
          <div><span aria-hidden="true"></span>Capacity you can adjust</div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-top:72px;padding-bottom:64px">
    <div style="max-width:720px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">When you need extra capacity</div>
      <h2 style="font-size:clamp(26px,3.2vw,40px);margin-bottom:18px;text-wrap:balance">Where could your team use help?</h2>
      <p style="font-size:16px;color:var(--body);line-height:1.7;max-width:620px;text-wrap:pretty">When the workload exceeds what your team can handle, Finable can provide ongoing support or help during busy periods.</p>
    </div>
    <div class="vb-rec">
      {herkenning.map((x) => (
        <div class="vb-reccard">
          <div class="vb-recn">{x.n}</div>
          <h3>{x.t}</h3>
          <p>{x.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section style="background:var(--section)">
    <div class="wrap" style="padding-top:64px;padding-bottom:64px">
      <div style="max-width:720px;margin-bottom:36px">
        <div class="lbl" style="margin-bottom:18px">Dutch market trends</div>
        <h2 style="font-size:clamp(26px,3vw,38px);margin-bottom:18px;text-wrap:balance">Dutch bookkeeping firms are outsourcing more work.</h2>
        <p style="font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty">Staff shortages are leading Dutch bookkeeping and tax advisory firms to outsource more work. That frees up time for client advice and specialist work and helps firms manage peaks in demand. Read more about <a href="/kennis/automatiseren-of-uitbesteden-administratiekantoor" hreflang="nl">automation and outsourcing for bookkeeping firms (in Dutch)</a>.</p>
      </div>
      <div class="vb-mkt">
        {markt.map((m, i) => (
          <>
            <div class="vb-mkt-n">{m}</div>
            {i < markt.length - 1 && <svg class="vb-mkt-a" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d={arrow}/></svg>}
          </>
        ))}
      </div>
      <p class="vb-src">Based on NOAB research reported by Accountant.nl in July 2026. <a href="https://www.accountant.nl/nieuws/2026/7/administratiekantoren-moeten-door-personeelstekort-steeds-vaker-werk-uitbesteden/" target="_blank" rel="noopener noreferrer">Read the Accountant.nl article (in Dutch) &rarr;</a></p>
    </div>
  </section>

  <section id="work-you-can-outsource" style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:76px">
      <div style="max-width:720px;margin-bottom:44px">
        <div class="lbl" style="margin-bottom:18px">How we can help</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);color:var(--warm-white);margin-bottom:18px;text-wrap:balance">What you can hand over to Finable</h2>
        <p style="font-size:16px;color:var(--on-dark-secondary);line-height:1.7;text-wrap:pretty">From day-to-day bookkeeping to month-end close and reporting. You decide what to hand over and what your team keeps.</p>
      </div>

      <div class="vb-caps">
        {capabilities.map((c) => (
          <div class="vb-cap">
            <h3 class="lbl vb-cap-h">{c.t}</h3>
            <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <h3 class="vb-grens-h">Agree who does the work, who reviews it and who approves it</h3>
      <div class="vb-grens">
        {grens.map((g) => (
          <div class="vb-grenscard">
            <div class="vb-grenst">{g.t}</div>
            <div class="vb-grensd">{g.d}</div>
          </div>
        ))}
      </div>
      <p class="vb-grens-p">We work in your processes and systems, with dedicated contacts and clear agreements on review and approval. Your firm remains responsible for statutory audits, assurance engagements and other reserved activities.</p>
    </div>
  </section>

  <section class="wrap" style="padding-top:72px;padding-bottom:64px">
    <h2 style="font-size:clamp(26px,3.2vw,38px);margin-bottom:40px;text-wrap:balance">What you can expect</h2>
    <div class="vb-rely">
      {zekerheden.map((z) => (
        <div>
          <div class="lbl vb-rely-k">{z.t}</div>
          <p>{z.d}</p>
        </div>
      ))}
    </div>
    <p class="vb-rely-end"><strong>Your firm keeps the client relationship.</strong> Start with one set of books and expand once the approach works for your firm.</p>
  </section>

  <section style="background:var(--section)">
    <div class="wrap" style="padding-top:72px;padding-bottom:72px">
      <div style="max-width:720px;margin-bottom:44px">
        <div class="lbl" style="margin-bottom:18px">Ways to work together</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);text-wrap:balance">Start with the capacity you need today</h2>
      </div>
      <div class="vb-vormen">
        {vormen.map((v) => (
          <div class="vb-vorm">
            <div class="lbl" style="margin-bottom:14px">{v.n}</div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
      <div class="vb-prijs">
        <h3>How much does it cost?</h3>
        <p>The cost depends on the work, its volume, the capacity you need and who is responsible for each task. We agree the scope and price before we start.</p>
        <Button href="/en/book-a-call">Discuss what your team needs &rarr;</Button>
      </div>
    </div>
  </section>

  <section class="faq-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:72px;padding-bottom:72px">
      <div class="vb-end">
        <div>
          <div class="lbl" style="margin-bottom:26px">Frequently asked questions</div>
          {faq.map((f) => (
            <details class="fin-faq">
              <summary><span class="fin-faq-q">{f.q}</span><span class="fin-faq-ic"></span></summary>
              <div class="fin-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
        <div class="vb-tim">
          <div class="lbl" style="margin-bottom:20px">Meet Tim</div>
          <div class="vb-tim-row">
            <div class="vb-tim-img"><img src="/images/tim-samsom.webp" alt="Tim Samsom, founder of Finable" width="800" height="699" loading="lazy" /></div>
            <div>
              <h2 style="font-size:clamp(21px,2.2vw,28px);line-height:1.12;margin-bottom:12px;color:var(--white)">How would this work for your firm?</h2>
              <p style="font-size:15px;color:var(--on-dark-secondary);text-wrap:pretty">Book 30 minutes with Tim to talk through your workload, what you could hand over and what support would fit your firm.</p>
            </div>
          </div>
          <div class="vb-tim-cta">
            <Button href="/en/book-a-call">Book an introductory call &rarr;</Button>
            <div class="vb-tim-name"><span>Tim Samsom</span><br>Founder, Finable</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  a{transition:opacity .15s}
  a:hover{opacity:.72}

  .vb-hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:32px}
  .vb-hero-alt{font-weight:600;font-size:16px;color:var(--white)}
  .vb-hero-alt:hover{color:var(--terracotta);opacity:1}
  .vb-trust{display:flex;flex-wrap:wrap;gap:12px 32px;margin-top:30px}
  .vb-trust>div{display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(255,255,255,.82)}
  .vb-trust>div>span{width:6px;height:6px;border-radius:999px;background:var(--terracotta);flex-shrink:0}

  .vb-rec{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vb-reccard{background:var(--section);border:1px solid var(--line);border-radius:12px;padding:26px 26px;transition:border-color .15s}
  .vb-reccard:hover{border-color:rgba(196,100,58,0.45)}
  .vb-recn{font-family:'Playfair Display',serif;font-size:15px;color:var(--terracotta);margin-bottom:12px}
  .vb-reccard h3{font-size:18px;margin-bottom:8px}
  .vb-reccard p{font-size:14px;color:var(--body);line-height:1.6;text-wrap:pretty}

  .vb-mkt{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:20px;align-items:center;max-width:880px;margin-bottom:24px}
  .vb-mkt-n{font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(16px,1.7vw,20px);color:var(--navy);line-height:1.25;text-wrap:balance}
  .vb-mkt-a{align-self:center}
  .vb-src{font-size:13px;color:var(--body);line-height:1.6}
  .vb-src a{font-weight:600}

  .vb-caps{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,3vw,44px)}
  .vb-cap-h{color:var(--white);margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid var(--terracotta);font-family:'Inter',system-ui,sans-serif}
  .vb-cap ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
  .vb-cap li{font-size:15px;color:var(--on-dark-secondary);line-height:1.5;text-wrap:pretty}

  .vb-grens-p{margin-top:26px;max-width:860px;font-size:15px;color:var(--on-dark-secondary);line-height:1.65;text-wrap:pretty}
  .vb-grens-h{font-size:21px;color:var(--warm-white);margin-top:48px;margin-bottom:22px}
  .vb-grens{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vb-grenscard{background:rgba(255,255,255,0.06);border:1px solid var(--on-dark-line);border-radius:10px;padding:22px 24px}
  .vb-grenst{font-weight:600;color:var(--white);margin-bottom:6px;text-wrap:pretty}
  .vb-grensd{font-size:14px;color:var(--on-dark-secondary)}

  .vb-rely{display:grid;grid-template-columns:repeat(4,1fr)}
  .vb-rely>div{border-top:1px solid var(--line);padding:16px 26px 0 26px}
  .vb-rely>div:first-child{padding-left:0}
  .vb-rely>div:last-child{padding-right:0}
  .vb-rely-k{color:var(--navy);margin-bottom:10px}
  .vb-rely p{font-size:14px;color:var(--body);line-height:1.6;text-wrap:pretty}
  .vb-rely-end{font-size:15px;color:var(--body);margin-top:28px;text-wrap:pretty}
  .vb-rely-end strong{color:var(--navy);font-weight:600}

  .vb-vormen{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:52px}
  .vb-vorm{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:28px 26px}
  .vb-vorm h3{font-size:19px;margin-bottom:8px;text-wrap:balance}
  .vb-vorm p{font-size:15px;color:var(--body);line-height:1.6;text-wrap:pretty}
  .vb-prijs{max-width:680px}
  .vb-prijs h3{font-size:21px;margin-bottom:12px}
  .vb-prijs>p{font-size:16px;color:var(--body);line-height:1.7;margin-bottom:24px;text-wrap:pretty}

  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:30px;padding:24px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(17px,1.7vw,20px);color:var(--navy);line-height:1.35;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:17px;height:17px;flex-shrink:0;margin-top:6px}
  .fin-faq-ic::before,.fin-faq-ic::after{content:"";position:absolute;background:var(--terracotta);transition:opacity .2s}
  .fin-faq-ic::before{left:0;top:7.5px;width:17px;height:2px}
  .fin-faq-ic::after{left:7.5px;top:0;width:2px;height:17px}
  details.fin-faq[open] .fin-faq-ic::after{opacity:0}
  details.fin-faq>summary:hover .fin-faq-q{color:var(--terracotta)}
  .fin-faq-a{max-width:760px;padding:0 0 28px;font-size:15.5px;color:var(--body);line-height:1.72}

  .vb-end{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,0.9fr);gap:clamp(40px,5vw,72px);align-items:start}
  .vb-tim{border-left:1px solid var(--on-dark-line);padding-left:clamp(28px,3vw,48px)}
  .vb-tim-row{display:grid;grid-template-columns:clamp(120px,14vw,150px) minmax(0,1fr);gap:24px;align-items:center;margin-bottom:24px}
  .vb-tim-img{aspect-ratio:1/1;border-radius:12px;overflow:hidden}
  .vb-tim-img img{width:100%;height:100%;object-fit:cover;display:block}
  .vb-tim-cta{display:flex;flex-wrap:wrap;align-items:center;gap:20px}
  .vb-tim-name{font-size:14px;color:var(--on-dark-secondary);line-height:1.45}
  .vb-tim-name span{font-family:'Playfair Display',serif;font-weight:600;color:var(--white)}

  @media (max-width:1023px){
    .vb-rec{grid-template-columns:repeat(2,1fr)}
    .vb-caps{grid-template-columns:1fr;gap:32px}
    .vb-grens{grid-template-columns:1fr}
    .vb-rely{grid-template-columns:repeat(2,1fr)}
    .vb-rely>div{padding-left:0;padding-right:26px}
    .vb-vormen{grid-template-columns:1fr;gap:18px}
    .vb-mkt{grid-template-columns:1fr;gap:14px}
    .vb-mkt-a{transform:rotate(90deg);justify-self:start}
    .vb-end{grid-template-columns:1fr;gap:44px}
    .vb-tim{border-left:none;padding-left:0;border-top:1px solid var(--on-dark-line);padding-top:40px}
  }
  @media (max-width:767px){
    .vb-rec{grid-template-columns:1fr}
    .vb-rely{grid-template-columns:1fr}
    .vb-rely>div{padding-right:0}
    .vb-tim-row{grid-template-columns:clamp(110px,30vw,140px) minmax(0,1fr);gap:20px}
  }
</style>
