---
// Engelse versie van de klantcase The Good Roll. Zelfde markup en stijlen als /cases/the-good-roll,
// alleen de copy verschilt; zo blijven ontwerp en responsive gedrag gegarandeerd gelijk.
//
// VERIFY VÓÓR LIVEGANG: publiek akkoord van Sander de Klerk voor naam, logo, foto en beide citaten.
// Het citaat is oorspronkelijk in het Nederlands gedaan; hier staat een vertaling met een
// ingetogen 'Translated from Dutch' eronder.
//
// Geen cijfers, percentages, doorlooptijden of functietitels.
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Button from '../../../components/Button.astro';

const journey = [
  { title: 'Daily finance', desc: 'Administration, AP/AR, payments' },
  { title: 'Close', desc: 'Month-end and year-end close' },
  { title: 'Control', desc: 'Processes, compliance, audit' },
  { title: 'Reporting', desc: 'Management reporting' },
  { title: 'Insight', desc: 'Analysis, context and advice' },
];

const regelt = [
  'Day-to-day administration (AP/AR, payments)',
  'Month-end and year-end close',
  'Management reporting and dashboards',
  'Support with control and compliance',
  'Proactively identifying cost-saving opportunities and financial opportunities',
  'Scalable capacity and additional expertise when needed',
];
// De enige regel met extra nadruk, gelijk aan de NL-pagina.
const regeltEmphasis = 'Proactively identifying cost-saving opportunities and financial opportunities';

const controller = [
  'One person',
  'One expertise profile',
  'Fixed capacity',
  'Operations and control on one person’s plate',
  'Continuity depends on one role',
  'Further growth may require another hire',
];

const finable = [
  'One dedicated point of contact',
  'A team of finance professionals',
  'Different areas of expertise',
  'Capacity scales with your needs',
  'Continuity provided by the team',
  'No finance team to manage yourself',
];

const waarom = [
  { n: '01', title: 'Up and running quickly', desc: 'No months spent searching, interviewing and onboarding. The finance capacity you need can be organised quickly.' },
  { n: '02', title: 'A whole team. Without the whole payroll.', desc: 'You don’t need to hire a separate employee for every finance need. You use the capacity and expertise you need at that moment.' },
  { n: '03', title: 'See where money is being left on the table', desc: 'We don’t just look back at what has been spent. We also flag where costs, margins, cash flow or processes deserve attention.' },
  { n: '04', title: 'Numbers with context', desc: 'No reporting without context. You get insight into what is happening, why it is happening and where you may need to adjust.' },
  { n: '05', title: 'Expertise when you need it', desc: 'Daily finance, close, control and reporting don’t always require the same profile. With Finable, you have access to the expertise of the team.' },
  { n: '06', title: 'Capacity that scales with you', desc: 'Need more finance capacity? That doesn’t automatically mean opening another vacancy. Capacity can scale with the stage of your business.' },
];

const resultaat = [
  { title: 'Less manual work', desc: 'Smarter processes' },
  { title: 'Faster insight', desc: 'Management information when it’s needed' },
  { title: 'Better financial context', desc: 'Visibility into costs, margins, cash flow and financial opportunities' },
  { title: 'Scalable capacity', desc: 'Grow without having to make another hire every time' },
];
---
<Layout
  title="The Good Roll × Finable | Finance that scales with you"
  description="See how Finable supports The Good Roll with day-to-day finance, closing, reporting and access to a scalable finance team."
  breadcrumbs={[{ name: 'Finable', path: '/en' }, { name: 'The Good Roll' }]}
>
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:52px;padding-bottom:64px">
    <div class="case-hero" style="display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,0.98fr);gap:clamp(36px,4.6vw,68px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:14px">Customer case</div>
        <div style="font-size:15px;color:var(--on-dark-tertiary);margin-bottom:26px">The Good Roll <span style="color:var(--terracotta)">&times;</span> Finable</div>
        <h1 style="font-size:clamp(38px,5vw,62px);line-height:1.04;margin-bottom:24px">Finance that scales with you. <span class="em">Without building an entire team.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:var(--on-dark-secondary);max-width:500px;text-wrap:pretty">The Good Roll focuses on impact and growth. Finable makes sure finance is taken care of, with one dedicated point of contact and access to a complete finance team.</p>
        <div style="margin-top:32px"><Button href="/en/book-a-call">Book a call &rarr;</Button></div>
      </div>
      <div style="position:relative">
        <div style="aspect-ratio:4/3;border-radius:16px;overflow:hidden"><img src="/images/sander-the-good-roll.webp" alt="Sander de Klerk from The Good Roll" width="1200" height="711" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        <div class="hero-note" style="position:absolute;right:-8px;top:-30px;width:150px;text-align:center;pointer-events:none">
          <div class="cav" style="font-size:22px">Less finance hassle. More room to grow.</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section class="wrap" style="padding-top:40px;padding-bottom:8px">
    <div class="proof-grid" style="border-bottom:1px solid var(--line);padding-bottom:40px;display:grid;grid-template-columns:auto minmax(0,1.35fr) 1px minmax(0,0.85fr);gap:clamp(18px,3vw,40px);align-items:center">
      <div style="width:74px;height:74px;border-radius:999px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--white);border:1px solid var(--line)"><img src="/images/the-good-roll.png" alt="The Good Roll logo" width="662" height="663" style="width:70%;height:70%;object-fit:contain;display:block"></div>
      <div>
        <blockquote style="font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(19px,2vw,25px);color:var(--navy);line-height:1.3;margin:0 0 12px;text-wrap:balance">&ldquo;We started small. Today, Finable handles almost all of our day-to-day finance.&rdquo;</blockquote>
        <div style="font-size:14px;color:var(--body)"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--navy)">Sander de Klerk</span> &middot; The Good Roll</div>
      </div>
      <div class="proof-div" style="background:var(--line);align-self:stretch"></div>
      <p style="font-size:15px;color:var(--body);line-height:1.6;text-wrap:pretty">This allows The Good Roll to focus on impact and growth, while its day-to-day finance is taken care of.</p>
    </div>
  </section>

  <!-- DE UITDAGING -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div style="max-width:760px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">The challenge</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px;text-wrap:balance">Growth naturally makes finance more complex.</h2>
      <p style="font-size:17px;color:var(--body);line-height:1.7;text-wrap:pretty">More revenue means more transactions, more suppliers, more reporting, more controls and more questions from management. At some point, you need more than someone to manage the books. You need different types of finance expertise.</p>
    </div>
    <div>
      <div class="journey" style="display:flex;flex-wrap:wrap;gap:14px;align-items:stretch">
        {journey.map((step, i) => (
          <>
            <div style="flex:1 1 150px;min-width:150px;background:var(--section);border-radius:14px;padding:26px 22px">
              <div style="margin-bottom:16px">
                {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h5"/></svg>}
                {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M9 14l2 2 4-4"/></svg>}
                {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>}
                {i === 3 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><rect x="8" y="12" width="3" height="5"/><rect x="13" y="8" width="3" height="9"/><rect x="18" y="14" width="0.5" height="3"/></svg>}
                {i === 4 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="10" r="6"/><path d="M9 20h6M10 22h4M12 4v1M12 10l2.5-2.5"/></svg>}
              </div>
              <div style="font-family:'Playfair Display',serif;font-weight:600;font-size:18px;color:var(--navy);margin-bottom:6px">{step.title}</div>
              <div style="font-size:13px;color:var(--body);line-height:1.5">{step.desc}</div>
            </div>
            {i < journey.length - 1 && (
              <div class="jarrow" style="display:flex;align-items:center;flex:0 0 auto"><svg width="22" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg></div>
            )}
          </>
        ))}
      </div>
      <div class="case-note" style="text-align:right;margin-top:20px;pointer-events:none">
        <span class="cav" style="font-size:21px">From more transactions to better insight.</span>
      </div>
    </div>
  </section>

  <!-- WAT FINABLE REGELT (navy, primair) + EEN EXTRA FINANCE-HIRE? (licht, secundair) -->
  <section style="background:var(--white)">
    <div class="wrap" style="padding-top:88px;padding-bottom:88px">
    <div class="sol-grid" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(40px,4.4vw,58px);align-items:start">
      <div>
        <div class="sol-navy" style="background:var(--navy);border-radius:20px;padding:clamp(30px,3.4vw,44px)">
          <div class="lbl" style="margin-bottom:18px">What Finable handles for The Good Roll</div>
          <h2 style="font-size:clamp(27px,3.3vw,40px);color:var(--warm-white);margin-bottom:18px;text-wrap:balance">From bookkeeping to a complete finance function.</h2>
          <p style="font-size:16px;color:var(--on-dark-secondary);line-height:1.7;margin-bottom:22px;text-wrap:pretty">We started small, with day-to-day administration. Today, Finable runs almost all of The Good Roll&rsquo;s day-to-day finance, with one dedicated point of contact and a team behind them.</p>
          <div class="sol-list">
            {regelt.map((item) => (
              <div>
                <span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="rgba(196,100,58,0.12)"/><path d="M5 9.3l2.6 2.6L13 6.5" stroke="#C4643A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class:list={[item === regeltEmphasis && 'is-key']}>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="sol-right">
        <h2 style="font-size:clamp(21px,2.3vw,27px);line-height:1.2;margin-bottom:12px;text-wrap:balance">Another finance hire? Or first look at what you actually need?</h2>
        <p style="font-size:15px;color:var(--body);line-height:1.6;margin-bottom:24px;text-wrap:pretty">Sometimes a Financial Controller is the right choice. Sometimes a team is the better solution. Finable can support both scenarios.</p>
        <div class="vs-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
          <div class="vs-card vs-hire">
            <div class="vs-head">1 Financial Controller</div>
            {controller.map((item) => (
              <div>
                <span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="#C4643A" stroke-opacity="0.45" stroke-width="1.4"/><path d="M6.3 6.3l5.4 5.4M11.7 6.3l-5.4 5.4" stroke="#C4643A" stroke-opacity="0.75" stroke-width="1.5" stroke-linecap="round"/></svg></span>
                <span>{item}</span>
              </div>
            ))}
          </div>
          <div class="vs-card vs-fin">
            <div class="vs-head">Finable</div>
            {finable.map((item) => (
              <div>
                <span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="rgba(196,100,58,0.12)"/><path d="M5 9.3l2.6 2.6L13 6.5" stroke="#C4643A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="vs-note" style="text-align:right;margin-top:22px;pointer-events:none"><span class="cav" style="font-size:21px">Let your controller be a controller.</span></div>
      </div>
    </div>
    </div>
  </section>

  <!-- WAAROM DIT MODEL -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div style="max-width:760px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">Why this model</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px;text-wrap:balance">Finance that doesn&rsquo;t just add up, but helps your business move forward.</h2>
      <p style="font-size:17px;color:var(--body);line-height:1.7;text-wrap:pretty">Good finance isn&rsquo;t just about getting the numbers right. It&rsquo;s about knowing where you stand, understanding what is happening and seeing where you can make better decisions.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
      {waarom.map((w, i) => (
        <div style="background:var(--white);border:1px solid var(--line);border-radius:14px;padding:30px 28px">
          <div style="margin-bottom:16px">
            {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>}
            {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 19c0-3.3 2.7-5 6-5s6 1.7 6 5"/><path d="M16 5.5a3 3 0 010 5.5M17 19c0-2.3-.7-3.8-2-4.7"/></svg>}
            {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M11 8v6M8 11h6M20 20l-3.5-3.5"/></svg>}
            {i === 3 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><path d="M8 15l3-3 3 2 4-6"/></svg>}
            {i === 4 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M2 19c0-3.3 2.5-5 6-5s6 1.7 6 5"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 19c0-2.5 1-4 2.5-4s2.9 1.2 3 3.5"/></svg>}
            {i === 5 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20L20 4M20 4h-7M20 4v7"/></svg>}
          </div>
          <div style="font-family:'Playfair Display',serif;font-size:15px;color:var(--terracotta);line-height:1;margin-bottom:12px">{w.n}</div>
          <h3 style="font-size:20px;margin-bottom:10px">{w.title}</h3>
          <p style="font-size:15px;color:var(--body);line-height:1.6">{w.desc}</p>
        </div>
      ))}
    </div>
    <div class="case-note" style="text-align:right;margin-top:24px;pointer-events:none"><span class="cav" style="font-size:21px">More insight. Less hassle. Better decisions.</span></div>
  </section>

  <!-- HET RESULTAAT -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div style="max-width:720px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">The result</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px;text-wrap:balance">More peace of mind. More insight. More room to grow.</h2>
      <p style="font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty">With Finable, The Good Roll has a finance organisation that can scale with the ambitions of the business. A flexible team providing structure, insight and continuity.</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:18px">
      {resultaat.map((r, i) => (
        <div style="flex:1 1 190px;min-width:190px;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:26px 24px">
          <div style="margin-bottom:16px">
            {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><path d="M8 16l3-3 3 2 4-5"/></svg>}
            {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>}
            {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="9" r="3.2"/><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/><path d="M16 6.5a3 3 0 010 6M18 19c0-2.2-.8-3.6-2-4.5"/></svg>}
            {i === 3 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20L20 4M20 4h-7M20 4v7"/></svg>}
          </div>
          <div style="font-family:'Playfair Display',serif;font-weight:600;font-size:18px;color:var(--navy);margin-bottom:6px">{r.title}</div>
          <div style="font-size:14px;color:var(--body);line-height:1.55">{r.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- QUOTE (navy) -->
  <section style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div class="quote-grid" style="display:grid;grid-template-columns:clamp(170px,22vw,260px) minmax(0,1fr);gap:clamp(30px,4vw,60px);align-items:center">
      <div style="aspect-ratio:1/1;border-radius:16px;overflow:hidden"><img src="/images/sander-the-good-roll.webp" alt="Sander de Klerk from The Good Roll" width="1200" height="711" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
      <div>
        <blockquote style="font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(22px,2.7vw,36px);color:var(--warm-white);line-height:1.28;margin:0 0 24px;text-wrap:balance">&ldquo;I was sceptical at first, but we started small with just the bookkeeping. Today, Finable handles almost all of our day-to-day finance. <span style="color:var(--terracotta)">I would recommend them to anyone.</span>&rdquo;</blockquote>
        <div style="font-size:15px;color:var(--on-dark-secondary);line-height:1.5"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">Sander de Klerk</span><br>The Good Roll</div>
        <!-- Het citaat is in het Nederlands gedaan; ingetogen vermeld, niet als visueel element. -->
        <p style="font-size:13px;color:var(--on-dark-tertiary);margin-top:14px">Translated from Dutch</p>
      </div>
    </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:84px">
    <div class="fcta-grid" style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,0.7fr);gap:clamp(32px,4vw,56px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:18px">Ready for the next step?</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);color:var(--warm-white);margin-bottom:20px;text-wrap:balance">Your business is growing. Your finance headcount doesn&rsquo;t have to grow at the same pace.</h2>
        <p style="font-size:16px;color:var(--on-dark-secondary);max-width:560px;text-wrap:pretty">Considering a Financial Controller, Finance Manager or additional finance capacity? Let&rsquo;s compare the options.</p>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:20px">
        <Button href="/en/book-a-call">Book a call &rarr;</Button>
        <span class="cav" style="font-size:22px">Finance taken care of. Keep growing.</span>
      </div>
    </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--terracotta);line-height:1.15}
  /* Finance-journey: vijf stappen met pijlen ertussen. */
  .journey .jarrow{color:var(--terracotta)}
  /* Checklist in het navy paneel: dunne scheidingslijnen, geen kaartjes per regel. */
  .sol-list>div{display:flex;gap:13px;align-items:flex-start;padding:12px 0;border-top:1px solid rgba(255,255,255,0.14)}
  .sol-list>div:first-child{border-top:none}
  .sol-list>div>span:first-child{flex-shrink:0;margin-top:1px;line-height:0}
  .sol-list>div>span:last-child{font-size:15px;color:rgba(255,255,255,0.86);line-height:1.5}
  .sol-list .is-key{color:var(--white)!important;font-weight:500}
