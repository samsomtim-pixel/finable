---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
---
<Layout title="About Finable — Tim Samsom and the team" description="Who is behind Finable: Tim Samsom as your one point of contact, backed by a fixed team of finance professionals who run the day-to-day finance work.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header active="over" />

  <!-- HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:64px">
    <div class="over-hero" style="display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:40px;align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:22px">About Finable</div>
        <h1 style="font-size:clamp(36px,5vw,60px);margin-bottom:26px;text-wrap:balance">One point of contact. <span class="em">A complete finance team behind it.</span></h1>
        <p style="font-size:clamp(17px,2vw,21px);color:rgba(255,255,255,.78);max-width:520px;text-wrap:pretty">Finable isn't an anonymous finance provider. You have one person who knows your business, backed by an experienced team that runs the day-to-day finance work.</p>
      </div>
      <div style="position:relative;display:flex;justify-content:flex-end;align-items:center;min-height:320px">
        <div class="over-photo" style="width:100%;height:clamp(280px,32vw,380px);border-radius:16px;overflow:hidden"><img src="/images/tim-samsom.webp" alt="Tim Samsom, founder of Finable" width="800" height="699" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        <div class="over-note" style="position:absolute;left:-16px;top:8px;max-width:180px">
          <div style="font-family:'Caveat',cursive;font-size:24px;line-height:1.25;color:var(--white)">You always know who to call.</div>
          <svg width="80" height="52" viewBox="0 0 80 52" fill="none" style="margin-top:2px" aria-hidden="true"><path d="M4 6C18 36 44 44 72 40" stroke="#C4643A" stroke-width="2" stroke-linecap="round"/><path d="M64 31l9 10-14 3" stroke="#C4643A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:var(--line)"></div></div>

  <!-- 01 · WHY -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div style="margin-bottom:36px">
      <div class="lbl" style="margin-bottom:18px">Why Finable</div>
      <h2 class="fin-sechead">Why I started Finable.</h2>
    </div>
    <div class="over-2col" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:48px;align-items:center">
      <div>
        <p style="font-size:16px;color:var(--body);margin-bottom:18px">Growing companies often end up in an awkward place with finance. They're too complex to rely on bookkeeping alone, but building an entire finance team in-house is expensive and difficult.</p>
        <p style="font-size:16px;color:var(--body);margin-bottom:18px">The result is often one finance hire who is expected to do everything: keep the operation running, close the month, control the numbers and give management the insight it needs.</p>
        <p style="font-size:16px;color:var(--body);margin-bottom:18px">I started Finable around a different idea: organise finance as a team from the start. Different expertise for different parts of the work, but one person who knows your organisation and keeps everything connected.</p>
        <p style="font-size:16px;color:var(--navy);font-weight:500">So you get the capability of a finance team without having to build one yourself.</p>
      </div>
      <div>
        <div style="width:56px;height:3px;background:var(--terracotta);margin-bottom:24px;border-radius:2px"></div>
        <div style="font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(22px,2.6vw,30px);line-height:1.2;color:var(--navy)">Tim Samsom</div>
        <div style="font-size:16px;color:var(--body);margin-top:6px">Founder, Finable</div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:var(--line)"></div></div>

  <!-- 02 · MY ROLE -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div style="margin-bottom:40px">
      <div class="lbl" style="margin-bottom:18px">My role</div>
      <h2 class="fin-sechead">My role is simple.</h2>
    </div>
    <div class="fin-3col">
      <div style="display:flex;gap:18px;padding:8px 32px 8px 0">
        <div style="width:52px;height:52px;border-radius:999px;background:rgba(196,100,58,0.10);display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="26" height="26" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg></div>
        <div><h3 style="font-size:18px;color:var(--navy);margin-bottom:8px">I know your business.</h3><p class="fin-cap">I understand how your organisation works, what matters to you and how your finance is set up.</p></div>
      </div>
      <div class="fin-vsep" style="display:flex;gap:18px;padding:8px 32px;border-left:1px solid var(--line)">
        <div style="width:52px;height:52px;border-radius:999px;background:rgba(196,100,58,0.10);display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="26" height="26" viewBox="0 0 26 28" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><path d="M13 3l9 3v7c0 6-4 10-9 12C8 23 4 19 4 13V6z"/><path d="M9 13l3 3 5-6"/></svg></div>
        <div><h3 style="font-size:18px;color:var(--navy);margin-bottom:8px">I keep things connected.</h3><p class="fin-cap">I make sure the collaboration between your organisation and the Finable team works as it should.</p></div>
      </div>
      <div class="fin-vsep" style="display:flex;gap:18px;padding:8px 0 8px 32px;border-left:1px solid var(--line)">
        <div style="width:52px;height:52px;border-radius:999px;background:rgba(196,100,58,0.10);display:flex;align-items:center;justify-content:center;flex-shrink:0"><svg width="26" height="26" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><path d="M5 5h18v14H13l-6 5v-5H5z"/></svg></div>
        <div><h3 style="font-size:18px;color:var(--navy);margin-bottom:8px">I step in when needed.</h3><p class="fin-cap">If something gets stuck or needs attention, you know exactly who to call.</p></div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:var(--line)"></div></div>

  <!-- HOW WE WORK -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div style="margin-bottom:36px">
      <div class="lbl" style="margin-bottom:18px">How we work</div>
      <h2 class="fin-sechead">The right work, with the right people.</h2>
    </div>
    <div class="over-2col" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:44px;align-items:center">
      <div>
        <p style="font-size:16px;color:var(--body)">I stay close to your organisation and keep the collaboration on track. The finance work itself is handled by the professionals in the team with the expertise it requires.</p>
      </div>
      <div style="background:rgba(196,100,58,0.10);border-radius:16px;padding:34px 36px">
        <div style="width:48px;height:3px;background:var(--terracotta);margin-bottom:20px;border-radius:2px"></div>
        <p style="font-family:'Playfair Display',serif;font-size:23px;color:var(--navy);line-height:1.35;margin-bottom:8px">Finance expertise where it belongs.</p>
        <p style="font-family:'Playfair Display',serif;font-size:23px;color:var(--terracotta);line-height:1.35">One point of contact for you.</p>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:var(--line)"></div></div>

  <!-- 04 · THE TEAM BEHIND FINABLE -->
  <section class="wrap" style="padding-top:72px;padding-bottom:72px">
    <div style="margin-bottom:28px">
      <div class="lbl" style="margin-bottom:18px">The team behind Finable</div>
      <h2 class="fin-sechead" style="font-size:clamp(30px,4vw,46px)">The people who keep your finance running.</h2>
    </div>
    <p style="font-size:16px;color:var(--body);max-width:620px;margin:0 0 48px 0">A fixed team of finance professionals works behind the scenes to keep the operation running, close the month, control the numbers and prepare reporting.</p>

    <div class="over-team" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:56px;align-items:start">
      <div>
        <p style="font-size:16px;color:var(--body);margin-bottom:18px">Behind Finable is a finance team with experience in bookkeeping, month-end close, controlling, reporting and international finance.</p>
        <p style="font-size:16px;color:var(--body)">You work with a fixed team that gets to know your company, processes and systems. Within the team, the work is divided based on the expertise it requires.</p>
      </div>
      <!-- Two real portraits, two intentionally neutral slots until the photos are supplied -->
      <div class="fin-4port">
        <div>
          <div style="aspect-ratio:3/4;border-radius:12px;overflow:hidden"><img src="/images/janesh-gupta.webp" alt="Janesh Gupta" width="400" height="400" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
          <div style="margin-top:14px"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Janesh Gupta</div><div style="font-size:13px;color:var(--body)">Chartered Accountant · Lawyer</div><div style="font-size:13px;color:var(--terracotta)">EY alumnus</div></div>
        </div>
        <div>
          <div role="img" aria-label="Portrait of Rishabh Goyal (to follow)" class="port-pending"><span>portrait to follow</span></div>
          <div style="margin-top:14px"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Rishabh Goyal</div><div style="font-size:13px;color:var(--body)">Chartered Accountant</div><div style="font-size:13px;color:var(--terracotta)">EY alumnus</div></div>
        </div>
        <div>
          <div role="img" aria-label="Portrait of Himanshu Poddar (to follow)" class="port-pending"><span>portrait to follow</span></div>
          <div style="margin-top:14px"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Himanshu Poddar</div><div style="font-size:13px;color:var(--body)">Chartered Accountant</div><div style="font-size:13px;color:var(--terracotta)">Tax &amp; Transfer Pricing</div></div>
        </div>
        <div>
          <div style="aspect-ratio:3/4;border-radius:12px;overflow:hidden"><img src="/images/shilpa-goyal.webp" alt="Shilpa Goyal" width="400" height="400" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
          <div style="margin-top:14px"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Shilpa Goyal</div><div style="font-size:13px;color:var(--body)">Chartered Accountant</div><div style="font-size:13px;color:var(--terracotta)">US Startup Finance</div></div>
        </div>
      </div>
    </div>

    <!-- proof + reference row -->
    <div class="over-team" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:56px;align-items:start;margin-top:52px">
      <div class="over-stats" style="display:grid;grid-template-columns:repeat(3,1fr)">
        <!-- VERIFY WITH JANESH BEFORE PRODUCTION: 20+ finance specialists -->
        <div style="padding-right:20px"><div style="font-family:'Playfair Display',serif;font-size:clamp(30px,4vw,44px);color:var(--terracotta);line-height:1">20+</div><p class="fin-cap" style="margin-top:8px">Finance specialists in the fixed team</p></div>
        <div style="padding:0 20px;border-left:1px solid var(--line)"><div style="font-family:'Playfair Display',serif;font-size:clamp(30px,4vw,44px);color:var(--terracotta);line-height:1">CA</div><p class="fin-cap" style="margin-top:8px">Chartered Accountants in the senior team</p></div>
        <div style="padding-left:20px;border-left:1px solid var(--line)"><div style="font-family:'Playfair Display',serif;font-size:clamp(30px,4vw,44px);color:var(--terracotta);line-height:1">EY</div><p class="fin-cap" style="margin-top:8px">Big Four background within the team leadership</p></div>
      </div>
      <!-- reference strip: experience of the people behind Finable, not a client list -->
      <div>
        <div style="border-top:1px solid var(--line);padding-top:14px;font-size:12px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--body);margin-bottom:20px">The team's experience</div>
        <div class="over-refs" style="display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-bottom:18px">
          <div style="padding-right:16px"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Talogy Group</div><div style="font-size:12px;color:var(--body)">Global HR</div></div>
          <div style="padding:0 16px;border-left:1px solid var(--line)"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Trodat</div><div style="font-size:12px;color:var(--body)">Austria</div></div>
          <div style="padding:0 16px;border-left:1px solid var(--line)"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">KidzInk</div><div style="font-size:12px;color:var(--body)">Dubai</div></div>
          <div style="padding-left:16px;border-left:1px solid var(--line)"><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:16px;color:var(--navy)">Occassion</div><div style="font-size:12px;color:var(--body)">United States</div></div>
        </div>
        <p style="font-size:13px;color:var(--body)">Experience with international organisations, multiple entities, currencies and jurisdictions. That experience sits in the same fixed team behind Finable.</p>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:var(--line)"></div></div>

  <!-- CTA (navy) -->
  <section style="background:var(--navy)">
    <div class="wrap" style="padding-top:64px;padding-bottom:72px">
    <div class="over-cta" style="display:grid;grid-template-columns:clamp(120px,14vw,150px) minmax(0,1fr) auto;gap:clamp(28px,3.4vw,48px);align-items:center">
      <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt="Tim Samsom, founder of Finable" width="800" height="699" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
      <div>
        <div class="lbl" style="margin-bottom:16px">Personal introduction</div>
        <h2 style="font-family:'Playfair Display',serif;font-size:clamp(24px,2.7vw,34px);color:var(--white);line-height:1.1;margin-bottom:12px;text-wrap:balance">Curious whether Finable could work for your organisation?</h2>
        <p style="font-size:16px;color:var(--on-dark-secondary);max-width:520px;text-wrap:pretty">Book 30 minutes with Tim to talk through how your finance is organised today and where Finable could take over or strengthen the function.</p>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:18px">
        <Button href="/en/book-a-call">Book a call &rarr;</Button>
        <div style="font-size:14px;color:var(--on-dark-secondary);line-height:1.45"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">Tim Samsom</span><br>Founder, Finable</div>
      </div>
    </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  body{line-height:1.6}
  .fin-sechead{font-family:'Playfair Display',serif;font-weight:600;color:var(--navy);font-size:clamp(26px,3.4vw,38px)}
  .fin-cap{font-size:15px;color:var(--body)}
  .fin-3col{display:grid;grid-template-columns:repeat(3,1fr);gap:0}
  .fin-4port{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .port-pending{aspect-ratio:3/4;border-radius:12px;background:#ECEAE6;display:flex;align-items:flex-end;justify-content:center}
  .port-pending span{font-family:monospace;font-size:10px;color:#9A9186;margin-bottom:14px}
  @media (max-width:1023px){
  .fin-3col{grid-template-columns:1fr;gap:0}
  .fin-3col .fin-vsep{border-left:none;padding-left:0;padding-right:0}
  .fin-4port{grid-template-columns:repeat(2,1fr);gap:20px}
  .over-cta{grid-template-columns:1fr!important;gap:24px!important}
  }
  @media (max-width:639px){ .fin-4port{grid-template-columns:1fr} }
  @media (max-width:1023px){
    .over-hero{grid-template-columns:1fr!important}
    .over-hero>div:last-child{order:-1;min-height:0!important}
    .over-note{display:none}
    .over-team{grid-template-columns:1fr!important;gap:36px!important}
    .over-cta>div:first-child{max-width:150px}
    .fin-3col{gap:10px}
    .fin-3col>div{padding:8px 0!important;border-left:none!important}
  }
  @media (max-width:639px){
    .over-stats{grid-template-columns:1fr!important;gap:18px}
    .over-stats>div{padding:18px 0 0!important;border-left:none!important;border-top:1px solid var(--line)}
    .over-stats>div:first-child{padding-top:0!important;border-top:none}
    .over-2col{grid-template-columns:1fr!important}
    .over-refs{grid-template-columns:1fr 1fr!important;gap:16px!important}
    .over-refs>div{padding:0!important;border-left:none!important}
    .over-hero{gap:28px!important}
    .over-hero>div:last-child{order:0}
    .over-photo{height:240px!important}
    .fin-4port{grid-template-columns:repeat(2,1fr)!important;gap:16px!important}
    .fin-4port div[style*="margin-top:14px"]{margin-top:10px!important}
  }
</style>
