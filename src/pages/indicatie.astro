  }
  @media (max-width:639px){ .fin-grid3{grid-template-columns:1fr} }
  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:28px;padding:26px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(18px,2vw,22px);color:var(--navy);line-height:1.3;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:18px;height:18px;flex-shrink:0;margin-top:5px}
