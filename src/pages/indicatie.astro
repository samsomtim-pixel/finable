  .fin-card-opt{display:flex;gap:14px;align-items:flex-start;padding:18px;background:var(--white);border:1px solid var(--line);border-radius:12px;cursor:pointer;transition:border-color .15s,background .15s;text-align:left}
  .fin-card-opt:hover{border-color:var(--line)}
  .fin-card-opt[data-active="1"]{border-color:var(--terracotta);background:rgba(196,100,58,0.10)}
  .fin-card-opt[data-active="1"] svg{stroke:var(--terracotta)}
  .fin-input{width:100%;padding:13px 16px;background:var(--white);border:1px solid var(--line);border-radius:10px;font-size:15px;font-family:inherit;color:var(--navy)}
  .fin-input::placeholder{color:var(--body)}
  .fin-input:focus{outline:2px solid var(--terracotta);outline-offset:1px;border-color:var(--terracotta)}
  .fin-tile:focus-visible,.fin-card-opt:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid var(--terracotta);outline-offset:2px}
  .fin-grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .fin-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .fin-grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .fin-layout{display:grid;grid-template-columns:minmax(0,0.66fr) minmax(0,1fr);gap:56px;align-items:start}
  .fin-left{position:sticky;top:32px}
  @media (max-width:1023px){
  .fin-layout{grid-template-columns:1fr;gap:32px}
