---
// Doelgroeppagina voor boekhouders en administratiekantoren. Tweede route naar de markt, naast de
// primaire propositie op de homepage. Staat bewust op noindex zolang de propositie wordt gevalideerd.
//
// Content, volgorde en visueel ritme volgen het goedgekeurde ontwerp
// (voor-boekhouders-nav2_v3). Het ritme is navy → wit → licht → navy → wit → licht → navy.
//
// Alles staat op de bestaande shell en het bestaande designsysteem: Layout, Header, Footer, Button,
// tokens. Hergebruikte patronen van andere pagina's, met hun eigen klassenamen:
//   .hero-navy / .lbl / .em   — heropatroon van alle navy hero's
//   .fin-faq / .faq-navy      — FAQ-accordeon van /aanpak, /finance-hire en de homepage
//   .vb-rec / .vb-reccard     — herkenningskaarten, ongewijzigd ten opzichte van de vorige versie
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const herkenning = [
  { n: '01', t: 'Je klantenbestand groeit', d: 'Meer werk komt binnen dan je huidige team kan verwerken.' },
  { n: '02', t: 'Piekdrukte of achterstand', d: 'Tijdelijk extra capaciteit om werk weer onder controle te krijgen.' },
  { n: '03', t: 'Een vacature blijft open', d: 'Het werk hoeft niet te wachten tot de juiste medewerker gevonden is.' },
  { n: '04', t: 'Terugkerend werk kost tijd', d: 'Voeg capaciteit toe voor werkzaamheden die iedere week of maand terugkomen.' },
  { n: '05', t: 'Een klant vraagt meer', d: 'Extra ondersteuning wanneer een klant aanvullende financewerkzaamheden nodig heeft.' },
  { n: '06', t: 'Je wilt doorgroeien', d: 'Meer werk aankunnen zonder iedere groei direct met een nieuwe hire op te lossen.' },
];

/** De keten uit het NOAB-onderzoek: waarom kantoren werk anders gaan organiseren. */
const markt = ['Personeelstekort', 'Werk anders organiseren', 'Meer ruimte voor klant & advies'];

/** Drie categorieën werk dat een kantoor kan neerleggen. Jaarwerk staat er bewust als
 *  'voorbereiding jaarwerk': het opstellen en ondertekenen van de jaarrekening en fiscaal advies
 *  vallen volgens de FAQ op /aanpak uitdrukkelijk buiten wat Finable doet. */
const capabilities = [
  {
    t: '01 · Dagelijks financewerk',
    items: ['Inkoopfacturen verwerken en coderen', 'Verkoopfacturen verwerken', 'Bank en creditcard boeken', 'Declaraties verwerken', 'Debiteuren opvolgen', 'Administraties bijhouden'],
  },
  {
    t: '02 · Afsluiting & controle',
    items: ['Bank- en balansreconciliaties', 'Accruals en vooruitbetalingen', 'Vaste activa en afschrijvingen', 'BTW-voorbereiding', 'Maandafsluiting', 'Werkdossiers en aansluitingen', 'Voorbereiding jaarwerk'],
  },
  {
    t: '03 · Reporting & ondersteuning',
    items: ['Managementrapportages voorbereiden', 'Actuals versus budget inzichtelijk maken', 'Cashflow-overzichten', 'Financiële analyses voorbereiden', 'Consolidatie-ondersteuning', 'Uitzoekwerk en ad-hoc financevragen'],
  },
];

/** Drie niveaus van verantwoordelijkheid: het kantoor kiest hoe ver het werk gaat. */
const grens = [
  { t: 'Finable voert uit', d: '&rarr; jij controleert' },
  { t: 'Finable voert uit + controleert', d: '&rarr; jij accordeert' },
  { t: 'Finable verzorgt het proces', d: '&rarr; jij houdt klantcontact & advies' },
];

const zekerheden = [
  { t: 'Vaste capaciteit', d: 'Een vaste bezetting die jouw kantoor en werkwijze leert kennen.' },
  { t: 'Vast aanspreekpunt', d: 'Eén persoon die de samenwerking kent en met je bespreekt wat er speelt.' },
  { t: 'Controle in het proces', d: 'Duidelijke afspraken over uitvoering, review en akkoord.' },
  { t: 'Voorspelbare kosten', d: 'Vooraf duidelijk welke capaciteit en werkzaamheden je afneemt.' },
];

const vormen = [
  { n: '01', t: 'Eén administratie', d: 'Voor een eerste afgebakende pilot.' },
  { n: '02', t: 'Vaste dagen capaciteit', d: 'Voor structureel terugkerend werk over meerdere klanten.' },
  { n: '03', t: 'Structurele capaciteit', d: 'Als Finable een verlengstuk van je eigen team wordt.' },
];

const faq = [
  { q: 'Blijft mijn klant van mij?', a: 'Ja. Het uitgangspunt is dat jij de klantrelatie houdt. Vooraf spreken we af welke rol Finable achter jouw kantoor speelt.' },
  { q: 'Welk werk kan ik uitbesteden?', a: 'Van dagelijkse verwerking en aansluitingen tot maandafsluiting, reporting support en voorbereiding van jaarwerk. De precieze scope bepalen we samen.' },
  { q: 'Kan ik beginnen met één administratie?', a: 'Ja. Klein beginnen is juist een logische manier om de samenwerking en werkwijze te testen.' },
  { q: 'Kan ik ook vaste dagen per week capaciteit afnemen?', a: 'Ja. Als er structureel werk ligt, kunnen we capaciteit organiseren voor een vast aantal dagen per week en later op- of afschalen.' },
  { q: 'Wie voert het werk uit?', a: 'Je werkt met Finable als vast Nederlands aanspreekpunt, met internationale financeprofessionals onder Nederlandse regie erachter. Wie welk werk uitvoert en wie controleert, spreken we vooraf helder af.' },
  { q: 'Hoe houden we controle op het werk en de data?', a: 'Vooraf spreken we processen, verantwoordelijkheden, controles en reviewmomenten af. Ook toegang en gegevensverwerking richten we per samenwerking in; de precieze afspraken leggen we bij de start vast.' },
  { q: 'Hoe wordt de prijs bepaald?', a: 'Op basis van scope, volume, capaciteit en verantwoordelijkheidsverdeling. Vooraf is duidelijk wat Finable doet en wat dat kost.' },
];

const arrow = 'M0 9h24M18 2l8 7-8 7';
---
<Layout
  title="Finable voor boekhouders | Flexibele financecapaciteit"
  description="Meer klanten bedienen zonder je team even hard te laten groeien. Finable biedt boekhouders en administratiekantoren flexibele financecapaciteit."
  noindex={true}
  hreflang={false}
>
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- 1 · HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:64px">
      <div style="max-width:840px">
        <div class="lbl" style="margin-bottom:22px">Voor boekhouders &amp; administratiekantoren</div>
        <h1 style="font-size:clamp(34px,4.6vw,58px);line-height:1.05;margin-bottom:24px;text-wrap:balance">Meer klanten bedienen. <span class="em">Zonder je team even hard te laten groeien.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:var(--on-dark-secondary);max-width:640px;text-wrap:pretty">Finable geeft boekhouders en administratiekantoren extra financecapaciteit voor terugkerend werk, afsluiting en piekdrukte. Begin klein of werk met vaste capaciteit die met je kantoor meegroeit.</p>
        <div class="vb-hero-cta">
          <Button href="/gesprek">Plan een kennismaking &rarr;</Button>
          <a href="#overdragen" class="vb-hero-alt">Bekijk wat je kunt uitbesteden &darr;</a>
        </div>
        <div class="vb-trust">
          <div><span aria-hidden="true"></span>Vast aanspreekpunt</div>
          <div><span aria-hidden="true"></span>Controle in het proces</div>
          <div><span aria-hidden="true"></span>Flexibel op- en afschalen</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · HERKENNING (wit) -->
  <section class="wrap" style="padding-top:72px;padding-bottom:64px">
    <div style="max-width:720px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">Herken je dit?</div>
      <h2 style="font-size:clamp(26px,3.2vw,40px);margin-bottom:18px;text-wrap:balance">Extra capaciteit, precies waar je die nodig hebt.</h2>
      <p style="font-size:16px;color:var(--body);line-height:1.7;max-width:620px;text-wrap:pretty">Soms vraagt het werk meer dan het team op dat moment aankan. Finable vult aan waar dat helpt, structureel of tijdelijk, zodat je kantoor door kan blijven leveren.</p>
    </div>
    <div class="vb-rec">
      {herkenning.map((x) => (
        <div class="vb-reccard">
          <div class="vb-recn">{x.n}</div>
          <h3>{x.t}</h3>
          <p>{x.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 3 · MARKTONTWIKKELING (licht) -->
  <section style="background:var(--section)">
    <div class="wrap" style="padding-top:64px;padding-bottom:64px">
      <div style="max-width:720px;margin-bottom:36px">
        <div class="lbl" style="margin-bottom:18px">Ontwikkeling in de markt</div>
        <h2 style="font-size:clamp(26px,3vw,38px);margin-bottom:18px;text-wrap:balance">Administratiekantoren besteden steeds vaker werk uit.</h2>
        <p style="font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty">Personeelstekorten zorgen ervoor dat administratie- en belastingadvieskantoren vaker werkzaamheden uitbesteden. Daarmee maken kantoren capaciteit vrij voor onder andere advies, specialistisch werk en piekbelasting.</p>
      </div>
      <div class="vb-mkt">
        {markt.map((m, i) => (
          <>
            <div class="vb-mkt-n">{m}</div>
            {i < markt.length - 1 && <svg class="vb-mkt-a" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d={arrow}/></svg>}
          </>
        ))}
      </div>
      <p class="vb-src">Gebaseerd op NOAB-onderzoek, gepubliceerd door Accountant.nl, juli 2026. <a href="https://www.accountant.nl/nieuws/2026/7/administratiekantoren-moeten-door-personeelstekort-steeds-vaker-werk-uitbesteden/" target="_blank" rel="noopener noreferrer">Lees het artikel bij Accountant.nl &rarr;</a></p>
    </div>
  </section>

  <!-- 4 · WAT KUN JE OVERDRAGEN (navy) — het visuele zwaartepunt -->
  <section id="overdragen" style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:76px">
      <div style="max-width:720px;margin-bottom:44px">
        <div class="lbl" style="margin-bottom:18px">Wat wij kunnen betekenen</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);color:var(--warm-white);margin-bottom:18px;text-wrap:balance">Dit werk kun je bij Finable neerleggen.</h2>
        <p style="font-size:16px;color:var(--on-dark-secondary);line-height:1.7;text-wrap:pretty">Van dagelijkse verwerking tot maandafsluiting en rapportage. Jij bepaalt wat je overdraagt en wat je zelf blijft doen.</p>
      </div>
      <!-- Rustige kolommen direct op navy: een terracotta onderlijn per categorie, geen kaarten. -->
      <div class="vb-caps">
        {capabilities.map((c) => (
          <div class="vb-cap">
            <h3 class="lbl vb-cap-h">{c.t}</h3>
            <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <h3 class="vb-grens-h">Jij bepaalt waar de grens ligt.</h3>
      <div class="vb-grens">
        {grens.map((g) => (
          <div class="vb-grenscard">
            <div class="vb-grenst">{g.t}</div>
            <div class="vb-grensd" set:html={g.d} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · WAAR JE OP KUNT REKENEN (wit) -->
  <section class="wrap" style="padding-top:72px;padding-bottom:64px">
    <h2 style="font-size:clamp(26px,3.2vw,38px);margin-bottom:40px;text-wrap:balance">Waar je op kunt rekenen</h2>
    <div class="vb-rely">
      {zekerheden.map((z) => (
        <div>
          <div class="lbl vb-rely-k">{z.t}</div>
          <p>{z.d}</p>
        </div>
      ))}
    </div>
    <p class="vb-rely-end"><strong>Jij houdt de klantrelatie.</strong> Begin met één administratie en schaal pas op als het werkt.</p>
  </section>

  <!-- 6 · SAMENWERKEN + PRIJS (licht) -->
  <section style="background:var(--section)">
    <div class="wrap" style="padding-top:72px;padding-bottom:72px">
      <div style="max-width:720px;margin-bottom:44px">
        <div class="lbl" style="margin-bottom:18px">Samenwerken</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);text-wrap:balance">Begin klein. Schaal op als het werkt.</h2>
      </div>
      <div class="vb-vormen">
        {vormen.map((v) => (
          <div class="vb-vorm">
            <div class="lbl" style="margin-bottom:14px">{v.n}</div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </div>
        ))}
      </div>
      <div class="vb-prijs">
        <h3>Wat kost het?</h3>
        <p>De kosten hangen af van het werk, volume, de gewenste capaciteit en de verdeling van verantwoordelijkheden. Vooraf spreken we af wat Finable doet en wat dat kost.</p>
        <Button href="/gesprek">Bespreek je capaciteit &rarr;</Button>
        <p class="vb-prijs-note">Geen cv voor een stoel, maar capaciteit rond het werk dat gedaan moet worden.</p>
      </div>
    </div>
  </section>

  <!-- 7 · FAQ + TIM (navy) -->
  <section class="faq-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:72px;padding-bottom:72px">
      <div class="vb-end">
        <div>
          <div class="lbl" style="margin-bottom:26px">Veelgestelde vragen</div>
          {faq.map((f) => (
            <details class="fin-faq">
              <summary><span class="fin-faq-q">{f.q}</span><span class="fin-faq-ic"></span></summary>
              <div class="fin-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
        <div class="vb-tim">
          <div class="lbl" style="margin-bottom:20px">Persoonlijk kennismaken</div>
          <div class="vb-tim-row">
            <div class="vb-tim-img"><img src="/images/tim-samsom.webp" alt="Tim Samsom, oprichter van Finable" width="800" height="699" loading="lazy" /></div>
            <div>
              <h2 style="font-size:clamp(21px,2.2vw,28px);line-height:1.12;margin-bottom:12px;color:var(--white)">Benieuwd hoe dit voor jouw kantoor zou werken?</h2>
              <p style="font-size:15px;color:var(--on-dark-secondary);text-wrap:pretty">Plan 30 minuten met Tim. We kijken naar het werk dat nu bij jou en je team ligt, wat je zou kunnen overdragen en welke vorm van capaciteit daarbij past.</p>
            </div>
          </div>
          <div class="vb-tim-cta">
            <Button href="/gesprek">Plan een kennismaking &rarr;</Button>
            <div class="vb-tim-name"><span>Tim Samsom</span><br>Oprichter Finable</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  a{transition:opacity .15s}
  a:hover{opacity:.72}

  /* --- Hero --- */
  .vb-hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:32px}
  .vb-hero-alt{font-weight:600;font-size:16px;color:var(--white)}
  .vb-hero-alt:hover{color:var(--terracotta);opacity:1}
  .vb-trust{display:flex;flex-wrap:wrap;gap:12px 32px;margin-top:30px}
  .vb-trust>div{display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(255,255,255,.82)}
  .vb-trust>div>span{width:6px;height:6px;border-radius:999px;background:var(--terracotta);flex-shrink:0}

  /* --- Herkenning --- */
  .vb-rec{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vb-reccard{background:var(--section);border:1px solid var(--line);border-radius:12px;padding:26px 26px;transition:border-color .15s}
  .vb-reccard:hover{border-color:rgba(196,100,58,0.45)}
  .vb-recn{font-family:'Playfair Display',serif;font-size:15px;color:var(--terracotta);margin-bottom:12px}
  .vb-reccard h3{font-size:18px;margin-bottom:8px}
  .vb-reccard p{font-size:14px;color:var(--body);line-height:1.6;text-wrap:pretty}

  /* --- Marktontwikkeling: dezelfde processtrip als elders, op licht --- */
  .vb-mkt{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:20px;align-items:center;max-width:880px;margin-bottom:24px}
  .vb-mkt-n{font-family:'Playfair Display',serif;font-weight:600;font-size:clamp(16px,1.7vw,20px);color:var(--navy);line-height:1.25;text-wrap:balance}
  .vb-mkt-a{align-self:center}
  .vb-src{font-size:13px;color:var(--body);line-height:1.6}
  .vb-src a{font-weight:600}

  /* --- Capabilities: rustige kolommen op navy, terracotta onderlijn per categorie --- */
  .vb-caps{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,3vw,44px)}
  .vb-cap-h{color:var(--white);margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid var(--terracotta);font-family:'Inter',system-ui,sans-serif}
  .vb-cap ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:9px}
  .vb-cap li{font-size:15px;color:var(--on-dark-secondary);line-height:1.5;text-wrap:pretty}

  /* --- Jij bepaalt waar de grens ligt: subtiele panels, geen witte kaarten --- */
  .vb-grens-h{font-size:21px;color:var(--warm-white);margin-top:48px;margin-bottom:22px}
  .vb-grens{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vb-grenscard{background:rgba(255,255,255,0.06);border:1px solid var(--on-dark-line);border-radius:10px;padding:22px 24px}
  .vb-grenst{font-weight:600;color:var(--white);margin-bottom:6px;text-wrap:pretty}
  .vb-grensd{font-size:14px;color:var(--on-dark-secondary)}

  /* --- Waar je op kunt rekenen: haarlijnen, geen kaarten --- */
  .vb-rely{display:grid;grid-template-columns:repeat(4,1fr)}
  .vb-rely>div{border-top:1px solid var(--line);padding:16px 26px 0 26px}
  .vb-rely>div:first-child{padding-left:0}
  .vb-rely>div:last-child{padding-right:0}
  .vb-rely-k{color:var(--navy);margin-bottom:10px}
  .vb-rely p{font-size:14px;color:var(--body);line-height:1.6;text-wrap:pretty}
  .vb-rely-end{font-size:15px;color:var(--body);margin-top:28px;text-wrap:pretty}
  .vb-rely-end strong{color:var(--navy);font-weight:600}

  /* --- Samenwerken --- */
  .vb-vormen{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:52px}
  .vb-vorm{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:28px 26px}
  .vb-vorm h3{font-size:19px;margin-bottom:8px;text-wrap:balance}
  .vb-vorm p{font-size:15px;color:var(--body);line-height:1.6;text-wrap:pretty}
  .vb-prijs{max-width:680px}
  .vb-prijs h3{font-size:21px;margin-bottom:12px}
  .vb-prijs>p{font-size:16px;color:var(--body);line-height:1.7;margin-bottom:24px;text-wrap:pretty}
  .vb-prijs-note{font-size:14px;color:var(--body);margin-top:18px;font-style:italic}

  /* --- FAQ-accordeon: hetzelfde patroon als /aanpak en /finance-hire --- */
  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:30px;padding:24px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(17px,1.7vw,20px);color:var(--navy);line-height:1.35;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:17px;height:17px;flex-shrink:0;margin-top:6px}
  .fin-faq-ic::before,.fin-faq-ic::after{content:"";position:absolute;background:var(--terracotta);transition:opacity .2s}
  .fin-faq-ic::before{left:0;top:7.5px;width:17px;height:2px}
  .fin-faq-ic::after{left:7.5px;top:0;width:2px;height:17px}
  details.fin-faq[open] .fin-faq-ic::after{opacity:0}
  details.fin-faq>summary:hover .fin-faq-q{color:var(--terracotta)}
  .fin-faq-a{max-width:760px;padding:0 0 28px;font-size:15.5px;color:var(--body);line-height:1.72}

  /* --- FAQ + Tim --- */
  .vb-end{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,0.9fr);gap:clamp(40px,5vw,72px);align-items:start}
  .vb-tim{border-left:1px solid var(--on-dark-line);padding-left:clamp(28px,3vw,48px)}
  .vb-tim-row{display:grid;grid-template-columns:clamp(120px,14vw,150px) minmax(0,1fr);gap:24px;align-items:center;margin-bottom:24px}
  .vb-tim-img{aspect-ratio:1/1;border-radius:12px;overflow:hidden}
  .vb-tim-img img{width:100%;height:100%;object-fit:cover;display:block}
  .vb-tim-cta{display:flex;flex-wrap:wrap;align-items:center;gap:20px}
  .vb-tim-name{font-size:14px;color:var(--on-dark-secondary);line-height:1.45}
  .vb-tim-name span{font-family:'Playfair Display',serif;font-weight:600;color:var(--white)}

  @media (max-width:1023px){
    .vb-rec{grid-template-columns:repeat(2,1fr)}
    .vb-caps{grid-template-columns:1fr;gap:32px}
    .vb-grens{grid-template-columns:1fr}
    .vb-rely{grid-template-columns:repeat(2,1fr)}
    .vb-rely>div{padding-left:0;padding-right:26px}
    .vb-vormen{grid-template-columns:1fr;gap:18px}
    .vb-mkt{grid-template-columns:1fr;gap:14px}
    .vb-mkt-a{transform:rotate(90deg);justify-self:start}
    .vb-end{grid-template-columns:1fr;gap:44px}
    .vb-tim{border-left:none;padding-left:0;border-top:1px solid var(--on-dark-line);padding-top:40px}
  }
  @media (max-width:767px){
