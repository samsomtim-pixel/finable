---
// Doelgroeppagina voor boekhouders en administratiekantoren. Tweede route naar de markt, naast de
// primaire propositie op de homepage. Staat bewust op noindex zolang de propositie wordt gevalideerd.
//
// Alles staat op de bestaande shell en het bestaande designsysteem: Layout, Header, Footer, Button,
// tokens. Hergebruikte patronen van andere pagina's, met hun eigen klassenamen:
//   .hero-navy / .lbl / .em        — heropatroon van alle navy hero's
//   .disc / .disc-row / .dn / .dd  — disciplinelijst uit de hero van /aanpak (vervangt de
//                                    skeleton-kaart uit het prototype; die leest als een SaaS-mockup)
//   .cmp-col / .ch / .cr + .cmp-m  — het Finable-vergelijkingspatroon van /aanpak en /finance-hire,
//                                    inclusief de mobiele variant per onderwerp
//   .cyc / .cn / .cd / .ca         — compacte processtrip van /hoe-het-werkt
//
// Capabilities: alleen werkzaamheden die de bestaande site al benoemt. Wat daar niet staat, is niet
// toegevoegd; zie het eindrapport onder "inhoudelijk te valideren".
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

/** Hero-disciplines: dezelfde vier lagen als op /aanpak, zodat de belofte aansluit op de rest van de site. */
const disciplines = [
  { n: 'Dagelijkse finance', d: 'Verwerking & administratie' },
  { n: 'Maandafsluiting', d: 'Afsluiting & controle' },
  { n: 'Controlling', d: 'Analyse & afwijkingen' },
  { n: 'Rapportage & inzicht', d: 'Rapportage & duiding' },
];

const herkenning = [
  { n: '01', t: 'Je klantenbestand groeit', d: 'Meer werk komt binnen dan je huidige team kan verwerken.' },
  { n: '02', t: 'Piekdrukte of achterstand', d: 'Tijdelijk extra capaciteit om werk weer onder controle te krijgen.' },
  { n: '03', t: 'Een vacature blijft open', d: 'Het werk hoeft niet te wachten tot de juiste medewerker gevonden is.' },
  { n: '04', t: 'Terugkerend werk kost tijd', d: 'Voeg capaciteit toe voor werkzaamheden die iedere week of maand terugkomen.' },
  { n: '05', t: 'Een klant vraagt meer', d: 'Extra ondersteuning wanneer een klant aanvullende financewerkzaamheden nodig heeft.' },
  { n: '06', t: 'Je wilt doorgroeien', d: 'Meer werk aankunnen zonder iedere groei direct met een nieuwe hire op te lossen.' },
];

/** De zes capabilities. De werkzaamheden per capability komen uit bestaande Finable-content. */
const capabilities = [
  { t: 'Administratie', items: ['Facturen', 'Bankverwerking', 'Debiteuren'] },
  { t: 'Maandafsluiting', items: ['Aansluitingen', 'Btw', 'Maanddossier'] },
  { t: 'Managementrapportages', items: ['Periodieke rapportages', 'Duiding bij de cijfers', 'Managementinformatie'] },
  { t: 'Control & analyse', items: ['Controles in het proces', 'Afwijkingsanalyses', 'Marge en cashflow'] },
  { t: 'Procesverbetering & automatisering', items: ['Financeprocessen structureren', 'Werk standaardiseren', 'Automatisering waar passend'] },
  { t: 'Debiteuren & crediteuren', items: ['Openstaande posten', 'Betalingen', 'Aansluitingen'] },
];

const vergelijking = [
  { vast: 'Eerst werven en selecteren', fin: 'Capaciteit toevoegen waar nodig' },
  { vast: 'Vaste capaciteit', fin: 'Flexibeler op- en afschalen' },
  { vast: 'Eén nieuw profiel', fin: 'Verschillende financewerkzaamheden' },
  { vast: 'Inwerken voordat capaciteit volledig beschikbaar is', fin: 'Start vanuit een afgesproken scope' },
];

const routes = [
  {
    nr: 'Route 1',
    t: 'Achter jouw dienstverlening',
    d: 'Finable voegt extra capaciteit toe voor afgesproken werkzaamheden, terwijl jouw kantoor de bestaande klantrelatie en dienstverlening voert.',
  },
  {
    nr: 'Route 2',
    t: 'Aanvullend voor jouw klant',
    d: 'Wanneer een klant aanvullende financeondersteuning nodig heeft, kan Finable die werkzaamheden rechtstreeks met de klant oppakken.',
  },
];

const proces = [
  { n: '01', t: 'Kennismaken', d: 'We bespreken je kantoor, klanten en waar capaciteit ontbreekt.' },
  { n: '02', t: 'Behoefte bepalen', d: 'We bepalen samen welke werkzaamheden en capaciteit passend zijn.' },
  { n: '03', t: 'Inrichten', d: 'Duidelijke afspraken over werkzaamheden, verantwoordelijkheden en communicatie.' },
  { n: '04', t: 'Aan de slag', d: 'We starten klein en kunnen uitbreiden wanneer daar behoefte aan is.' },
];

const arrow = 'M0 9h24M18 2l8 7-8 7';
---
<Layout
  title="Finable voor boekhouders | Flexibele financecapaciteit"
  description="Meer klanten bedienen zonder je team even hard te laten groeien. Finable biedt boekhouders en administratiekantoren flexibele financecapaciteit."
  noindex={true}
  hreflang={false}
>
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) — 55/45: copy links, disciplinelijst rechts -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:68px">
    <div class="vb-hero" style="display:grid;grid-template-columns:minmax(0,1.22fr) minmax(0,1fr);gap:clamp(36px,4.6vw,68px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:22px">Voor boekhouders &amp; administratiekantoren</div>
        <h1 style="font-size:clamp(34px,4.6vw,58px);line-height:1.05;margin-bottom:24px">Meer klanten bedienen. <span class="em">Zonder je team even hard te laten groeien.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:var(--on-dark-secondary);max-width:540px;text-wrap:pretty">Finable geeft boekhouders en administratiekantoren extra financecapaciteit voor dagelijks werk, piekdrukte en groei.</p>
        <div style="margin-top:32px"><Button href="/gesprek">Bespreek een samenwerking &rarr;</Button></div>
        <div class="vb-trust" style="display:flex;flex-wrap:wrap;gap:14px 32px;margin-top:34px">
          <div><span></span>Nederlandse regie</div>
          <div><span></span>Betrouwbare levering</div>
          <div><span></span>Flexibel schaalbaar</div>
        </div>
      </div>
      <!-- Waar de extra capaciteit over gaat. Zelfde disciplinelijst als de hero van /aanpak: dunne
           lijn, typografie, geen mockup. -->
      <div class="vb-hero-vis">
        <div class="disc">
          {disciplines.map((x, i) => (
            <div class="disc-row">
              <span aria-hidden="true">
                {i === 0 && <svg width="24" height="24" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.5"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg>}
                {i === 1 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9h16M8 3v4M16 3v4M8 14h4"/></svg>}
                {i === 2 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></svg>}
                {i === 3 && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg>}
              </span>
              <div><div class="dn">{x.n}</div><div class="dd">{x.d}</div></div>
            </div>
          ))}
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- HERKENNING (wit) -->
  <section class="wrap" style="padding-top:76px;padding-bottom:72px">
    <div style="max-width:720px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">Herken je dit?</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:18px;text-wrap:balance">Extra capaciteit, precies waar je die nodig hebt.</h2>
      <p style="font-size:17px;color:var(--body);line-height:1.7;text-wrap:pretty">Soms vraagt het werk meer dan het team op dat moment aankan. Finable vult aan waar dat helpt, structureel of tijdelijk, zodat je kantoor door kan blijven leveren.</p>
    </div>
    <div class="vb-rec">
      {herkenning.map((x) => (
        <div class="vb-reccard">
          <div class="vb-recn">{x.n}</div>
          <h3>{x.t}</h3>
          <p>{x.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CAPABILITIES (navy) — het inhoudelijke zwaartepunt van de pagina -->
  <section style="background:var(--navy)">
    <div class="wrap" style="padding-top:84px;padding-bottom:88px">
      <div class="vb-caphead">
        <div>
          <div class="lbl" style="margin-bottom:18px">Wat wij kunnen betekenen</div>
          <h2 style="font-size:clamp(28px,3.6vw,44px);color:var(--warm-white);text-wrap:balance">Hier kan Finable je team ondersteunen.</h2>
        </div>
        <p style="font-size:16px;color:var(--on-dark-secondary);line-height:1.7;text-wrap:pretty">We ondersteunen boekhouders en administratiekantoren met financewerk dat zich leent voor een flexibele opzet: van dagelijks terugkerend werk tot rapportage en analyse.</p>
      </div>
      <!-- Haarlijnraster: één pixel scheiding, geen kaarten met randen en schaduw. -->
      <div class="vb-caps">
        {capabilities.map((c) => (
          <div class="vb-cap">
            <h3>{c.t}</h3>
            <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GROEI / VERGELIJKING (wit) -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div class="vb-grow">
      <div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);margin-bottom:18px;text-wrap:balance">Laat capaciteit niet je groeiplafond worden.</h2>
        <p style="font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty">Zo hoeft groei niet automatisch te beginnen met een nieuwe vacature.</p>
      </div>
      <div>
        <!-- Mobiel (≤639): per onderwerp onder elkaar, zoals op /aanpak en /finance-hire. -->
        <div class="cmp-m">
          {vergelijking.map((r) => (
            <div class="cmp-m-pair">
              <div class="cmp-m-row"><span class="cmp-m-k">Vaste uitbreiding</span><span class="cmp-m-v">{r.vast}</span></div>
              <div class="cmp-m-row is-fin"><span class="cmp-m-k">Finable-capaciteit</span><span class="cmp-m-v">{r.fin}</span></div>
            </div>
          ))}
        </div>
        <div class="vb-cmp">
          <div class="cmp-col">
            <div class="ch" style="color:var(--body)">Vaste uitbreiding</div>
            {vergelijking.map((r) => <div class="cr" style="color:var(--body)">{r.vast}</div>)}
          </div>
          <div class="cmp-col">
            <div class="ch" style="color:var(--terracotta)">Finable-capaciteit</div>
            {vergelijking.map((r) => <div class="cr" style="color:var(--navy)">{r.fin}</div>)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SAMENWERKING (warm) -->
  <section style="background:var(--terracotta-tint)">
    <div class="wrap" style="padding-top:76px;padding-bottom:80px">
      <div style="max-width:720px;margin-bottom:40px">
        <div class="lbl" style="margin-bottom:18px">Samenwerking</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);text-wrap:balance">Een samenwerking die past bij jouw kantoor.</h2>
      </div>
      <div class="vb-routes">
        {routes.map((r) => (
          <div class="vb-route">
            <div class="lbl" style="margin-bottom:12px">{r.nr}</div>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </div>
        ))}
      </div>
      <div class="vb-rel">
        <h3>Jouw klantrelatie blijft van jou.</h3>
        <p>We spreken vooraf duidelijk af wie welke werkzaamheden uitvoert, wie contact heeft met de klant en hoe Finable binnen de samenwerking opereert.</p>
      </div>
    </div>
  </section>

  <!-- PROCES (wit, ondersteunend) -->
  <section class="wrap" style="padding-top:64px;padding-bottom:64px">
    <div class="rule" style="margin-bottom:44px"></div>
    <div class="vb-prochead">
      <div class="lbl">Hoe het kan werken</div>
      <h2 style="font-size:clamp(20px,2vw,25px)">Van kennismaken tot aan de slag.</h2>
    </div>
    <div class="vb-proc">
      {proces.map((p, i) => (
        <>
          <div>
            <div class="vb-procn">{p.n}</div>
            <div class="vb-proct">{p.t}</div>
            <p>{p.d}</p>
          </div>
          {i < proces.length - 1 && (
            <svg class="vb-proca" width="24" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d={arrow}/></svg>
          )}
        </>
      ))}
    </div>
  </section>

  <!-- FINALE CTA (warm) -->
  <section style="background:var(--terracotta-tint)">
    <div class="wrap" style="padding-top:84px;padding-bottom:88px">
      <div class="vb-cta">
        <div class="lbl" style="margin-bottom:18px">Benieuwd waar Finable kan helpen?</div>
        <h2 style="font-size:clamp(28px,3.8vw,46px);margin-bottom:18px;text-wrap:balance">Ontdek wat Finable voor jouw kantoor kan betekenen.</h2>
        <p style="font-size:17px;color:var(--body);line-height:1.7;margin-bottom:32px;text-wrap:pretty">Vertel waar je nu tegenaan loopt. We kijken samen waar extra financecapaciteit waarde kan toevoegen.</p>
        <Button href="/gesprek">Plan een gesprek &rarr;</Button>
      </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  a{transition:opacity .15s}
  a:hover{opacity:.72}

  /* --- Hero --- */
  .vb-trust>div{display:flex;align-items:center;gap:10px;font-size:14px;color:rgba(255,255,255,.82)}
  .vb-trust>div>span{width:6px;height:6px;border-radius:999px;background:var(--terracotta);flex-shrink:0}
  /* Disciplinelijst: exact het patroon uit de hero van /aanpak. */
  .disc{border-left:1px solid var(--on-dark-line);padding-left:clamp(20px,2.4vw,36px);display:flex;flex-direction:column;gap:clamp(18px,2vw,26px)}
  .disc-row{display:flex;gap:16px;align-items:flex-start}
  .disc-row>span:first-child{line-height:0;flex-shrink:0;margin-top:2px}
  .disc .dn{font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--white)}
  .disc .dd{font-size:14px;color:var(--on-dark-secondary)}

  /* --- Herkenning --- */
  .vb-rec{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .vb-reccard{background:var(--section);border:1px solid var(--line);border-radius:12px;padding:26px 26px;transition:border-color .15s}
  .vb-reccard:hover{border-color:rgba(196,100,58,0.45)}
  .vb-recn{font-family:'Playfair Display',serif;font-size:15px;color:var(--terracotta);margin-bottom:12px}
  .vb-reccard h3{font-size:18px;margin-bottom:8px}
  .vb-reccard p{font-size:14px;color:var(--body);line-height:1.6;text-wrap:pretty}

  /* --- Capabilities --- */
  .vb-caphead{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,3vw,56px);align-items:end;margin-bottom:48px}
  /* Eén pixel scheiding tussen de tegels: dunne lijnen in plaats van losse kaarten. */
  .vb-caps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--on-dark-line)}
  /* Subtiel lichter dan de navy achtergrond, zonder een kleur toe te voegen die niet in het systeem staat. */
  .vb-cap{background:rgba(255,255,255,0.04);padding:30px 28px}
  .vb-cap h3{font-size:19px;color:var(--white);margin-bottom:14px;text-wrap:balance}
  .vb-cap ul{list-style:none;margin:0;padding:0}
  .vb-cap li{font-size:14px;color:var(--on-dark-secondary);line-height:1.5;padding-left:16px;position:relative;margin-bottom:6px}
  .vb-cap li:last-child{margin-bottom:0}
  .vb-cap li::before{content:"";position:absolute;left:0;top:8px;width:5px;height:5px;border-radius:999px;background:var(--terracotta)}

  /* --- Vergelijking --- */
  .vb-grow{display:grid;grid-template-columns:minmax(0,0.85fr) minmax(0,1.15fr);gap:clamp(36px,4.4vw,72px);align-items:start}
  .vb-cmp{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3vw,44px)}
  .cmp-col .ch{font-size:12px;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:6px}
  .cmp-col .cr{padding:14px 0;border-top:1px solid var(--line);font-size:15px;line-height:1.45}
  .cmp-m{display:none}
  .cmp-m-pair{border-top:1px solid var(--line);padding:14px 0}
  .cmp-m-row{display:flex;justify-content:space-between;gap:16px;font-size:15px;line-height:1.45;color:var(--body)}
  .cmp-m-row+.cmp-m-row{margin-top:6px}
  .cmp-m-k{font-size:12px;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--body);flex-shrink:0;padding-top:2px}
  .cmp-m-row.is-fin .cmp-m-k{color:var(--terracotta)}
  .cmp-m-row.is-fin .cmp-m-v{color:var(--navy)}
  .cmp-m-v{text-align:right;text-wrap:pretty}

  /* --- Samenwerking --- */
  .vb-routes{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .vb-route{background:var(--white);border:1px solid var(--line);border-radius:14px;padding:32px 32px}
  .vb-route h3{font-size:22px;margin-bottom:12px;text-wrap:balance}
  .vb-route p{font-size:15px;color:var(--body);line-height:1.65;text-wrap:pretty}
  .vb-rel{margin-top:22px;background:var(--white);border:1px solid var(--line);border-left:3px solid var(--terracotta);border-radius:12px;padding:clamp(26px,2.6vw,34px) clamp(26px,3vw,38px)}
  .vb-rel h3{font-size:20px;margin-bottom:10px}
  .vb-rel p{font-size:15px;color:var(--body);line-height:1.65;max-width:720px;text-wrap:pretty}

  /* --- Proces: bewust rustiger dan de rest --- */
  .vb-prochead{display:flex;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:32px}
  .vb-proc{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:18px;align-items:start}
  .vb-procn{font-family:'Playfair Display',serif;font-size:14px;color:var(--terracotta);margin-bottom:6px}
  .vb-proct{font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--navy);margin-bottom:6px}
  .vb-proc p{font-size:13.5px;color:var(--body);line-height:1.55;text-wrap:pretty}
  .vb-proca{align-self:center;margin-top:10px}

  /* --- Finale CTA --- */
  .vb-cta{max-width:720px;margin:0 auto;text-align:center}
  .vb-cta p{margin-left:auto;margin-right:auto;max-width:560px}

  @media (max-width:1023px){
    .vb-hero{grid-template-columns:1fr!important;gap:38px!important}
    .vb-caphead{grid-template-columns:1fr;gap:20px;align-items:start}
    .vb-grow{grid-template-columns:1fr;gap:32px}
    .vb-caps{grid-template-columns:repeat(2,1fr)}
    .vb-rec{grid-template-columns:repeat(2,1fr)}
    .vb-proc{grid-template-columns:1fr 1fr;gap:26px 24px}
    .vb-proca{display:none}
  }
  @media (max-width:767px){
    .vb-rec{grid-template-columns:1fr}
    .vb-caps{grid-template-columns:1fr}
    .vb-routes{grid-template-columns:1fr;gap:18px}
    .vb-proc{grid-template-columns:1fr;gap:22px}
  }
  @media (max-width:639px){
    /* Vergelijking per onderwerp, zoals elders op de site. */
    .vb-cmp{display:none}
    .cmp-m{display:block}
    .disc{border-left:none;padding-left:0}
  }
</style>
