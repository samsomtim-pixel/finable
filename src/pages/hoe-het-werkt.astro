<script>
  // "Bekijk alle veelgestelde vragen": toont de verborgen vragen.
  const btn = document.querySelector<HTMLAnchorElement>('[data-faq-more]');
  const hidden = document.querySelector<HTMLElement>('[data-faq-hidden]');
  const wrap = document.querySelector<HTMLElement>('[data-faq-morewrap]');
