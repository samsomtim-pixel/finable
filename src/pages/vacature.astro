---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base
  title="Voor een openstaande finance-vacature — Finable"
  description="Een volledige finance-plaats, samengesteld uit een team, in plaats van een persoon die alles moet kunnen."
  noindex={true}
>
  <!-- Hero -->
  <section class="vac-hero">
    <div class="container">
      <p class="eyebrow">Voor een openstaande finance-vacature</p>
      <h1>Je dacht dat je een persoon nodig had. <em>Misschien heb je een finance-functie nodig.</em></h1>
      <p class="vac-sub">Dezelfde finance-functie, ingevuld door een team in plaats van een persoon die alles moet kunnen.</p>
      <div class="vac-hero-actions">
        <a href="/gesprek" class="btn btn-primary">Plan een gesprek →</a>
        <p class="vac-hero-helper">Vrijblijvend en in 30 minuten.</p>
      </div>

      <!-- Comparison cards -->
      <div class="vac-comparison">
        <div class="vac-comp-card">
          <h3>De vacature</h3>
          <p class="vac-comp-subtitle">een persoon</p>
          <ul>
            <li>Dagelijkse finance</li>
            <li>Maandafsluiting</li>
            <li>Controlling</li>
            <li>Rapportage</li>
            <li>Meedenken</li>
          </ul>
          <p class="vac-comp-footer">Alles in een functie</p>
        </div>
        <div class="vac-comp-arrow" aria-hidden="true">
          <svg width="40" height="24" viewBox="0 0 40 24" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 12h36m0 0l-6-6m6 6l-6 6"/></svg>
        </div>
        <div class="vac-comp-card vac-comp-card--highlight">
          <h3>Dezelfde functie, anders ingevuld</h3>
          <p class="vac-comp-subtitle">een Finable team</p>
          <ul>
            <li>Uitvoeren</li>
            <li>Afsluiten &amp; controleren</li>
            <li>Rapporteren</li>
            <li>Bespreken</li>
          </ul>
          <p class="vac-comp-footer">Ieder doet waar hij goed in is</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 -->
  <section class="tint">
    <div class="container vac-section-grid">
      <div class="vac-section-left">
        <p class="section-number">01</p>
        <h2>Je zoekt eigenlijk meer dan een profiel.</h2>
        <p>De dagelijkse finance, een strakke maandafsluiting, controlling en managementrapportage vragen niet allemaal om dezelfde expertise. Toch proberen veel bedrijven die verantwoordelijkheden in een vacature te combineren.</p>
        <p><strong>Finable vult die functie anders in: als team.</strong></p>
      </div>
      <div class="vac-section-right">
        <div class="vac-expertise-list">
          <div class="vac-expertise">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
            <div>
              <strong>Dagelijkse finance</strong>
              <span>Volume en nauwkeurigheid</span>
            </div>
          </div>
          <div class="vac-expertise">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            <div>
              <strong>Maandafsluiting</strong>
              <span>Zorgvuldigheid en controle</span>
            </div>
          </div>
          <div class="vac-expertise">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 21H4.6c-.56 0-.84 0-1.054-.109a1 1 0 0 1-.437-.437C3 20.24 3 19.96 3 19.4V3"/><path d="m7 14 4-4 4 4 6-6"/></svg>
            <div>
              <strong>Controlling</strong>
              <span>Analyse en inzicht</span>
            </div>
          </div>
          <div class="vac-expertise">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            <div>
              <strong>Managementrapportage</strong>
              <span>Duiding en gesprek</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 -->
  <section>
    <div class="container">
      <p class="section-number">02</p>
      <h2>Een finance-functie als team.</h2>
      <p class="vac-intro">Geen een persoon, maar een verdeling van expertises. Ervaren specialisten op de controle, capaciteit op de dagelijkse verwerking, en een vast aanspreekpunt voor jou.</p>
      <div class="vac-process">
        <div class="vac-process-step">
          <strong>Uitvoeren</strong>
          <span>Dagelijkse finance</span>
        </div>
        <div class="vac-process-arrow" aria-hidden="true">→</div>
        <div class="vac-process-step">
          <strong>Afsluiten &amp; controleren</strong>
          <span>Maandafsluiting en btw</span>
        </div>
        <div class="vac-process-arrow" aria-hidden="true">→</div>
        <div class="vac-process-step">
          <strong>Rapporteren</strong>
          <span>Managementinformatie</span>
        </div>
        <div class="vac-process-arrow" aria-hidden="true">→</div>
        <div class="vac-process-step">
          <strong>Bespreken</strong>
          <span>Vast aanspreekpunt</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 -->
  <section class="tint">
    <div class="container">
      <p class="section-number">03</p>
      <h2>Wat je wint.</h2>
      <p class="vac-intro">Dezelfde functie, meer slagkracht.</p>
      <div class="vac-benefits">
        <div class="vac-benefit">
          <h3>Capaciteit</h3>
          <p>Werk op het juiste niveau, zonder wervingskosten.</p>
        </div>
        <div class="vac-benefit">
          <h3>Continuïteit</h3>
          <p>Kennis en uitvoering hangen niet aan een persoon.</p>
        </div>
        <div class="vac-benefit">
          <h3>Flexibiliteit</h3>
          <p>De scope kan meegroeien met je organisatie.</p>
        </div>
        <div class="vac-benefit">
          <h3>Kwaliteit</h3>
          <p>Controle en review zijn onderdeel van het werkproces.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 -->
  <section>
    <div class="container vac-section-grid">
      <div class="vac-section-left">
        <p class="section-number">04</p>
        <h2>Een heel finance-team. Voor minder dan een controller.</h2>
        <p>Wat Finable kost hangt af van de structuur, het volume en de scope van het werk — niet van je omzet.</p>
        <a href="/indicatie" class="btn btn-primary" style="margin-top: 24px;">Vraag een indicatie aan →</a>
      </div>
      <div class="vac-section-right">
        <div class="vac-visual" role="img" aria-label="Vergelijking vacature versus finance-functie">
          <div class="vac-visual-top">
            <strong>1 vacature</strong>
            <span>een profiel · een capaciteit · een persoon</span>
          </div>
          <div class="vac-visual-arrow" aria-hidden="true">↓</div>
          <div class="vac-visual-bottom">
            <strong>1 finance-functie</strong>
            <span>meerdere expertises · capaciteit naar behoefte · een vast team</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 05 -->
  <section class="tint">
    <div class="container">
      <p class="section-number">05</p>
      <h2>Wanneer dit niet bij je past.</h2>
      <p class="vac-intro" style="max-width: 640px;">Finable is geen goede fit als je op zoek bent naar een junior medewerker voor alleen de dagelijkse verwerking, of als je finance volledig in-house wilt opbouwen.</p>
      <div class="vac-callout">
        <h3>Twijfel je of dit past?</h3>
        <p>Laten we het kort bespreken. In 30 minuten heb je duidelijkheid.</p>
        <a href="/gesprek" class="text-link">Plan een gesprek →</a>
      </div>
    </div>
  </section>

  <!-- Minimal footer for campaign page -->
  <footer class="vac-footer">
    <div class="container vac-footer-inner">
      <Logo />
      <a href="/" class="text-link">← Terug naar de site</a>
    </div>
  </footer>
</Base>

<style>
  /* Hero */
  .vac-hero { padding: var(--space-xl) 0 var(--space-2xl); }
  .vac-hero h1 { max-width: 700px; margin-bottom: 16px; }
  .vac-hero em { font-style: italic; }
  .vac-sub { font-size: 1.125rem; max-width: 560px; margin-bottom: 24px; }
  .vac-hero-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 48px; }
  .vac-hero-helper { font-size: 0.875rem; color: var(--body-color); }

  /* Comparison */
  .vac-comparison {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }
  .vac-comp-card {
    padding: 28px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .vac-comp-card--highlight {
    background: #F7E8DE;
    border-color: #E9C9B5;
  }
  .vac-comp-card h3 { font-size: 1.125rem; margin-bottom: 4px; }
  .vac-comp-subtitle { font-size: 0.8125rem; color: var(--body-color); margin-bottom: 16px; }
  .vac-comp-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }
  .vac-comp-card li {
    font-size: 0.9375rem;
    padding-left: 20px;
    position: relative;
  }
  .vac-comp-card li::before {
    content: '·';
    position: absolute;
    left: 4px;
    color: var(--terracotta);
    font-weight: 700;
  }
  .vac-comp-footer {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--body-color);
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .vac-comp-arrow { display: flex; align-items: center; }

  /* Section grid */
  .vac-section-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: start;
  }
  .vac-intro { font-size: 1.0625rem; max-width: 560px; margin: 8px 0 32px; }

  /* Expertise list */
  .vac-expertise-list { display: flex; flex-direction: column; gap: 20px; }
  .vac-expertise {
    display: flex;
    gap: 16px;
    align-items: start;
    padding: 20px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  .vac-expertise svg { flex-shrink: 0; color: var(--terracotta); margin-top: 2px; }
  .vac-expertise strong { color: var(--navy); font-size: 0.9375rem; display: block; }
  .vac-expertise span { font-size: 0.8125rem; }

  /* Process */
  .vac-process {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 12px;
    align-items: center;
  }
  .vac-process-step {
    padding: 24px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .vac-process-step strong { color: var(--navy); font-size: 0.9375rem; display: block; }
  .vac-process-step span { font-size: 0.8125rem; }
  .vac-process-arrow { color: var(--body-color); font-size: 1.25rem; }

  /* Benefits */
  .vac-benefits {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .vac-benefit {
    padding: 28px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .vac-benefit h3 { font-size: 1.125rem; margin-bottom: 8px; }
  .vac-benefit p { font-size: 0.9375rem; }

  /* Visual comparison */
  .vac-visual {
    padding: 32px;
    background: var(--section);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .vac-visual strong { color: var(--navy); font-size: 1.25rem; display: block; }
  .vac-visual span { font-size: 0.875rem; color: var(--body-color); }
  .vac-visual-arrow { font-size: 1.5rem; color: var(--terracotta); margin: 16px 0; }

  /* Callout */
  .vac-callout {
    margin-top: 24px;
    padding: 28px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    max-width: 480px;
  }
  .vac-callout h3 { font-size: 1.125rem; margin-bottom: 8px; }
  .vac-callout p { font-size: 0.9375rem; margin-bottom: 12px; }

  /* Footer */
  .vac-footer {
    border-top: 1px solid var(--line);
    padding: 32px 0;
  }
  .vac-footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .vac-comparison { grid-template-columns: 1fr; }
    .vac-comp-arrow { justify-content: center; transform: rotate(90deg); }
    .vac-section-grid { grid-template-columns: 1fr; }
    .vac-process { grid-template-columns: 1fr; }
    .vac-process-arrow { display: none; }
    .vac-benefits { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .vac-benefits { grid-template-columns: 1fr; }
  }
</style>
