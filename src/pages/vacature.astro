---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---
<Layout title="Voor een openstaande finance-vacature — Finable" description="Eén volledige finance-plaats, samengesteld uit een team, in plaats van één persoon die alles moet kunnen." noindex>
<div style="max-width:100%;overflow-x:hidden;background:#FAF9F7">
  <!-- NIET LIVE tot delivery, pricing en commitment definitief zijn afgestemd. -->

  <!-- HEADER (no nav) -->
  <header style="background:#FAF9F7">
    <nav class="wrap vac-nav" style="padding-top:26px;padding-bottom:26px;display:flex;align-items:center;justify-content:space-between;gap:24px">
      <span style="font-family:'Playfair Display',serif;font-weight:700;font-size:26px;color:#1F2933;letter-spacing:-0.02em">Finable<span style="color:var(--terracotta)">.</span></span>
      <Button href="/gesprek" size="sm" class="vac-btn">Plan een gesprek →</Button>
    </nav>
  </header>

  <!-- HERO -->
  <section class="wrap" style="padding-top:36px;padding-bottom:64px">
    <div class="vac-hero" style="display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:48px;align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:22px">Voor een openstaande finance-vacature</div>
        <h1 style="font-size:clamp(34px,4.6vw,54px);color:#1F2933;margin-bottom:22px;text-wrap:balance">Je dacht dat je één persoon nodig had. <span style="font-style:italic;color:#1F2933">Misschien heb je een finance-functie nodig.</span></h1>
        <p style="font-size:clamp(17px,2vw,20px);color:var(--body);max-width:500px;margin-bottom:32px;text-wrap:pretty">Dezelfde finance-functie, ingevuld door een team in plaats van één persoon die alles moet kunnen.</p>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 20px">
          <Button href="/gesprek" class="vac-btn">Plan een gesprek →</Button>
          <span style="font-size:14px;color:var(--body)">Vrijblijvend en in 30 minuten.</span>
        </div>
      </div>

      <!-- kernvergelijking -->
      <div class="fin-herocards">
        <div style="background:#F3EDE7;border:1px solid #E8E1D9;border-radius:12px;padding:26px 24px;display:flex;flex-direction:column;align-items:center;text-align:center">
          <h3 style="font-size:20px;color:#1F2933">De vacature</h3>
          <div class="fin-cap" style="margin-bottom:18px">één persoon</div>
          <div style="width:66px;height:66px;border-radius:999px;background:#FAF9F7;display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="30" height="30" viewBox="0 0 28 28" fill="none" stroke="#5F6B76" stroke-width="1.6"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg></div>
          <div style="width:100%;height:1px;background:#E2DACF;margin-bottom:16px"></div>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:15px;color:var(--body);margin-bottom:20px">
            <span>Dagelijkse finance</span><span>Maandafsluiting</span><span>Controlling</span><span>Rapportage</span><span>Meedenken</span>
          </div>
          <div style="width:100%;background:#E7E0D8;border-radius:10px;padding:10px;font-size:13px;font-weight:600;color:var(--body)">Alles in één functie</div>
        </div>
        <div class="fin-arrow" style="display:flex;justify-content:center"><svg width="28" height="16" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg></div>
        <div style="background:#F9EBE2;border:1px solid #EDD3C2;border-radius:12px;padding:26px 24px;display:flex;flex-direction:column;align-items:center;text-align:center">
          <h3 style="font-size:20px;color:#1F2933;text-wrap:balance">Dezelfde functie, anders ingevuld</h3>
          <div style="font-size:15px;color:var(--terracotta);margin-bottom:18px">een Finable team</div>
          <div style="width:66px;height:66px;border-radius:999px;background:#FAF9F7;display:flex;align-items:center;justify-content:center;margin-bottom:18px"><svg width="34" height="30" viewBox="0 0 40 34" fill="none" stroke="#C4643A" stroke-width="1.6"><circle cx="20" cy="10" r="5"/><circle cx="8" cy="13" r="4"/><circle cx="32" cy="13" r="4"/><path d="M10 28c0-5 4.5-8 10-8s10 3 10 8"/></svg></div>
          <div style="width:100%;height:1px;background:#EDD3C2;margin-bottom:16px"></div>
          <div style="display:flex;flex-direction:column;gap:8px;font-size:15px;color:#1F2933;margin-bottom:20px">
            <span>Uitvoeren</span><span>Afsluiten &amp; controleren</span><span>Rapporteren</span><span>Bespreken</span>
          </div>
          <div style="width:100%;background:var(--terracotta);border-radius:10px;padding:10px;font-size:13px;font-weight:600;color:var(--white)">Ieder doet waar hij goed in is</div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:#E6E1DB"></div></div>

  <!-- 01 -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div class="fin-sec">
      <div>
        <div style="width:40px;height:2px;background:var(--terracotta);margin-bottom:16px"></div>
        <div style="display:flex;align-items:baseline;gap:18px;margin-bottom:22px"><span class="fin-secnum">01</span><h2 style="font-size:clamp(24px,3vw,34px);color:#1F2933">Je zoekt eigenlijk meer dan één profiel.</h2></div>
        <p style="font-size:16px;color:var(--body);margin-bottom:16px">De dagelijkse finance, een strakke maandafsluiting, controlling en managementrapportage vragen niet allemaal om dezelfde expertise. Toch proberen veel bedrijven die verantwoordelijkheden in één vacature te combineren.</p>
        <p style="font-size:16px;color:#1F2933;font-weight:500">Finable vult die functie anders in: als team.</p>
      </div>
      <div style="background:#F3EDE7;border-radius:12px;padding:14px 30px">
        <div style="display:flex;align-items:center;gap:16px;padding:18px 0;border-bottom:1px solid #E6DFD6"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg><div><div style="font-weight:600;font-size:16px;color:#1F2933">Dagelijkse finance</div><div class="fin-cap">Volume en nauwkeurigheid</div></div></div>
        <div style="display:flex;align-items:center;gap:16px;padding:18px 0;border-bottom:1px solid #E6DFD6"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.6 3.1 3 7 3s7-1.4 7-3V6M5 12v6c0 1.6 3.1 3 7 3s7-1.4 7-3v-6"/></svg><div><div style="font-weight:600;font-size:16px;color:#1F2933">Maandafsluiting</div><div class="fin-cap">Zorgvuldigheid en controle</div></div></div>
        <div style="display:flex;align-items:center;gap:16px;padding:18px 0;border-bottom:1px solid #E6DFD6"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg><div><div style="font-weight:600;font-size:16px;color:#1F2933">Controlling</div><div class="fin-cap">Analyse en inzicht</div></div></div>
        <div style="display:flex;align-items:center;gap:16px;padding:18px 0"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><circle cx="12" cy="12" r="8"/><path d="M12 12V4M12 12l6 3"/></svg><div><div style="font-weight:600;font-size:16px;color:#1F2933">Managementrapportage</div><div class="fin-cap">Duiding en gesprek</div></div></div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:#E6E1DB"></div></div>

  <!-- 02 -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div class="fin-sec">
      <div>
        <div style="width:40px;height:2px;background:var(--terracotta);margin-bottom:16px"></div>
        <div style="display:flex;align-items:baseline;gap:18px;margin-bottom:22px"><span class="fin-secnum">02</span><h2 style="font-size:clamp(24px,3vw,34px);color:#1F2933">Een finance-functie als team.</h2></div>
        <p style="font-size:16px;color:var(--body)">Geen één persoon, maar een verdeling van expertises. Ervaren specialisten op de controle, capaciteit op de dagelijkse verwerking, en een vast aanspreekpunt voor jou.</p>
      </div>
      <div class="fin-4">
        <div style="background:var(--white);border:1px solid #EEE7DF;border-radius:12px;padding:22px 18px;text-align:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:12px"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:4px">Uitvoeren</div><div class="fin-cap" style="font-size:13px">Dagelijkse finance</div></div>
        <div class="fin-arrow" style="display:flex;align-items:center"><svg width="22" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg></div>
        <div style="background:var(--white);border:1px solid #EEE7DF;border-radius:12px;padding:22px 18px;text-align:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:12px"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:4px">Afsluiten &amp; controleren</div><div class="fin-cap" style="font-size:13px">Maandafsluiting en btw</div></div>
        <div class="fin-arrow" style="display:flex;align-items:center"><svg width="22" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg></div>
        <div style="background:var(--white);border:1px solid #EEE7DF;border-radius:12px;padding:22px 18px;text-align:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:12px"><circle cx="12" cy="12" r="8"/><path d="M12 12V4M12 12l6 3"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:4px">Rapporteren</div><div class="fin-cap" style="font-size:13px">Managementinformatie</div></div>
        <div class="fin-arrow" style="display:flex;align-items:center"><svg width="22" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg></div>
        <div style="background:var(--white);border:1px solid #EEE7DF;border-radius:12px;padding:22px 18px;text-align:center"><svg width="26" height="26" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:12px"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:4px">Bespreken</div><div class="fin-cap" style="font-size:13px">Vast aanspreekpunt</div></div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:#E6E1DB"></div></div>

  <!-- 03 -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div class="fin-sec">
      <div>
        <div style="width:40px;height:2px;background:var(--terracotta);margin-bottom:16px"></div>
        <div style="display:flex;align-items:baseline;gap:18px;margin-bottom:12px"><span class="fin-secnum">03</span><h2 style="font-size:clamp(24px,3vw,34px);color:#1F2933">Wat je wint.</h2></div>
        <p style="font-size:16px;color:var(--body)">Dezelfde functie, meer slagkracht.</p>
      </div>
      <div class="fin-win">
        <div style="background:#F3EDE7;border-radius:12px;padding:24px 20px;text-align:center"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:8px">Capaciteit</div><p class="fin-cap" style="font-size:14px">Werk op het juiste niveau, zonder wervingskosten.</p></div>
        <div style="background:#F3EDE7;border-radius:12px;padding:24px 20px;text-align:center"><svg width="28" height="28" viewBox="0 0 26 28" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px"><path d="M13 3l9 3v7c0 6-4 10-9 12C8 23 4 19 4 13V6z"/><path d="M9 13l3 3 5-6"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:8px">Continuïteit</div><p class="fin-cap" style="font-size:14px">Kennis en uitvoering hangen niet aan één persoon.</p></div>
        <div style="background:#F3EDE7;border-radius:12px;padding:24px 20px;text-align:center"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px"><path d="M4 16l6-6 4 4 6-8"/><path d="M20 6h-4M20 6v4"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:8px">Flexibiliteit</div><p class="fin-cap" style="font-size:14px">De scope kan meegroeien met je organisatie.</p></div>
        <div style="background:#F3EDE7;border-radius:12px;padding:24px 20px;text-align:center"><svg width="30" height="28" viewBox="0 0 40 34" fill="none" stroke="#C4643A" stroke-width="1.5" style="margin-bottom:14px"><circle cx="20" cy="10" r="5"/><circle cx="8" cy="13" r="4"/><circle cx="32" cy="13" r="4"/><path d="M10 28c0-5 4.5-8 10-8s10 3 10 8"/></svg><div style="font-weight:600;font-size:16px;color:#1F2933;margin-bottom:8px">Kwaliteit</div><p class="fin-cap" style="font-size:14px">Controle en review zijn onderdeel van het werkproces.</p></div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:#E6E1DB"></div></div>

  <!-- 04 -->
  <section class="wrap" style="padding-top:56px;padding-bottom:56px">
    <div class="fin-sec">
      <div>
        <div style="width:40px;height:2px;background:var(--terracotta);margin-bottom:16px"></div>
        <div style="display:flex;align-items:baseline;gap:18px;margin-bottom:22px"><span class="fin-secnum">04</span><h2 style="font-size:clamp(24px,3vw,34px);color:#1F2933">Een heel finance-team. Voor minder dan één controller.</h2></div>
        <p style="font-size:16px;color:var(--body);margin-bottom:28px">Wat Finable kost hangt af van de structuur, het volume en de scope van het werk — niet van je omzet.</p>
        <Button href="/indicatie" class="vac-btn">Vraag een indicatie aan →</Button>
      </div>
      <div role="img" aria-label="Vergelijking vacature versus finance-functie" style="background:#F3EDE7;border-radius:12px;padding:clamp(32px,4vw,48px);display:flex;flex-direction:column;align-items:center;text-align:center;gap:22px">
        <div>
          <div style="font-family:'Playfair Display',serif;font-size:clamp(26px,3.4vw,36px);color:#1F2933;line-height:1.1">1 vacature</div>
          <div class="fin-cap" style="margin-top:8px">één profiel · één capaciteit · één persoon</div>
        </div>
        <svg width="20" height="30" viewBox="0 0 20 30" fill="none" stroke="#C4643A" stroke-width="2"><path d="M10 0v26M2 18l8 8 8-8"/></svg>
        <div>
          <div style="font-family:'Playfair Display',serif;font-size:clamp(26px,3.4vw,36px);color:var(--terracotta);line-height:1.1">1 finance-functie</div>
          <div class="fin-cap" style="margin-top:8px;color:#1F2933">meerdere expertises · capaciteit naar behoefte · een vast team</div>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap"><div style="height:1px;background:#E6E1DB"></div></div>

  <!-- 05 -->
  <section class="wrap" style="padding-top:56px;padding-bottom:72px">
    <div class="fin-sec">
      <div>
        <div style="width:40px;height:2px;background:var(--terracotta);margin-bottom:16px"></div>
        <div style="display:flex;align-items:baseline;gap:18px;margin-bottom:22px"><span class="fin-secnum">05</span><h2 style="font-size:clamp(24px,3vw,34px);color:#1F2933">Wanneer dit niet bij je past.</h2></div>
        <p style="font-size:16px;color:var(--body)">Finable is geen goede fit als je op zoek bent naar een junior medewerker voor alleen de dagelijkse verwerking, of als je finance volledig in-house wilt opbouwen.</p>
      </div>
      <div style="background:#F3EDE7;border-radius:12px;padding:34px 36px;display:flex;gap:18px;align-items:flex-start">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.6" style="flex-shrink:0;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="8" r="0.6" fill="#C4643A"/></svg>
        <div>
          <h3 style="font-size:20px;color:#1F2933;margin-bottom:8px">Twijfel je of dit past?</h3>
          <p style="font-size:15px;color:var(--body);margin-bottom:14px">Laten we het kort bespreken. In 30 minuten heb je duidelijkheid.</p>
          <a href="/gesprek" style="font-weight:600;font-size:16px">Plan een gesprek →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER (minimal) -->
  <footer style="border-top:1px solid #E6E1DB">
    <div class="wrap" style="padding-top:32px;padding-bottom:32px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px">
      <span style="font-family:'Playfair Display',serif;font-weight:700;font-size:22px;color:#1F2933;letter-spacing:-0.02em">Finable<span style="color:var(--terracotta)">.</span></span>
      <a href="/" class="ft-link" style="font-size:15px">← Terug naar de site</a>
    </div>
  </footer>

</div>
</Layout>

<style is:global>
  body{color:#1F2933;background:#FAF9F7;line-height:1.6}
  a:hover{color:#B2532B}
  .fin-secnum{font-family:'Playfair Display',serif;font-weight:500;color:var(--terracotta);font-size:clamp(34px,4vw,52px);line-height:.9}
  .fin-cap{font-size:15px;color:var(--body)}
  .fin-4{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:12px;align-items:stretch}
  .fin-win{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .fin-herocards{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center}
  .fin-sec{display:grid;grid-template-columns:minmax(0,0.85fr) minmax(0,1.15fr);gap:44px;align-items:center}
  @media (max-width:1023px){
  .fin-4{grid-template-columns:1fr 1fr;gap:16px}
  .fin-4 .fin-arrow{display:none}
  .fin-win{grid-template-columns:1fr 1fr}
  .fin-herocards{grid-template-columns:1fr;gap:20px}
  .fin-herocards .fin-arrow{transform:rotate(90deg);justify-self:center}
  .fin-sec{grid-template-columns:1fr;gap:28px}
  }
  @media (max-width:639px){ .fin-win{grid-template-columns:1fr} }
  .ft-link{color:var(--body)}
  .ft-link:hover{color:var(--terracotta)}
  .vac-btn:hover{filter:none;background:#B2532B}
  /* Responsive (bouwopdracht §5): 1024 / 640. Tussen 1024 en 1199px past de rij van vier kaarten niet naast de tekst: dan 2x2 (zoals op tablet). */
  @media (max-width:1199px){
    .fin-4{grid-template-columns:1fr 1fr;gap:16px}
    .fin-4 .fin-arrow{display:none}
    .fin-win{grid-template-columns:1fr 1fr}
  }
  @media (max-width:1023px){
    .vac-hero{grid-template-columns:1fr!important}
  }
  @media (max-width:639px){
    .vac-nav{gap:12px!important}
    .fin-win{grid-template-columns:1fr}
  }
</style>
