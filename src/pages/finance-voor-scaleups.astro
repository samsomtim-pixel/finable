---
// Doelgroeppagina voor founders en CEO's van groeiende bedrijven. Visuele basis: het goedgekeurde
// ontwerp finance-voor-scaleups v2. Eigen rol naast /finance-uitbesteden (het vraagstuk) en
// /finance-hire (het wervingsmoment): wat er in een groeifase breekt en in welke volgorde.
// NL-only, net als /finance-uitbesteden en /voor-boekhouders: hreflang uit.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

/** De drie groeiproblemen uit het ontwerp, met een tweede regel die benoemt wat er concreet misgaat. */
const problemen = [
  { n: '01', h: 'Je cijfers komen te laat.', p: 'De maand is voorbij, maar je weet nog niet hoe je resultaat, je marges en je cashpositie ervoor staan. Je stuurt op het gevoel van vorige maand.' },
  { n: '02', h: 'Finance hangt aan losse mensen.', p: 'De boekhouder doet de administratie, jij houdt spreadsheets bij, de controller komt niet aan analyse toe. Niemand overziet het geheel.' },
  { n: '03', h: 'Je twijfelt over de volgende hire.', p: 'Administrateur, controller of finance manager? Vaak heb je meerdere expertises nodig, maar geen daarvan fulltime.' },
];

/** De volgorde waarin finance achterloopt tijdens groei: de inhoudelijke kern van deze pagina, en
 *  bewust niet te vinden op /finance-uitbesteden of /finance-hire. Kort gehouden als drie stappen,
 *  zodat de oplossing sneller in beeld komt. */
const volgorde = [
  { k: 'Eerst het volume', v: 'Meer facturen, meer mutaties, meer uitzonderingen.' },
  { k: 'Dan de complexiteit', v: 'Een tweede entiteit, een buitenlandse klant, een investering.' },
  { k: 'Daarna de vragen', v: 'Management, bank en accountant willen allemaal cijfers.' },
];

const model = [
  { n: '01', h: 'Dagelijkse finance', p: 'Administratie, facturen, bank, debiteuren en crediteuren.' },
  { n: '02', h: 'Maandafsluiting', p: 'Reconciliaties, controles en een voorspelbaar afsluitproces.' },
  { n: '03', h: 'Financial control', p: 'Financiële kwaliteit, afwijkingen, marges en cashflow.' },
  { n: '04', h: 'Rapportage & inzicht', p: 'Managementinformatie, KPI’s en forecasting waar passend.' },
];

const waarom = [
  { n: '01', h: 'Eén vast aanspreekpunt', p: 'Iemand die je bedrijf kent en de samenwerking bewaakt.' },
  { n: '02', h: 'Verschillende expertises', p: 'Administratie, afsluiting, control en rapportage in één team.' },
  { n: '03', h: 'Continuïteit', p: 'Je bent minder afhankelijk van de beschikbaarheid van één persoon.' },
  { n: '04', h: 'Flexibel meegroeien', p: 'Meer of minder werk als je bedrijf verandert.' },
  { n: '05', h: 'Duidelijke afspraken', p: 'Een vast maandritme en vooraf heldere scope en kosten.' },
];

const doelgroepen = [
  { h: 'SaaS & AI', p: 'Snelle groei, terugkerende omzet, investeerders en behoefte aan financiële stuurinformatie.' },
  { h: 'Fintech', p: 'Toenemende complexiteit, controles en rapportagebehoeften.' },
  { h: 'E-commerce & D2C', p: 'Transacties, verkoopkanalen, marges en cashflow.' },
  { h: 'Zakelijke dienstverlening', p: 'Groeiende teams, projecten en behoefte aan betrouwbare managementinformatie.' },
];

/** Koopaanleidingen als herkenbare situatie in plaats van een label: de bezoeker moet zichzelf
 *  erin terugzien, ongeacht sector. Zelfde zes aanleidingen als in het ontwerp. */
const triggers = [
  { k: 'Een finance-vacature', v: 'Er staat een vacature open die je niet vervuld krijgt, terwijl het werk doorgaat.' },
  { k: 'Internationale groei', v: 'Een tweede entiteit of een buitenlandse klant, en daarmee een administratie erbij.' },
  { k: 'Een investering', v: 'Er komt een investeerder bij, en daarmee een rapportageritme dat vastligt.' },
  { k: 'Te weinig zicht op cash', v: 'Je weet pas achteraf hoe je cashpositie en je marges ervoor stonden.' },
  { k: 'Vertrek van finance-personeel', v: 'Degene die het wist vertrekt, en de kennis zit nergens anders vast.' },
  { k: 'Onduidelijk eigenaarschap', v: 'Niemand kan zeggen wie welk deel van finance bezit en bewaakt.' },
];

const stappen = [
  { n: '01', h: 'Eerst begrijpen', p: 'We bekijken hoe finance nu draait, waar het knelt en wie waarvoor verantwoordelijk is.' },
  { n: '02', h: 'Dan afspreken', p: 'We bepalen welke werkzaamheden Finable overneemt, hoe controles en samenwerking worden ingericht en wat de dienstverlening kost.' },
  { n: '03', h: 'Daarna gewoon draaien', p: 'Een vast maandritme voor uitvoering, afsluiting, controle, rapportage en overleg.' },
];

/** Uitsluitend wat op /cases/the-good-roll staat. Geen cijfers, geen tweede citaat, geen parafrase. */
const caseKolommen = [
  { k: 'De aanleiding', v: 'Groei maakt finance vanzelf complexer: meer transacties, meer leveranciers, meer rapportages en meer vragen vanuit het management.' },
  { k: 'Wat Finable overnam', v: 'Begonnen met het inboeken. Inmiddels vrijwel de hele dagelijkse finance, met één vast aanspreekpunt en een team erachter.' },
  { k: 'Wat het oplevert', v: 'Minder handwerk, sneller inzicht en capaciteit die meegroeit zonder telkens een nieuwe hire.' },
];

const faq = [
  { q: 'Is Finable een vervanging voor onze boekhouder?', a: 'Dat kan, maar het hoeft niet. We kijken eerst wat er nu goed werkt. Soms neemt Finable de administratie over, soms werken we naast je boekhouder of accountant. Vóór de start spreken we af welke werkzaamheden bij welke partij liggen.' },
  { q: 'Hebben we een eigen CFO nodig?', a: 'Dat is een andere vraag dan deze pagina beantwoordt. Finable verzorgt de uitvoering, de afsluiting, de controle en de rapportage. Strategische keuzes, budgetbesluiten en de financiële koers blijven bij jullie, eventueel samen met een eigen of fractional CFO. Finable neemt die rol niet over.' },
  { q: 'Wie voert het werk uit?', a: 'Je hebt één vast aanspreekpunt in Nederland. Het uitvoerende team werkt vanuit India, met een vaste bezetting die je bedrijf, processen en systemen leert kennen. Inhoudelijke controles en reviews horen bij het vaste werkproces.' },
  { q: 'Wat kost Finable?', a: 'Eén vaste maandprijs, gebaseerd op de werkzaamheden die Finable overneemt, het volume en de complexiteit van je finance. Die spreken we vooraf af. Er is geen standaardpakket en geen prijs op basis van omzet.' },
  { q: 'Kunnen we klein beginnen?', a: 'Ja. Veel samenwerkingen starten met een afgebakend deel, zoals de dagelijkse administratie, en breiden uit als het goed werkt. De verdeling kan later worden aangepast wanneer de organisatie of de behoefte verandert.' },
];
---
<Layout
  title="Finance voor scale-ups en groeiende bedrijven | Finable"
  description="Groeit je bedrijf sneller dan je finance-organisatie? Finable runt je dagelijkse finance, maandafsluiting, controlling en rapportage, met één vast aanspreekpunt."
  hreflang={false}
  breadcrumbs={[{ name: 'Finable', path: '/' }, { name: 'Finance voor scale-ups' }]}
>
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap sc-hero" style="padding-top:64px;padding-bottom:80px">
      <div>
        <div class="lbl" style="margin-bottom:24px">Finance voor scale-ups</div>
        <h1 style="font-size:clamp(38px,4.8vw,62px);line-height:1.05;margin-bottom:26px;text-wrap:balance">Je bedrijf groeit. <span class="em">Je finance moet meegroeien.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,19px);line-height:1.6;color:var(--on-dark-secondary);max-width:560px;margin-bottom:14px;text-wrap:pretty">Meer klanten, meer transacties, meer complexiteit. Maar je finance is vaak nog ingericht zoals toen je begon.</p>
        <p style="font-size:16px;line-height:1.65;color:var(--on-dark-tertiary);max-width:560px;text-wrap:pretty">Finable organiseert en runt je finance-functie: van dagelijkse administratie en maandafsluiting tot controlling en rapportage. E&eacute;n vast aanspreekpunt en een gespecialiseerd team, in plaats van losse finance-rollen die je zelf moet werven en aansturen.</p>
        <div class="sc-ctas" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:36px">
          <Button href="/gesprek">Plan een gesprek &rarr;</Button>
          <a href="/hoe-het-werkt" class="sc-on-dark" style="font-weight:600;font-size:16px;color:var(--white)">Zo werkt Finable &rarr;</a>
        </div>
      </div>
      <div class="sc-hero-vis" aria-hidden="true">
        <div class="hv-wrap">
          <div class="hv-list">
            <div class="hv-item">Dagelijkse finance</div>
            <div class="hv-item">Maandafsluiting</div>
            <div class="hv-item">Financial control</div>
            <div class="hv-item">Rapportage &amp; inzicht</div>
          </div>
          <svg class="hv-brace" width="40" height="150" viewBox="0 0 40 150" fill="none" stroke="#C4643A" stroke-width="2" stroke-linecap="round"><path d="M4 4c12 0 16 6 16 18v34c0 12 6 19 16 19-10 0-16 7-16 19v34c0 12-4 18-16 18"/></svg>
          <div class="hv-out">
            <div style="font-family:'Playfair Display',Georgia,serif;font-size:22px;line-height:1.15;color:var(--white)">E&eacute;n finance-functie</div>
            <div style="font-size:12px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:rgba(255,255,255,0.86);margin-top:10px">E&eacute;n aanspreekpunt</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEEM -->
  <section class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(56px,7vw,88px)">
    <div class="sc-2" style="margin-bottom:52px">
      <h2 style="font-size:clamp(28px,3.6vw,44px);line-height:1.1;text-wrap:balance">Je organisatie groeit. Finance blijft achter.</h2>
      <p style="font-size:17px;color:var(--body);text-wrap:pretty">Wat prima werkte met vijf medewerkers, werkt niet automatisch meer met vijftig. Niet omdat er iets misgaat, maar omdat er werk bij komt dat er eerder niet was.</p>
    </div>
    <div class="sc-3">
      {problemen.map((p) => (
        <div>
          <div class="sc-num">{p.n}</div>
          <h3 style="font-size:clamp(20px,2.2vw,24px);line-height:1.2;margin-bottom:12px">{p.h}</h3>
          <p style="font-size:16px;color:var(--body);text-wrap:pretty">{p.p}</p>
        </div>
      ))}
    </div>
    <!-- De volgorde waarin het misloopt: de eigen invalshoek van deze pagina. -->
    <div class="sc-volgorde">
      <div class="lbl" style="margin-bottom:22px">Wat er verandert tijdens groei</div>
      <div class="sc-vol">
        <div><div class="sc-vol-k">{volgorde[0].k}</div><p>{volgorde[0].v}</p></div>
        <svg class="sc-vol-a" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="sc-vol-k">{volgorde[1].k}</div><p>{volgorde[1].v}</p></div>
        <svg class="sc-vol-a" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="sc-vol-k">{volgorde[2].k}</div><p>{volgorde[2].v}</p></div>
      </div>
      <p class="sc-vol-slot">Finance groeit niet alleen in hoeveelheid werk. Het werk verandert ook van aard. Daarom lost &eacute;&eacute;n extra medewerker niet altijd het hele probleem op. Lees ook <a href="/kennis/wanneer-controller-nodig">wanneer een groeiend bedrijf controlling nodig heeft</a>.</p>
    </div>
  </section>

  <!-- OPLOSSING · OPERATING MODEL -->
  <section class="sc-sec-tint">
    <div class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px)">
      <div style="max-width:860px;margin-bottom:52px">
        <div class="lbl" style="margin-bottom:20px">De oplossing</div>
        <h2 style="font-size:clamp(28px,3.9vw,48px);line-height:1.08;margin-bottom:22px;text-wrap:balance">Je hebt niet voor iedere finance-taak een nieuwe medewerker nodig.</h2>
        <p style="font-size:18px;color:var(--body);text-wrap:pretty">Je hebt vooral een finance-functie nodig die goed georganiseerd is. Finable combineert Nederlandse regie met een gespecialiseerd finance-team dat de uitvoering doet.</p>
      </div>
      <div class="om">
        <div class="om-top"><span>Nederlandse regie</span><span class="om-top-sub">E&eacute;n vast aanspreekpunt</span></div>
        <div class="om-grid">
          {model.map((m, i) => (
            <div class={'om-cell' + (i % 2 === 1 ? ' is-right' : '')}>
              <div class="om-n">{m.n}</div>
              <h3 style="font-size:clamp(19px,2vw,22px);margin:6px 0 8px">{m.h}</h3>
              <p>{m.p}</p>
            </div>
          ))}
          <div class="om-badge">E&eacute;n finance-functie</div>
        </div>
        <div class="om-bot"><span>Gespecialiseerd finance-team</span><span class="om-bot-sub">Uitvoering &middot; controles &middot; continu&iuml;teit</span></div>
      </div>
      <div class="om-slot">
        <p class="om-claim">E&eacute;n samenhangende finance-functie. <span style="color:var(--terracotta)">Niet vier losse leveranciers.</span></p>
        <a href="/aanpak" style="font-weight:600;font-size:16px;color:var(--terracotta)">Bekijk hoe het team is opgebouwd &rarr;</a>
      </div>
    </div>
  </section>

  <!-- VOLGENDE HIRE -->
  <section class="wrap" style="padding-top:clamp(56px,7vw,88px);padding-bottom:clamp(56px,7vw,88px)">
    <div class="sc-hire">
      <div>
        <div class="lbl" style="margin-bottom:20px">De volgende stap</div>
        <h2 style="font-size:clamp(26px,3.3vw,40px);line-height:1.12;margin-bottom:20px;text-wrap:balance">Je volgende finance-hire hoeft niet automatisch een medewerker te zijn.</h2>
        <p style="font-size:17px;color:var(--body);text-wrap:pretty">Een groeiend bedrijf heeft vaak meerdere finance-expertises nodig, maar niet iedere rol fulltime. Soms is een interne medewerker precies goed. Soms is het slimmer om die expertises als &eacute;&eacute;n team te organiseren.</p>
        <p style="font-size:16px;color:var(--body);margin-top:16px;text-wrap:pretty"><a href="/finance-hire" style="font-weight:600">Vergelijk een interne hire met een finance-team &rarr;</a></p>
      </div>
      <div class="sc-hire-cards">
        <div class="sc-card-plain">
          <div class="sc-card-lbl">Zelf organiseren</div>
          <div class="sc-row">Administrateur</div>
          <div class="sc-row">Controller</div>
          <div class="sc-row">Finance manager</div>
          <p style="font-size:13px;color:var(--body);margin-top:12px">Losse rollen, aparte werving en aansturing.</p>
        </div>
        <div class="sc-card-navy">
          <div class="sc-card-lbl is-ter">Met Finable</div>
          <div style="font-family:'Playfair Display',Georgia,serif;font-size:clamp(22px,2.4vw,26px);line-height:1.2;color:var(--white);margin-top:6px">E&eacute;n georganiseerde finance-functie.</div>
          <p style="font-size:14px;color:var(--on-dark-secondary);margin-top:auto;padding-top:16px">E&eacute;n team, &eacute;&eacute;n aanspreekpunt, &eacute;&eacute;n vaste maandprijs. Uitbreiden wanneer nodig.</p>
        </div>
      </div>
    </div>
    <p class="sc-cfo">De strategische rol blijft bij jou. Budgetbesluiten, investeringen en de financi&euml;le koers bepaal je zelf, eventueel samen met een eigen of fractional CFO. Finable organiseert en draait de uitvoering eronder.</p>
  </section>

  <!-- WAAROM (navy) -->
  <section style="background:var(--navy)">
    <div class="wrap" style="padding-top:clamp(56px,7vw,80px);padding-bottom:clamp(56px,7vw,80px)">
      <div class="sc-why-head">
        <h2 style="font-size:clamp(26px,3.3vw,40px);line-height:1.12;color:var(--white);max-width:720px;text-wrap:balance">Meer grip op finance. <span style="color:var(--terracotta)">Zonder een hele afdeling op te bouwen.</span></h2>
        <div class="lbl" style="color:var(--on-dark-tertiary)">Waarom Finable</div>
      </div>
      <p class="sc-why-p">Administratie, afsluiting, control en rapportage grijpen op elkaar in: wat in week &eacute;&eacute;n wordt ingeboekt, bepaalt wat je in de afsluiting terugziet en wat er in de rapportage van klopt. Finable organiseert die samenhang. Je co&ouml;rdineert dus geen vier losse specialisten die elk een stuk doen, maar werkt met &eacute;&eacute;n team dat de hele keten draait.</p>
      <div class="sc-why">
        {waarom.map((w) => (
          <div>
            <div class="sc-why-n">{w.n}</div>
            <div style="font-weight:600;color:var(--white);margin-bottom:8px">{w.h}</div>
            <p style="font-size:14px;color:var(--on-dark-secondary);text-wrap:pretty">{w.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VOOR WIE -->
  <section class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(56px,7vw,88px)">
    <h2 style="font-size:clamp(28px,3.6vw,44px);line-height:1.1;max-width:820px;margin-bottom:44px;text-wrap:balance">Voor bedrijven die harder groeien dan hun finance-organisatie.</h2>
    <div class="sc-4">
      {doelgroepen.map((d) => (
        <div>
          <h3 style="font-size:clamp(20px,2.3vw,26px);margin-bottom:12px">{d.h}</h3>
          <p style="font-size:15px;color:var(--body);text-wrap:pretty">{d.p}</p>
        </div>
      ))}
    </div>
    <p style="font-size:14px;color:var(--body);margin-top:14px">Voorbeelden, geen exclusieve doelgroepen.</p>
    <div class="sc-trig">
      <div class="lbl" style="margin-bottom:22px">Vaak het moment dat bedrijven ons bellen</div>
      <div class="sc-trig-grid">
        {triggers.map((t) => (
          <div class="sc-trig-cell">
            <div class="sc-trig-k"><span class="sc-dot"></span>{t.k}</div>
            <p>{t.v}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOE WERKT HET -->
  <section class="sc-sec-tint">
    <div class="wrap" style="padding-top:clamp(56px,7vw,88px);padding-bottom:clamp(56px,7vw,88px)">
      <div style="max-width:820px;margin-bottom:52px">
        <div class="lbl" style="margin-bottom:20px">Zo werkt het</div>
        <h2 style="font-size:clamp(28px,3.6vw,44px);line-height:1.1;text-wrap:balance">Wat goed werkt, laten we staan. Wat ontbreekt, organiseren we.</h2>
      </div>
      <div class="sc-steps-wrap">
        <div class="sc-steps-line"></div>
        <div class="sc-steps">
          {stappen.map((s, i) => (
            <div>
              <div class={'sc-step-n' + (i === 0 ? ' is-first' : '')}>{s.n}</div>
              <h3 style="font-size:clamp(20px,2.2vw,24px);margin-bottom:10px">{s.h}</h3>
              <p style="font-size:16px;color:var(--body);text-wrap:pretty">{s.p}</p>
            </div>
          ))}
        </div>
      </div>
      <p class="sc-steps-slot"><a href="/hoe-het-werkt" style="font-weight:600">Bekijk de volledige werkwijze, van scan tot maandritme &rarr;</a></p>
    </div>
  </section>

  <!-- CASE (navy) -->
  <section style="background:var(--navy)">
    <div class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px)">
      <div style="display:flex;align-items:center;gap:18px;margin-bottom:30px">
        <span style="width:60px;height:60px;border-radius:999px;background:var(--white);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden"><img src="/images/the-good-roll.png" alt="Logo The Good Roll" width="662" height="663" loading="lazy" style="width:44px;height:44px;display:block"></span>
        <span class="lbl">Klantcase &middot; The Good Roll</span>
      </div>
      <p style="font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(26px,3.8vw,46px);line-height:1.15;color:var(--white);max-width:960px;text-wrap:balance">Van sceptisch naar <span style="color:var(--terracotta)">&ldquo;ik zou het iedereen aanraden.&rdquo;</span></p>
      <p style="font-size:15px;color:var(--on-dark-tertiary);margin-top:14px">Sander de Klerk, The Good Roll</p>
      <div class="sc-case">
        {caseKolommen.map((c) => (
          <div>
            <div class="sc-case-k">{c.k}</div>
            <p style="font-size:16px;color:var(--on-dark-secondary);text-wrap:pretty">{c.v}</p>
          </div>
        ))}
      </div>
      <a href="/cases/the-good-roll" data-case-link="the_good_roll" style="display:inline-block;margin-top:40px;font-weight:600;font-size:16px;color:var(--white)">Lees de volledige case &rarr;</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap" style="padding-top:clamp(64px,8vw,96px);padding-bottom:clamp(64px,8vw,96px)">
    <div class="sc-faq">
      <div>
        <div class="lbl" style="margin-bottom:20px">Veelgestelde vragen</div>
        <h2 style="font-size:clamp(26px,3.3vw,40px);line-height:1.1">Wat je wilt weten voordat je begint.</h2>
      </div>
      <div style="border-top:1px solid var(--line)">
        {faq.map((f) => (
          <details class="fin-faq"><summary><span class="fin-faq-q">{f.q}</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>{f.a}</p></div></details>
        ))}
      </div>
    </div>
  </section>

