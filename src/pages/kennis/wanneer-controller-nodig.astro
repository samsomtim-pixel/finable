const signalen = [
  'De maandcijfers zijn er, maar niemand kan uitleggen waarom de marge twee procentpunt lager ligt dan vorig kwartaal.',
  'Je boekhouder zegt steeds vaker: dat weet ik niet, dat is een vraag voor de directie.',
