  .art-body h3{font-size:19px;margin:0 0 6px;text-wrap:balance}
  .art-body p{font-size:17px;color:var(--body);text-wrap:pretty}
  .art-body p+p{margin-top:16px}
  .art-body ul,.art-body ol{list-style:none;margin:20px 0 0}
