    waarom: 'In het onderzoek blijft dit binnen het kantoor, ook bij kantoren die verder wel uitbesteden.',
    grond: 'Onderzoek',
  },
  {
    werk: 'Aansluitingen, review, akkoord',
    kenmerk: 'Controle op andermans werk',
    richting: 'Expliciet beleggen',
    waarom: 'Waar controle landt is een keuze, geen restpost. Als niemand hem maakt, valt hij stil of komt hij bij dezelfde persoon te liggen die het werk deed.',
    grond: 'Besliskader',
  },
  {
    werk: 'Jaarwerkseizoen, achterstand, tijdelijke piek',
    kenmerk: 'Tijdelijk, aflopend',
    richting: 'Externe capaciteit afwegen tegen werven',
    waarom: 'Een piek die overgaat rechtvaardigt niet vanzelf een vaste aanstelling. Dat is een afweging, geen uitkomst.',
