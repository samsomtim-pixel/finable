// tijdsbesparing, de Benchmark Kantoorcijfers (cijfers over boekjaar 2022, te oud naast de rest) en
// de CBS-belemmeringsreeks waarvan de meetperiode niet vaststond.
//
// Hergebruikt: Layout, Header, Footer en het artikelpatroon (.crumb, .art-*) van
// /kennis/finance-afdeling-inrichten. Geen nieuw visueel systeem.
import Layout from '../../layouts/Layout.astro';
