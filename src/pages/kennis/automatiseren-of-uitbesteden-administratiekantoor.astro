    kenmerk: 'Hoog volume, veel uitzonderingen',
    richting: 'Intern of extern uitvoeren',
    waarom: 'Automatisering verlaagt het volume maar concentreert de uitzonderingen. Wat overblijft is juist het werk dat een mens moet bekijken.',
    grond: 'Besliskader',
  },
  {
    werk: 'Administratieve werkzaamheden, loonadministratie, fiscale aangiften',
    kenmerk: 'Terugkerend, gestandaardiseerd, uitvoerend',
    richting: 'Uitbesteden is gangbaar',
    waarom: 'Dit zijn de werkzaamheden die kantoren die uitbesteden volgens het NOAB-onderzoek extern beleggen.',
    grond: 'Onderzoek',
  },
  {
    werk: 'Klantgesprekken, duiding, advies',
    kenmerk: 'Relatie en oordeel',
