  .team{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,0.9fr);gap:clamp(36px,4.4vw,64px);align-items:center}
  .princ{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,2vw,26px);margin-top:40px}
  .indic{background:var(--terracotta-soft);border-radius:10px;padding:clamp(28px,3.4vw,44px) clamp(28px,4vw,52px);display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1fr) auto;gap:clamp(24px,3vw,44px);align-items:center}
  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:30px;padding:24px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(17px,1.7vw,20px);color:var(--navy);line-height:1.35;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:17px;height:17px;flex-shrink:0;margin-top:6px}
  .fin-faq-ic::before,.fin-faq-ic::after{content:"";position:absolute;background:var(--terracotta);transition:opacity .2s}
  .fin-faq-ic::before{left:0;top:7.5px;width:17px;height:2px}
  .fin-faq-ic::after{left:7.5px;top:0;width:2px;height:17px}
  details.fin-faq[open] .fin-faq-ic::after{opacity:0}
  details.fin-faq>summary:hover .fin-faq-q{color:var(--terracotta)}
  .fin-faq-a{max-width:760px;padding:0 0 28px;font-size:15.5px;color:var(--body);line-height:1.72}
  @media (max-width:1023px){
  .hero-right{gap:28px}
  .disc{border-left:none;padding-left:0}
  .hero-note{display:none}
  .why{grid-template-columns:1fr;gap:34px}
  .flow{grid-template-columns:1fr;gap:18px}
  .flow .fa{transform:rotate(90deg);justify-self:start}
  .team{grid-template-columns:1fr;gap:36px}
  .princ{grid-template-columns:1fr}
  .indic{grid-template-columns:1fr;gap:22px}
  .ft-end{grid-template-columns:1fr!important;gap:36px!important}
  .ft-end>div:last-child{border-left:none!important;padding-left:0!important;border-top:1px solid var(--on-dark-line);padding-top:36px}
  }
  @media (min-width:640px){.cmp-m{display:none}}
  /* Responsive (bouwopdracht §5): 1024 / 640 */
  @media (max-width:1023px){
    .hero{grid-template-columns:1fr!important;gap:40px!important}
    .disc{display:grid;grid-template-columns:1fr 1fr;gap:22px 24px}
    .why-cmp{gap:24px}
    .navy-end{grid-template-columns:1fr!important}
    .tim-row{grid-template-columns:1fr!important}
    .tim-row>div:first-child{max-width:150px}
  }
  @media (max-width:639px){
    .disc{grid-template-columns:1fr}
    /* Vergelijking per onderwerp in plaats van twee lange lijsten */
    .why-cmp{display:none}
    /* Navy-anker stopt na het mechanisme; vervolgtekst op wit eronder */
    .navy .wrap>div[style*="height:1px;background:rgba(255,255,255,0.14)"]{display:none}
    .navy-end{background:var(--white);margin:44px -24px -56px;padding:44px 24px 48px}
    .navy-end h3{color:var(--navy)!important}
    .navy-end p{color:var(--body)!important}
    /* Indicatie-CTA: neutrale kaart, knop in volle terracotta */
    .indic{background:var(--section)}
    .indic>a{justify-self:start}
    .hero-right{gap:28px}
    .disc{gap:18px}
    .flow{gap:12px}
    .why-cmp{gap:28px}
    .princ{gap:22px;margin-top:32px}
    .team-note{text-align:left}
  }
</style>

<script>
  // "Bekijk alle veelgestelde vragen": toont de verborgen vragen.
  const btn = document.querySelector<HTMLAnchorElement>('[data-faq-more]');
  const hidden = document.querySelector<HTMLElement>('[data-faq-hidden]');
  const wrap = document.querySelector<HTMLElement>('[data-faq-morewrap]');
  if (btn && hidden) {
    btn.addEventListener('click', (e) => { e.preventDefault(); hidden.style.display = 'block'; if (wrap) wrap.style.display = 'none'; });
  }
</script>
