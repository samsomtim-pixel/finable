---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---
<Layout title="Finance-team — niet één finance-hire, een heel finance-team | Finable" description="Dagelijkse finance, afsluiting, controlling en rapportage vragen verschillende expertise. Finable brengt die samen in één vast finance-team met één aanspreekpunt.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header active="aanpak" />

  <!-- HERO -->
  <section class="wrap" style="padding-top:44px;padding-bottom:64px">
    <div class="hero" style="display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,1.05fr);gap:clamp(36px,4.6vw,72px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:26px">Finance-team</div>
        <h1 style="font-size:clamp(38px,5vw,64px);line-height:1.04;margin-bottom:26px">Niet één finance-hire.<br>Een heel finance-team.</h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:var(--body);max-width:480px;text-wrap:pretty">Dagelijkse finance, afsluiting, controlling en rapportage vragen verschillende expertise. Finable brengt die samen in één vast team.</p>
        <div style="display:flex;align-items:center;gap:18px;margin-top:30px">
          <span style="width:40px;height:2px;background:var(--terracotta);flex-shrink:0"></span>
          <span style="font-size:15px;font-weight:600;color:var(--navy)">Een heel finance-team. Voor minder dan één controller.</span>
        </div>
      </div>

      <div class="hero-right">
        <div class="disc">
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg>
            <div><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--navy)">Dagelijkse finance</div><div style="font-size:14px;color:var(--body)">Verwerking &amp; administratie</div></div>
          </div>
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9h16M8 3v4M16 3v4M8 14h4"/></svg>
            <div><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--navy)">Maandafsluiting</div><div style="font-size:14px;color:var(--body)">Afsluiting &amp; controle</div></div>
          </div>
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></svg>
            <div><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--navy)">Controlling</div><div style="font-size:14px;color:var(--body)">Analyse &amp; afwijkingen</div></div>
          </div>
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg>
            <div><div style="font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--navy)">Managementrapportage</div><div style="font-size:14px;color:var(--body)">Rapportage &amp; duiding</div></div>
          </div>
        </div>
        <div class="hero-still"><div class="ph" style="border-radius:12px;" role="img" aria-label="Placeholder: stilleven — boeken · keramiek · plant"><span>stilleven — boeken · keramiek · plant</span></div></div>
        <div class="hero-note">
          <div class="cav" style="font-size:22px">Je hoeft dit dus niet in één persoon te vinden.</div>
          <svg width="72" height="54" viewBox="0 0 72 54" fill="none" style="margin:2px auto 0"><path d="M60 6C50 30 30 42 8 40" stroke="#C4643A" stroke-width="2" stroke-linecap="round"/><path d="M16 30l-9 11 14 3" stroke="#C4643A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>
  </section>

  <!-- WAAROM EEN TEAM -->
  <section class="wrap" style="padding-top:64px;padding-bottom:80px">
    <div class="why">
      <div>
        <div class="lbl" style="margin-bottom:20px">Waarom een team?</div>
        <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px">Eén persoon hoeft niet alles te kunnen.</h2>
        <p style="font-size:16px;color:var(--body);text-wrap:pretty">Finance vraagt om verschillende disciplines. Toch komen die in groeiende bedrijven vaak samen in één functieprofiel.</p>
      </div>
      <div class="why-cmp">
        <div class="cmp-col">
          <div class="ch" style="color:var(--body)">Eén finance-hire</div>
          <div class="cr" style="color:var(--body)">Eén functieprofiel</div>
          <div class="cr" style="color:var(--body)">Capaciteit van één persoon</div>
          <div class="cr" style="color:var(--body)">Kennis bij één persoon</div>
          <div class="cr" style="color:var(--body)">Eén beschikbaarheid</div>
        </div>
        <div class="cmp-col">
          <div class="ch" style="color:var(--terracotta)">Finable-team</div>
          <div class="cr" style="color:var(--navy)">Verschillende expertises</div>
          <div class="cr" style="color:var(--navy)">Capaciteit van een team</div>
          <div class="cr" style="color:var(--navy)">Kennis verdeeld in het team</div>
          <div class="cr" style="color:var(--navy)">Continuïteit binnen het team</div>
        </div>
      </div>
      <div style="background:rgba(196,100,58,0.10);border-radius:0 40px 40px 40px;padding:clamp(28px,2.6vw,36px) clamp(26px,2.4vw,34px)">
        <p style="font-family:'Playfair Display',serif;font-size:clamp(19px,1.9vw,25px);color:var(--navy);line-height:1.3">Finance organiseren rond het werk dat nodig is. Niet rond één functieprofiel.</p>
        <span style="display:block;width:44px;height:3px;background:var(--terracotta);margin-top:22px;border-radius:999px"></span>
        <div style="margin-top:24px">
          <div class="lbl" style="margin-bottom:8px">Overweeg je iemand aan te nemen?</div>
          <p style="font-size:15px;color:var(--body);margin-bottom:8px">Vergelijk één finance-hire met een Finable-team.</p>
          <a href="/vacature" style="font-weight:600;font-size:15px;color:var(--terracotta)">Finance-hire of Finable? &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WAT HET TEAM DOET (navy anker) -->
  <section class="navy">
    <div class="wrap" style="padding-top:84px;padding-bottom:84px">
      <div style="max-width:640px;margin-bottom:48px">
        <div class="lbl" style="color:var(--terracotta);margin-bottom:20px">Wat het team doet</div>
        <h2 style="font-size:clamp(30px,3.6vw,46px);color:var(--white);margin-bottom:18px;line-height:1.08">Van dagelijkse finance tot managementrapportage.</h2>
        <p style="font-size:clamp(16px,1.35vw,18px);color:var(--on-dark-secondary);max-width:560px;text-wrap:pretty">Finable kan een deel overnemen of vrijwel je hele dagelijkse finance organiseren.</p>
      </div>
      <div class="flow">
        <div><div class="fn">Dagelijkse finance</div><div class="fd">Facturen · bank · debiteuren · payroll</div></div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="fn">Maandafsluiting</div><div class="fd">Aansluitingen · btw · maanddossier</div></div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="fn">Controlling</div><div class="fd">Marge · cash · afwijkingen</div></div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="fn">Managementrapportage</div><div class="fd">Rapportage · duiding · gesprek</div></div>
      </div>
      <div style="height:1px;background:rgba(255,255,255,0.14);margin:52px 0 40px"></div>
      <div class="navy-end" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(28px,3.4vw,56px);align-items:end">
        <h3 style="font-family:'Playfair Display',serif;font-size:clamp(24px,2.9vw,38px);color:var(--white);line-height:1.14">De juiste expertise voor ieder onderdeel. Eén team voor het geheel.</h3>
        <div>
          <p style="font-size:15px;color:var(--on-dark-secondary);margin-bottom:14px;text-wrap:pretty">Wat Finable precies overneemt, hangt af van wat er binnen je organisatie al staat.</p>
          <a href="/hoe-het-werkt" style="color:var(--terracotta);font-weight:600;font-size:15px">Zo werkt Finable &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HET FINABLE-TEAM -->
  <section class="wrap" style="padding-top:80px;padding-bottom:40px">
    <div class="team">
      <div>
        <div class="lbl" style="margin-bottom:20px">Het Finable-team</div>
        <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.08">Een vast team dat je organisatie leert kennen.</h2>
        <div class="princ">
          <div>
            <svg width="30" height="26" viewBox="0 0 40 34" fill="none" stroke="#C4643A" stroke-width="1.6" style="margin-bottom:16px"><circle cx="20" cy="10" r="5"/><circle cx="8" cy="13" r="4"/><circle cx="32" cy="13" r="4"/><path d="M10 28c0-5 4.5-8 10-8s10 3 10 8"/></svg>
            <div class="lbl" style="color:var(--navy);margin-bottom:8px">Vast team</div>
            <p style="font-size:14px;color:var(--body);line-height:1.55">Geen wisselende bezetting.</p>
          </div>
          <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.6" style="margin-bottom:16px"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.4"/></svg>
            <div class="lbl" style="color:var(--navy);margin-bottom:8px">Passende expertise</div>
            <p style="font-size:14px;color:var(--body);line-height:1.55">Het juiste werk bij de juiste mensen.</p>
          </div>
          <div>
            <svg width="28" height="28" viewBox="0 0 26 24" fill="none" stroke="#C4643A" stroke-width="1.6" style="margin-bottom:16px"><path d="M3 4h13v9H8l-4 3z"/><path d="M11 14v3h9l3 3v-9h-4"/></svg>
            <div class="lbl" style="color:var(--navy);margin-bottom:8px">Één aanspreekpunt</div>
            <p style="font-size:14px;color:var(--body);line-height:1.55">Je weet altijd wie je kunt bellen.</p>
          </div>
        </div>
      </div>
      <div style="position:relative">
        <div class="collage">
          <div class="cframe" style="left:2%;top:22px;width:50%;aspect-ratio:4/5;transform:rotate(-2.5deg);border-radius:12px"><div class="ph" role="img" aria-label="Placeholder: teamportret 1"><span>teamportret 1</span></div></div>
          <div class="cframe" style="right:4%;top:0;width:40%;aspect-ratio:4/5;transform:rotate(2.5deg);border-radius:12px"><div class="ph" role="img" aria-label="Placeholder: teamportret 2"><span>teamportret 2</span></div></div>
          <div class="cframe" style="right:8%;bottom:6px;width:44%;aspect-ratio:4/5;transform:rotate(-1deg);border-radius:12px"><div class="ph" role="img" aria-label="Placeholder: teamportret 3"><span>teamportret 3</span></div></div>
        </div>
        <div class="team-note" style="position:absolute;right:-6px;top:34%;width:130px;text-align:center;pointer-events:none">
          <div class="cav" style="font-size:22px">Het team achter Finable.</div>
          <svg width="66" height="50" viewBox="0 0 66 50" fill="none" style="margin:2px auto 0"><path d="M56 8C48 28 30 38 10 34" stroke="#C4643A" stroke-width="2" stroke-linecap="round"/><path d="M18 25l-8 10 13 3" stroke="#C4643A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>
    <h3 style="font-family:'Playfair Display',serif;font-size:clamp(26px,3.6vw,46px);color:var(--navy);line-height:1.12;margin-top:clamp(48px,5vw,72px);max-width:920px;text-wrap:balance">De schaal van een team. De aandacht van een vaste finance-partner.</h3>
  </section>

  <!-- INDICATIE -->
  <section class="wrap" style="padding-top:40px;padding-bottom:64px">
    <div class="indic">
      <div>
        <div class="lbl" style="margin-bottom:14px">Indicatie</div>
        <p style="font-family:'Playfair Display',serif;font-size:clamp(20px,2.2vw,28px);color:var(--navy);line-height:1.2">Een heel finance-team. Voor minder dan één controller.</p>
      </div>
      <p style="font-size:16px;color:var(--body);text-wrap:pretty">De maandprijs hangt af van wat Finable overneemt, het volume en de complexiteit van je finance.</p>
      <Button href="/indicatie" size="sm" style="text-align:center">Bekijk je indicatie &rarr;</Button>
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap" style="padding-top:24px;padding-bottom:72px">
    <div class="faq-grid" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:start">
      <div>
        <div class="lbl" style="margin-bottom:28px">Veelgestelde vragen</div>
        <div style="max-width:900px">
          <details class="fin-faq"><summary><span class="fin-faq-q">Waarom werkt Finable met een team in plaats van één finance-professional?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finance bestaat uit werkzaamheden die verschillende soorten ervaring en expertise vragen. Dagelijkse verwerking, maandafsluiting, controle en managementrapportage hoeven daarom niet allemaal bij één generalist te liggen. Finable organiseert die werkzaamheden als team. Daardoor kan het juiste niveau van expertise worden ingezet voor het werk dat nodig is, terwijl je als klant niet zelf verschillende specialisten hoeft aan te sturen. Je houdt één duidelijke samenwerking en één vast aanspreekpunt.</p></div></details>
          <details class="fin-faq"><summary><span class="fin-faq-q">Welke werkzaamheden kan het finance-team overnemen?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finable kan een breed deel van de operationele finance-functie verzorgen: van dagelijkse finance en maandafsluiting tot controlling en managementrapportage. Welke werkzaamheden daadwerkelijk worden overgenomen, bepalen we per organisatie. We kijken naar wat er al goed loopt, waar capaciteit ontbreekt en welke werkzaamheden structureel beter georganiseerd moeten worden. Daardoor hoeft de samenwerking niet groter te zijn dan nodig, maar kan Finable wel meer overnemen wanneer daar later behoefte aan ontstaat.</p></div></details>
          <details class="fin-faq"><summary><span class="fin-faq-q">Hoe verschilt Finable van een boekhouder of accountant?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Een boekhouder richt zich doorgaans vooral op de administratie en een accountant heeft onder meer een rol rond jaarwerk en specialistische accountantswerkzaamheden. Finable is bedoeld voor organisaties die een breder deel van hun dagelijkse finance — verwerking, afsluiting, controlling en rapportage — structureel door een team willen laten uitvoeren. De keuze is daarom niet automatisch tussen Finable óf een accountant; de rollen kunnen naast elkaar bestaan wanneer dat voor de organisatie logisch is.</p></div></details>
          <details class="fin-faq"><summary><span class="fin-faq-q">Kan Finable ook slechts een deel van onze finance overnemen?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Ja. We beginnen bij de finance-organisatie die er al staat. Wanneer bepaalde onderdelen goed functioneren, is er geen reden om die alleen vanwege Finable te veranderen. We kunnen bijvoorbeeld starten waar capaciteit of expertise ontbreekt en de rest laten zoals het is. Als de organisatie groeit of de behoefte verandert, kan de verdeling opnieuw worden bekeken en kan Finable meer of juist minder werkzaamheden uitvoeren.</p></div></details>
          <div data-faq-hidden style="display:none">
            <details class="fin-faq"><summary><span class="fin-faq-q">Wie zit er in het team dat voor onze organisatie werkt?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Je werkt met een vast finance-team waarin verschillende financiële expertises beschikbaar zijn. De precieze samenstelling hangt af van de werkzaamheden die Finable voor je organisatie uitvoert. Het uitgangspunt is dat niet alle verantwoordelijkheid en kennis bij één persoon komt te liggen. Tegelijkertijd werken we niet als een verzameling losse freelancers die je zelf moet aansturen: Finable organiseert het team en zorgt voor een duidelijke verdeling van werkzaamheden en verantwoordelijkheden.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Wanneer is iemand in dienst of een interim controller logischer?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Iemand in dienst is logisch wanneer er voldoende structureel werk is voor een duidelijk afgebakende finance-rol die je bewust intern wilt opbouwen. Een interim controller past bij een tijdelijke capaciteitsbehoefte of een tijdelijk specialistisch vraagstuk. Finable is bedoeld voor organisaties die een breder deel van hun dagelijkse finance structureel door een team willen laten uitvoeren. De opties sluiten elkaar niet uit; ze passen bij verschillende situaties.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Wat doet Finable wel en wat niet?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finable richt zich op het structureel uitvoeren en organiseren van de operationele finance-functie: dagelijkse finance, maandafsluiting, controlling en managementrapportage. Werkzaamheden waarvoor een specifieke externe bevoegdheid of specialistische expertise nodig is, zoals het ondertekenen van een jaarrekening of specialistisch fiscaal advies, vallen niet onder die kern. Waar nodig kan Finable wel aansluiten op de accountant, fiscalist of andere specialist die daarvoor verantwoordelijk is, zodat de verschillende onderdelen van finance goed op elkaar blijven aansluiten.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Hoe werkt Finable samen met accountants, fiscalisten en andere specialisten?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finable richt zich op de operationele finance-functie. Voor accountancy, fiscaliteit of specifieke systeemvraagstukken werken we waar nodig samen met de verantwoordelijke specialist. We stemmen vooraf af wie welke werkzaamheden uitvoert, zodat de verschillende onderdelen van finance goed op elkaar aansluiten en verantwoordelijkheden helder blijven. Zo blijft duidelijk wie waarvoor verantwoordelijk is, ook wanneer expertise buiten Finable ligt.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Kan Finable later meer of minder werkzaamheden overnemen?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Ja. De verdeling waarmee we beginnen hoeft niet permanent te zijn. Wanneer je organisatie groeit, werkzaamheden complexer worden of intern juist nieuwe finance-capaciteit wordt opgebouwd, kunnen we opnieuw kijken naar de verdeling. Finable kan dan meer werkzaamheden overnemen, maar ook werkzaamheden terug overdragen wanneer dat beter past bij de nieuwe situatie. Het uitgangspunt is dat de inrichting blijft aansluiten op wat de organisatie daadwerkelijk nodig heeft.</p></div></details>
          </div>
          <div data-faq-morewrap style="margin-top:26px">
            <a href="#" data-faq-more style="font-weight:600;font-size:15px;color:var(--terracotta)">Bekijk alle veelgestelde vragen &rarr;</a>
          </div>
        </div>
      </div>
      <div class="faq-note" style="width:140px;padding-top:60px;text-align:center;pointer-events:none">
        <div class="cav" style="font-size:22px">Meer vragen?</div>
        <svg width="60" height="70" viewBox="0 0 60 70" fill="none" style="margin:4px auto 0"><path d="M30 4C22 22 24 44 34 60" stroke="#C4643A" stroke-width="2" stroke-linecap="round"/><path d="M25 50l9 12 10-9" stroke="#C4643A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
  </section>

  <!-- PERSOONLIJK KENNISMAKEN -->
  <section class="wrap" style="padding-bottom:80px">
    <div style="border-top:1px solid var(--line);padding-top:56px">
      <div class="cta-p">
        <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt="Tim Samsom, oprichter Finable" width="800" height="699" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        <div>
          <div class="lbl" style="margin-bottom:16px">Persoonlijk kennismaken</div>
          <h2 style="font-size:clamp(24px,2.8vw,36px);line-height:1.1;margin-bottom:14px">Benieuwd of een finance-team bij jouw organisatie past?</h2>
          <p style="font-size:16px;color:var(--body);max-width:520px;text-wrap:pretty">Plan 30 minuten met Tim om te bespreken hoe je finance nu is georganiseerd en wat Finable daarin kan overnemen.</p>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:18px">
          <Button href="/gesprek">Plan een gesprek &rarr;</Button>
          <div style="font-size:14px;color:var(--body);line-height:1.45"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--navy)">Tim Samsom</span><br>Oprichter Finable</div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--terracotta);line-height:1.2}
  .hero-right{position:relative;display:grid;grid-template-columns:minmax(0,1fr) clamp(120px,14vw,178px);gap:28px;align-items:center}
  .disc{border-left:1px solid var(--line);padding-left:clamp(20px,2.4vw,36px);display:flex;flex-direction:column;gap:clamp(18px,2vw,26px)}
  .disc-row{display:flex;gap:16px;align-items:flex-start}
  .hero-still{height:clamp(250px,29vw,330px)}
  .hero-note{position:absolute;top:6px;left:52%;width:158px;text-align:center;pointer-events:none}
  .why{display:grid;grid-template-columns:minmax(0,0.82fr) minmax(0,1.2fr) minmax(0,0.82fr);gap:clamp(28px,3.4vw,52px);align-items:start}
  .why-cmp{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3vw,40px)}
  .cmp-col .ch{font-size:12px;font-weight:600;letter-spacing:0.18em;text-transform:uppercase;margin-bottom:6px}
  .cmp-col .cr{padding:14px 0;border-top:1px solid var(--line);font-size:15px;line-height:1.45}
  .navy{background:var(--navy)}
  .flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:20px;align-items:start}
  .flow .fn{font-family:'Playfair Display',serif;font-size:clamp(17px,1.5vw,20px);color:var(--white);margin-bottom:8px}
  .flow .fd{font-size:14px;color:var(--on-dark-secondary);line-height:1.5}
  .flow .fa{align-self:center;color:var(--terracotta)}
  .team{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,0.9fr);gap:clamp(36px,4.4vw,64px);align-items:center}
  .princ{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,2vw,26px);margin-top:40px}
  .collage{position:relative;height:clamp(340px,36vw,440px)}
  .cframe{position:absolute;border:6px solid var(--white);box-shadow:0 24px 48px -28px rgba(27,58,92,.45);overflow:hidden}
  .indic{background:var(--terracotta-soft);border-radius:10px;padding:clamp(28px,3.4vw,44px) clamp(28px,4vw,52px);display:grid;grid-template-columns:minmax(0,0.9fr) minmax(0,1fr) auto;gap:clamp(24px,3vw,44px);align-items:center}
  details.fin-faq{border-top:1px solid var(--line)}
  details.fin-faq:last-of-type{border-bottom:1px solid var(--line)}
  details.fin-faq>summary{list-style:none;cursor:pointer;display:flex;align-items:flex-start;justify-content:space-between;gap:30px;padding:24px 0}
  details.fin-faq>summary::-webkit-details-marker{display:none}
  .fin-faq-q{font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(17px,1.7vw,20px);color:var(--navy);line-height:1.35;letter-spacing:-0.01em}
  .fin-faq-ic{position:relative;width:17px;height:17px;flex-shrink:0;margin-top:6px}
  .fin-faq-ic::before,.fin-faq-ic::after{content:"";position:absolute;background:var(--terracotta);transition:opacity .2s}
  .fin-faq-ic::before{left:0;top:7.5px;width:17px;height:2px}
  .fin-faq-ic::after{left:7.5px;top:0;width:2px;height:17px}
  details.fin-faq[open] .fin-faq-ic::after{opacity:0}
  details.fin-faq>summary:hover .fin-faq-q{color:var(--terracotta)}
  .fin-faq-a{max-width:760px;padding:0 0 28px;font-size:15.5px;color:var(--body);line-height:1.72}
  .cta-p{display:grid;grid-template-columns:clamp(150px,18vw,220px) minmax(0,1fr) auto;gap:clamp(28px,3.4vw,48px);align-items:center}
  @media (max-width:1023px){
  .hero-right{grid-template-columns:1fr;gap:28px}
  .disc{border-left:none;padding-left:0}
  .hero-still{height:220px;order:-1}
  .hero-note{display:none}
  .why{grid-template-columns:1fr;gap:34px}
  .flow{grid-template-columns:1fr;gap:18px}
  .flow .fa{transform:rotate(90deg);justify-self:start}
  .team{grid-template-columns:1fr;gap:36px}
  .princ{grid-template-columns:1fr}
  .collage{height:400px}
  .indic{grid-template-columns:1fr;gap:22px}
  .cta-p{grid-template-columns:1fr;gap:24px}
  }
  /* Responsive (bouwopdracht §5): 1024 / 640 */
  @media (max-width:1023px){
    .hero{grid-template-columns:1fr!important;gap:40px!important}
    .disc{display:grid;grid-template-columns:1fr 1fr;gap:22px 24px}
    .why-cmp{gap:24px}
    .navy-end{grid-template-columns:1fr!important}
    .faq-grid{grid-template-columns:1fr!important}
    .faq-note{display:none}
    .cta-p>div:first-child{max-width:clamp(150px,18vw,220px)}
  }
  @media (max-width:639px){
    .disc{grid-template-columns:1fr}
    .why-cmp{grid-template-columns:1fr!important}
    .collage{height:auto}
    .collage .cframe{position:static;width:100%!important;transform:none!important;aspect-ratio:4/5}
    .collage .cframe:not(:first-child){display:none}
    .team-note{display:none}
    .indic>a{justify-self:start}
  }
</style>

<script>
  // "Bekijk alle veelgestelde vragen": toont de verborgen vragen.
  const btn = document.querySelector<HTMLAnchorElement>('[data-faq-more]');
  const hidden = document.querySelector<HTMLElement>('[data-faq-hidden]');
  const wrap = document.querySelector<HTMLElement>('[data-faq-morewrap]');
  if (btn && hidden) {
    btn.addEventListener('click', (e) => { e.preventDefault(); hidden.style.display = 'block'; if (wrap) wrap.style.display = 'none'; });
  }
</script>