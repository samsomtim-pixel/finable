---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
---
<Layout title="Finance-team — niet één finance-hire, een heel finance-team | Finable" description="Dagelijkse finance, afsluiting, controlling en rapportage vragen verschillende expertise. Finable brengt die samen in één vast finance-team met één aanspreekpunt.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header active="aanpak" />

  <!-- HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:72px">
    <div class="hero" style="display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,1.05fr);gap:clamp(36px,4.6vw,72px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:26px">Finance-team</div>
        <h1 style="font-size:clamp(38px,5vw,64px);line-height:1.04;margin-bottom:26px">Niet één finance-hire.<br><span class="em">Een heel finance-team.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:rgba(255,255,255,.78);max-width:480px;text-wrap:pretty">Dagelijkse finance, afsluiting, controlling en rapportage vragen verschillende expertise. Finable brengt die samen in één vast team.</p>
        <div style="display:flex;align-items:center;gap:18px;margin-top:30px">
          <span style="width:40px;height:2px;background:var(--terracotta);flex-shrink:0"></span>
          <span style="font-size:15px;font-weight:600;color:var(--white)">Een heel finance-team. Voor minder dan één controller.</span>
        </div>
      </div>

      <div class="hero-right">
        <div class="disc">
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 28 28" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><circle cx="14" cy="10" r="5"/><path d="M5 24c0-5 4-8 9-8s9 3 9 8"/></svg>
            <div><div class="dn">Dagelijkse finance</div><div class="dd">Verwerking &amp; administratie</div></div>
          </div>
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9h16M8 3v4M16 3v4M8 14h4"/></svg>
            <div><div class="dn">Maandafsluiting</div><div class="dd">Afsluiting &amp; controle</div></div>
          </div>
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></svg>
            <div><div class="dn">Controlling</div><div class="dd">Analyse &amp; afwijkingen</div></div>
          </div>
          <div class="disc-row">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" style="flex-shrink:0" aria-hidden="true"><path d="M4 20h16"/><rect x="6" y="11" width="3" height="6"/><rect x="11" y="7" width="3" height="10"/><rect x="16" y="13" width="3" height="4"/></svg>
            <div><div class="dn">Rapportage &amp; inzicht</div><div class="dd">Rapportage &amp; duiding</div></div>
          </div>
        </div>
        <div class="hero-note">
          <div class="cav" style="font-size:22px">Je hoeft dit dus niet in één persoon te vinden.</div>
          <svg width="72" height="54" viewBox="0 0 72 54" fill="none" style="margin:2px auto 0" aria-hidden="true"><path d="M60 6C50 30 30 42 8 40" stroke="#C4643A" stroke-width="2" stroke-linecap="round"/><path d="M16 30l-9 11 14 3" stroke="#C4643A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- WAAROM EEN TEAM -->
  <section class="wrap" style="padding-top:64px;padding-bottom:80px">
    <div class="why">
      <div>
        <div class="lbl" style="margin-bottom:20px">Waarom een team?</div>
        <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px">Eén persoon hoeft niet alles te kunnen.</h2>
        <p style="font-size:16px;color:var(--body);text-wrap:pretty">Finance vraagt om verschillende disciplines. Toch komen die in groeiende bedrijven vaak samen in één functieprofiel.</p>
      </div>
      <!-- Mobiel (≤639): dezelfde vergelijking per onderwerp onder elkaar. -->
      <div class="cmp-m">
        <div class="cmp-m-pair"><div class="cmp-m-row"><span class="cmp-m-k">Eén finance-hire</span><span class="cmp-m-v">Eén functieprofiel</span></div><div class="cmp-m-row is-fin"><span class="cmp-m-k">Finable-team</span><span class="cmp-m-v">Verschillende expertises</span></div></div>
        <div class="cmp-m-pair"><div class="cmp-m-row"><span class="cmp-m-k">Eén finance-hire</span><span class="cmp-m-v">Capaciteit van één persoon</span></div><div class="cmp-m-row is-fin"><span class="cmp-m-k">Finable-team</span><span class="cmp-m-v">Capaciteit van een team</span></div></div>
        <div class="cmp-m-pair"><div class="cmp-m-row"><span class="cmp-m-k">Eén finance-hire</span><span class="cmp-m-v">Kennis bij één persoon</span></div><div class="cmp-m-row is-fin"><span class="cmp-m-k">Finable-team</span><span class="cmp-m-v">Kennis verdeeld in het team</span></div></div>
        <div class="cmp-m-pair"><div class="cmp-m-row"><span class="cmp-m-k">Eén finance-hire</span><span class="cmp-m-v">Eén beschikbaarheid</span></div><div class="cmp-m-row is-fin"><span class="cmp-m-k">Finable-team</span><span class="cmp-m-v">Continuïteit binnen het team</span></div></div>
      </div>
      <div class="why-cmp">
        <div class="cmp-col">
          <div class="ch" style="color:var(--body)">Eén finance-hire</div>
          <div class="cr" style="color:var(--body)">Eén functieprofiel</div>
          <div class="cr" style="color:var(--body)">Capaciteit van één persoon</div>
          <div class="cr" style="color:var(--body)">Kennis bij één persoon</div>
          <div class="cr" style="color:var(--body)">Eén beschikbaarheid</div>
        </div>
        <div class="cmp-col">
          <div class="ch" style="color:var(--terracotta)">Finable-team</div>
          <div class="cr" style="color:var(--navy)">Verschillende expertises</div>
          <div class="cr" style="color:var(--navy)">Capaciteit van een team</div>
          <div class="cr" style="color:var(--navy)">Kennis verdeeld in het team</div>
          <div class="cr" style="color:var(--navy)">Continuïteit binnen het team</div>
        </div>
      </div>
      <div style="background:rgba(196,100,58,0.10);border-radius:0 40px 40px 40px;padding:clamp(28px,2.6vw,36px) clamp(26px,2.4vw,34px)">
        <p style="font-family:'Playfair Display',serif;font-size:clamp(19px,1.9vw,25px);color:var(--navy);line-height:1.3">Finance organiseren rond het werk dat nodig is. Niet rond één functieprofiel.</p>
        <span style="display:block;width:44px;height:3px;background:var(--terracotta);margin-top:22px;border-radius:2px"></span>
        <div style="margin-top:24px">
          <div class="lbl" style="margin-bottom:8px">Overweeg je iemand aan te nemen?</div>
          <p style="font-size:15px;color:var(--body);margin-bottom:8px">Vergelijk één finance-hire met een Finable-team.</p>
          <a href="/finance-hire" style="font-weight:600;font-size:15px;color:var(--terracotta)">Finance-hire of Finable? &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WAT HET TEAM DOET (navy anker) -->
  <section class="navy">
    <div class="wrap" style="padding-top:84px;padding-bottom:84px">
      <div style="max-width:640px;margin-bottom:48px">
        <div class="lbl" style="color:var(--terracotta);margin-bottom:20px">Wat het team doet</div>
        <h2 style="font-size:clamp(30px,3.6vw,46px);color:var(--white);margin-bottom:18px;line-height:1.08">Van dagelijkse finance tot rapportage &amp; inzicht.</h2>
        <p style="font-size:clamp(16px,1.35vw,18px);color:var(--on-dark-secondary);max-width:560px;text-wrap:pretty">Finable kan een deel overnemen of vrijwel je hele dagelijkse finance organiseren.</p>
      </div>
      <div class="flow">
        <div><div class="fn">Dagelijkse finance</div><div class="fd">Facturen · bank · debiteuren · payroll</div></div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="fn">Maandafsluiting</div><div class="fd">Aansluitingen · btw · maanddossier</div></div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="fn">Controlling</div><div class="fd">Marge · cash · afwijkingen</div></div>
        <svg class="fa" width="26" height="15" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg>
        <div><div class="fn">Rapportage &amp; inzicht</div><div class="fd">Rapportage · duiding · stakeholders</div></div>
      </div>
      <div style="height:1px;background:rgba(255,255,255,0.14);margin:52px 0 40px"></div>
      <div class="navy-end" style="display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(28px,3.4vw,56px);align-items:end">
        <h3 style="font-family:'Playfair Display',serif;font-size:clamp(24px,2.9vw,38px);color:var(--white);line-height:1.14">De juiste expertise voor ieder onderdeel. Eén team voor het geheel.</h3>
        <div>
          <p style="font-size:15px;color:var(--on-dark-secondary);margin-bottom:14px;text-wrap:pretty">Wat Finable precies overneemt, hangt af van wat er binnen je organisatie al staat.</p>
          <a href="/hoe-het-werkt" style="color:var(--terracotta);font-weight:600;font-size:15px">Zo werkt Finable &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- HET FINABLE-TEAM -->
  <section class="wrap" style="padding-top:80px;padding-bottom:40px">
    <div class="team">
      <div>
        <div class="lbl" style="margin-bottom:20px">Het Finable-team</div>
        <h2 style="font-size:clamp(28px,3.4vw,44px);line-height:1.08">Een vast team dat je organisatie leert kennen.</h2>
        <div class="princ">
          <div>
            <svg width="30" height="26" viewBox="0 0 40 34" fill="none" stroke="#C4643A" stroke-width="1.6" style="margin-bottom:16px" aria-hidden="true"><circle cx="20" cy="10" r="5"/><circle cx="8" cy="13" r="4"/><circle cx="32" cy="13" r="4"/><path d="M10 28c0-5 4.5-8 10-8s10 3 10 8"/></svg>
            <div class="lbl" style="color:var(--navy);margin-bottom:8px">Vast team</div>
            <p style="font-size:14px;color:var(--body);line-height:1.55">Geen wisselende bezetting.</p>
          </div>
          <div>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.6" style="margin-bottom:16px" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.4"/></svg>
            <div class="lbl" style="color:var(--navy);margin-bottom:8px">Passende expertise</div>
            <p style="font-size:14px;color:var(--body);line-height:1.55">Het juiste werk bij de juiste mensen.</p>
          </div>
          <div>
            <svg width="28" height="28" viewBox="0 0 26 24" fill="none" stroke="#C4643A" stroke-width="1.6" style="margin-bottom:16px" aria-hidden="true"><path d="M3 4h13v9H8l-4 3z"/><path d="M11 14v3h9l3 3v-9h-4"/></svg>
            <div class="lbl" style="color:var(--navy);margin-bottom:8px">Één aanspreekpunt</div>
            <p style="font-size:14px;color:var(--body);line-height:1.55">Je weet altijd wie je kunt bellen.</p>
          </div>
        </div>
      </div>
      <div style="position:relative">
        <div style="aspect-ratio:3/2;border-radius:14px;overflow:hidden"><img src="/images/finable-team.webp" alt="Het finance-team van Finable" width="1536" height="1024" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        <div class="team-note" style="margin-top:12px;text-align:right;pointer-events:none">
          <svg width="60" height="32" viewBox="0 0 66 40" fill="none" style="display:inline-block" aria-hidden="true"><path d="M8 32C20 14 40 8 58 12" stroke="#C4643A" stroke-width="2" stroke-linecap="round"/><path d="M50 6l9 6-7 8" stroke="#C4643A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="cav" style="font-size:22px">Het team achter Finable.</div>
        </div>
      </div>
    </div>
    <h3 style="font-family:'Playfair Display',serif;font-size:clamp(26px,3.6vw,46px);color:var(--navy);line-height:1.12;margin-top:clamp(48px,5vw,72px);max-width:920px;text-wrap:balance">De schaal van een team. De aandacht van een vaste finance-partner.</h3>
  </section>

  <!-- INDICATIE -->
  <section class="wrap" style="padding-top:40px;padding-bottom:64px">
    <div class="indic">
      <div>
        <div class="lbl" style="margin-bottom:14px">Indicatie</div>
        <p style="font-family:'Playfair Display',serif;font-size:clamp(20px,2.2vw,28px);color:var(--navy);line-height:1.2">Een heel finance-team. Voor minder dan één controller.</p>
      </div>
      <p style="font-size:16px;color:var(--body);text-wrap:pretty">De maandprijs hangt af van wat Finable overneemt, het volume en de complexiteit van je finance.</p>
      <Button href="/indicatie" size="sm" style="text-align:center">Bekijk je indicatie &rarr;</Button>
    </div>
  </section>

  <!-- FAQ + CTA (navy) -->
  <section class="faq-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:68px;padding-bottom:56px">
    <div class="ft-end" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,0.85fr);gap:clamp(40px,5vw,64px);align-items:start">
      <div>
        <div class="lbl" style="margin-bottom:28px">Veelgestelde vragen</div>
        <div style="max-width:900px">
          <details class="fin-faq"><summary><span class="fin-faq-q">Waarom werkt Finable met een team in plaats van één finance-professional?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finance bestaat uit werkzaamheden die verschillende soorten ervaring en expertise vragen. Dagelijkse verwerking, maandafsluiting, controle en rapportage en inzicht hoeven daarom niet allemaal bij één generalist te liggen. Finable organiseert die werkzaamheden als team. Daardoor kan het juiste niveau van expertise worden ingezet voor het werk dat nodig is, terwijl je als klant niet zelf verschillende specialisten hoeft aan te sturen. Je houdt één duidelijke samenwerking en één vast aanspreekpunt.</p></div></details>
          <details class="fin-faq"><summary><span class="fin-faq-q">Welke werkzaamheden kan het finance-team overnemen?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finable kan een breed deel van de operationele finance-functie verzorgen: van dagelijkse finance en maandafsluiting tot controlling en rapportage en inzicht. Welke werkzaamheden daadwerkelijk worden overgenomen, bepalen we per organisatie. We kijken naar wat er al goed loopt, waar capaciteit ontbreekt en welke werkzaamheden structureel beter georganiseerd moeten worden. Daardoor hoeft de samenwerking niet groter te zijn dan nodig, maar kan Finable wel meer overnemen wanneer daar later behoefte aan ontstaat.</p></div></details>
          <details class="fin-faq"><summary><span class="fin-faq-q">Hoe verschilt Finable van een boekhouder of accountant?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Een boekhouder richt zich doorgaans vooral op de administratie en een accountant heeft onder meer een rol rond jaarwerk en specialistische accountantswerkzaamheden. Finable is bedoeld voor organisaties die een breder deel van hun dagelijkse finance — verwerking, afsluiting, controlling en rapportage — structureel door een team willen laten uitvoeren. De keuze is daarom niet automatisch tussen Finable óf een accountant; de rollen kunnen naast elkaar bestaan wanneer dat voor de organisatie logisch is.</p></div></details>
          <details class="fin-faq"><summary><span class="fin-faq-q">Kan Finable ook slechts een deel van onze finance overnemen?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Ja. We beginnen bij de finance-organisatie die er al staat. Wanneer bepaalde onderdelen goed functioneren, is er geen reden om die alleen vanwege Finable te veranderen. We kunnen bijvoorbeeld starten waar capaciteit of expertise ontbreekt en de rest laten zoals het is. Als de organisatie groeit of de behoefte verandert, kan de verdeling opnieuw worden bekeken en kan Finable meer of juist minder werkzaamheden uitvoeren.</p></div></details>
          <div data-faq-hidden style="display:none">
            <details class="fin-faq"><summary><span class="fin-faq-q">Wie zit er in het team dat voor onze organisatie werkt?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Je werkt met een vast finance-team waarin verschillende financiële expertises beschikbaar zijn. De precieze samenstelling hangt af van de werkzaamheden die Finable voor je organisatie uitvoert. Het uitgangspunt is dat niet alle verantwoordelijkheid en kennis bij één persoon komt te liggen. Tegelijkertijd werken we niet als een verzameling losse freelancers die je zelf moet aansturen: Finable organiseert het team en zorgt voor een duidelijke verdeling van werkzaamheden en verantwoordelijkheden.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Wanneer is iemand in dienst of een interim controller logischer?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Iemand in dienst is logisch wanneer er voldoende structureel werk is voor een duidelijk afgebakende finance-rol die je bewust intern wilt opbouwen. Een interim controller past bij een tijdelijke capaciteitsbehoefte of een tijdelijk specialistisch vraagstuk. Finable is bedoeld voor organisaties die een breder deel van hun dagelijkse finance structureel door een team willen laten uitvoeren. De opties sluiten elkaar niet uit; ze passen bij verschillende situaties.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Wat doet Finable wel en wat niet?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finable richt zich op het structureel uitvoeren en organiseren van de operationele finance-functie: dagelijkse finance, maandafsluiting, controlling en rapportage en inzicht. Werkzaamheden waarvoor een specifieke externe bevoegdheid of specialistische expertise nodig is, zoals het ondertekenen van een jaarrekening of specialistisch fiscaal advies, vallen niet onder die kern. Waar nodig kan Finable wel aansluiten op de accountant, fiscalist of andere specialist die daarvoor verantwoordelijk is, zodat de verschillende onderdelen van finance goed op elkaar blijven aansluiten.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Hoe werkt Finable samen met accountants, fiscalisten en andere specialisten?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Finable richt zich op de operationele finance-functie. Voor accountancy, fiscaliteit of specifieke systeemvraagstukken werken we waar nodig samen met de verantwoordelijke specialist. We stemmen vooraf af wie welke werkzaamheden uitvoert, zodat de verschillende onderdelen van finance goed op elkaar aansluiten en verantwoordelijkheden helder blijven. Zo blijft duidelijk wie waarvoor verantwoordelijk is, ook wanneer expertise buiten Finable ligt.</p></div></details>
            <details class="fin-faq"><summary><span class="fin-faq-q">Kan Finable later meer of minder werkzaamheden overnemen?</span><span class="fin-faq-ic"></span></summary><div class="fin-faq-a"><p>Ja. De verdeling waarmee we beginnen hoeft niet permanent te zijn. Wanneer je organisatie groeit, werkzaamheden complexer worden of intern juist nieuwe finance-capaciteit wordt opgebouwd, kunnen we opnieuw kijken naar de verdeling. Finable kan dan meer werkzaamheden overnemen, maar ook werkzaamheden terug overdragen wanneer dat beter past bij de nieuwe situatie. Het uitgangspunt is dat de inrichting blijft aansluiten op wat de organisatie daadwerkelijk nodig heeft.</p></div></details>
          </div>
          <div data-faq-morewrap style="margin-top:26px">
            <a href="#" data-faq-more style="font-weight:600;font-size:15px;color:var(--terracotta)">Bekijk alle veelgestelde vragen &rarr;</a>
          </div>
        </div>
      </div>
      <div style="border-left:1px solid var(--on-dark-line);padding-left:clamp(28px,3vw,48px)">
        <div class="lbl" style="margin-bottom:20px">Persoonlijk kennismaken</div>
        <div class="tim-row" style="display:grid;grid-template-columns:clamp(120px,14vw,150px) minmax(0,1fr);gap:24px;align-items:center;margin-bottom:24px">
          <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt="Tim Samsom, oprichter Finable" width="800" height="699" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
          <div>
            <h2 style="font-size:clamp(21px,2.2vw,28px);line-height:1.12;margin-bottom:12px;color:var(--white)">Benieuwd of een finance-team bij jouw organisatie past?</h2>
            <p style="font-size:15px;color:var(--on-dark-secondary);text-wrap:pretty">Plan 30 minuten met Tim om te bespreken hoe je finance nu is georganiseerd en wat Finable daarin kan overnemen.</p>
          </div>
        </div>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:20px">
          <Button href="/gesprek">Plan een gesprek &rarr;</Button>
          <div style="font-size:14px;color:var(--on-dark-secondary);line-height:1.45"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">Tim Samsom</span><br>Oprichter Finable</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--terracotta);line-height:1.2}
  .hero-right{position:relative;display:grid;grid-template-columns:1fr;gap:28px;align-items:center}
  .disc{border-left:1px solid rgba(255,255,255,0.22);padding-left:clamp(20px,2.4vw,36px);display:flex;flex-direction:column;gap:clamp(18px,2vw,26px)}
  .disc-row{display:flex;gap:16px;align-items:flex-start}
  .disc .dn{font-family:'Playfair Display',serif;font-weight:600;font-size:17px;color:var(--white)}
