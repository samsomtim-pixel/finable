  .flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:20px;align-items:start}
  .flow .fn{font-family:'Playfair Display',serif;font-size:clamp(17px,1.5vw,20px);color:var(--white);margin-bottom:8px}
