---
import Base from '../layouts/Base.astro';
---
<Base
  title="Finable — een heel finance-team voor je groeiende bedrijf"
  description="Finable runt je dagelijkse finance met een vast team, voor één vaste maandprijs. Van boekhouding tot controlling en managementrapportage."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow">Een heel finance-team voor je groeiende bedrijf</p>
        <h1>Outsourced that feels like in&#8209;house.</h1>
        <p class="hero-sub">
          <strong>Een heel finance-team.</strong><br />
          <strong>Voor minder dan één controller.</strong>
        </p>
        <p class="hero-body">Finable runt je dagelijkse finance met een vast team, voor één vaste maandprijs. Van boekhouding tot controlling en managementrapportage.</p>
        <div class="hero-actions">
          <a href="/gesprek" class="btn btn-primary">Plan een gesprek →</a>
          <a href="/aanpak" class="btn btn-secondary">Bekijk onze aanpak</a>
        </div>
      </div>
      <div class="hero-visual" role="img" aria-label="Sfeerfoto werkplek"></div>
    </div>
  </section>

  <!-- Herkenning -->
  <section class="tint herkenning">
    <div class="container herkenning-grid">
      <div class="herkenning-head">
        <p class="eyebrow">Herken je dit?</p>
        <h2>Je bent niet de enige.</h2>
      </div>
      <div class="herkenning-cards">
        <div class="herkenning-card">
          <h3>Je finance-vacature blijft open.</h3>
          <p>Goede mensen zijn schaars en duur.</p>
        </div>
        <div class="herkenning-card">
          <h3>Finance hangt aan één persoon.</h3>
          <p>Te veel risico als iemand uitvalt.</p>
        </div>
        <div class="herkenning-card">
          <h3>Je stuurt te veel op gevoel.</h3>
          <p>Je mist actuele inzichten om te kunnen groeien.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zo werkt het -->
  <section class="mechanism">
    <div class="container">
      <div class="mech-head">
        <p class="eyebrow">Zo werkt het</p>
        <h2>Je dagelijkse finance.<br />Van uitvoering tot gesprek.</h2>
        <p>Eén vast team neemt het afgesproken werk over en brengt het in een vast maandelijks ritme.</p>
      </div>
      <div class="mech-flow">
        <div class="mech-step">
          <div class="mech-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 14l2 2 4-4"/></svg>
          </div>
          <strong>Uitvoeren</strong>
          <span>Dagelijkse finance</span>
        </div>
        <div class="mech-arrow" aria-hidden="true">→</div>
        <div class="mech-step">
          <div class="mech-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <strong>Afsluiten</strong>
          <span>Maandafsluiting en btw</span>
        </div>
        <div class="mech-arrow" aria-hidden="true">→</div>
        <div class="mech-step">
          <div class="mech-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 21H4.6c-.56 0-.84 0-1.054-.109a1 1 0 0 1-.437-.437C3 20.24 3 19.96 3 19.4V3"/><path d="m7 14 4-4 4 4 6-6"/></svg>
          </div>
          <strong>Controleren</strong>
          <span>Controlling</span>
        </div>
        <div class="mech-arrow" aria-hidden="true">→</div>
        <div class="mech-step">
          <div class="mech-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h8"/></svg>
          </div>
          <strong>Rapporteren</strong>
          <span>Managementrapportage</span>
        </div>
        <div class="mech-arrow" aria-hidden="true">→</div>
        <div class="mech-step">
          <div class="mech-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <strong>Bespreken</strong>
          <span>Maandgesprek</span>
        </div>
      </div>
      <div class="mech-footer">
        <p>We sluiten aan op wat er al staat en nemen over wat nodig is.</p>
        <a href="/aanpak" class="text-link">Bekijk onze aanpak →</a>
      </div>
    </div>
  </section>

  <!-- Vier manieren -->
  <section class="compare">
    <div class="container">
      <div class="compare-head">
        <div>
          <p class="eyebrow">Vier manieren om je finance te organiseren</p>
          <h2>Wat past bij jouw situatie?</h2>
        </div>
        <a href="/aanpak" class="text-link compare-link">Bekijk de volledige vergelijking →</a>
      </div>
      <div class="compare-grid">
        <div class="compare-card">
          <h3>Iemand aannemen</h3>
          <p>Dichtbij, maar afhankelijk van één persoon.</p>
        </div>
        <div class="compare-card">
          <h3>Een interimmer</h3>
          <p>Snel capaciteit, maar tijdelijk.</p>
        </div>
        <div class="compare-card">
          <h3>Accountant uitbreiden</h3>
          <p>Vertrouwd, maar niet ingericht op dagelijkse finance.</p>
        </div>
        <div class="compare-card compare-card--highlight">
          <h3>Finable</h3>
          <p>Een vast team dat de finance-functie overneemt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Klantcase -->
  <section class="tint testimonial">
    <div class="container testimonial-grid">
      <div class="testimonial-portrait" role="img" aria-label="Portret Sander de Klerk"></div>
      <div class="testimonial-content">
        <p class="testimonial-lead">Van sceptisch naar:</p>
        <blockquote>
          <p>&ldquo;Ik zou het iedereen aanraden.&rdquo;</p>
        </blockquote>
        <div class="testimonial-attr">
          <strong>Sander de Klerk</strong>
          <span>Founder, The Good Roll</span>
        </div>
      </div>
      <div class="testimonial-logo-col">
        <div class="testimonial-logo" role="img" aria-label="Logo The Good Roll"></div>
        <a href="/aanpak" class="text-link">Lees het hele verhaal →</a>
      </div>
    </div>
  </section>

  <!-- Waar je op kunt rekenen -->
  <section class="trust-points">
    <div class="container">
      <div class="trust-head">
        <p class="eyebrow">Waar je op kunt rekenen</p>
        <h2>Een samenwerking die met je meegroeit.</h2>
      </div>
      <div class="trust-grid">
        <div class="trust-card">
          <h3>Vast team</h3>
          <p>Je werkt met een vaste bezetting die je organisatie leert kennen.</p>
        </div>
        <div class="trust-card">
          <h3>Vast aanspreekpunt</h3>
          <p>Eén persoon die de samenwerking kent en met je bespreekt wat er speelt.</p>
        </div>
        <div class="trust-card">
          <h3>Controle in het proces</h3>
          <p>Inhoudelijke controles en reviews zijn onderdeel van het vaste werkproces.</p>
        </div>
        <div class="trust-card">
          <h3>Vaste maandprijs</h3>
          <p>Vooraf duidelijk wat binnen de afgesproken scope valt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container cta-grid">
      <div class="cta-portrait" role="img" aria-label="Portret Tim Samsom"></div>
      <div class="cta-headline">
        <p class="eyebrow" style="color: #C3CCD4;">Plan een gesprek</p>
        <h2 style="color: var(--white);">Laten we kijken wat Finable voor jouw bedrijf kan betekenen.</h2>
        <p class="cta-attr" style="color: #9FB0C0;">— Tim</p>
      </div>
      <div class="cta-body">
        <p style="color: #C3CCD4;">Vrijblijvend, in 30 minuten. Geen standaardverhaal, maar een eerlijk gesprek over jouw situatie.</p>
        <a href="/gesprek" class="btn btn-dark">Plan een gesprek →</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding: var(--space-xl) 0 var(--space-2xl); }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero h1 { margin-bottom: 16px; }
  .hero-sub {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--navy);
    line-height: 1.4;
    margin-bottom: 16px;
  }
  .hero-body {
    font-size: 1.0625rem;
    max-width: 480px;
    margin-bottom: 32px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-visual {
    aspect-ratio: 4/3;
    background: repeating-linear-gradient(135deg, #EAE3DA 0, #EAE3DA 1px, #F0EBE4 1px, #F0EBE4 12px);
    border-radius: var(--radius-lg);
  }

  /* Herkenning */
  .herkenning { padding: var(--space-xl) 0; }
  .herkenning-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 44px;
    align-items: start;
  }
  .herkenning-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }
  .herkenning-card {
    padding: 24px;
    border-left: 1px solid var(--line);
  }
  .herkenning-card:first-child { border-left: none; }
  .herkenning-card h3 {
    font-size: 1.125rem;
    margin-bottom: 8px;
  }
  .herkenning-card p { font-size: 0.9375rem; }

  /* Mechanism */
  .mechanism {
    background: var(--slate);
    border-radius: var(--radius-xl);
    margin: 0 var(--px);
    padding: var(--space-xl) 0;
  }
  .mech-head {
    text-align: center;
    margin-bottom: 48px;
  }
  .mech-head .eyebrow { color: #9FB0C0; }
  .mech-head h2 { color: var(--white); }
  .mech-head p { color: #C3CCD4; font-size: 1.0625rem; max-width: 540px; margin: 16px auto 0; }
  .mech-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    gap: 8px;
    align-items: start;
    margin-bottom: 40px;
  }
  .mech-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .mech-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: rgba(255,255,255,0.1);
    color: var(--white);
  }
  .mech-step strong { color: var(--white); font-size: 0.9375rem; }
  .mech-step span { color: #AEBAC6; font-size: 0.8125rem; }
  .mech-arrow {
    color: #AEBAC6;
    font-size: 1.25rem;
    padding-top: 12px;
  }
  .mech-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255,255,255,0.15);
    padding-top: 20px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .mech-footer p { color: #C3CCD4; font-size: 0.9375rem; }
  .mech-footer .text-link { color: var(--white); }
  .mech-footer .text-link:hover { color: #E0E5EA; }

  /* Compare */
  .compare { padding: var(--space-xl) 0; }
  .compare-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 32px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .compare-link { white-space: nowrap; }
  .compare-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .compare-card {
    padding: 28px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .compare-card h3 { font-size: 1.125rem; margin-bottom: 8px; }
  .compare-card p { font-size: 0.9375rem; }
  .compare-card--highlight {
    background: #F7E8DE;
    border-color: #E9C9B5;
  }

  /* Testimonial */
  .testimonial { padding: var(--space-xl) 0; }
  .testimonial-grid {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 40px;
    align-items: center;
  }
  .testimonial-portrait {
    width: 200px;
    height: 200px;
    border-radius: var(--radius-pill);
    background: repeating-linear-gradient(135deg, #DFD6CD 0, #DFD6CD 1px, #E8E1D8 1px, #E8E1D8 12px);
  }
  .testimonial-lead {
    font-size: 0.9375rem;
    color: var(--body-color);
    margin-bottom: 8px;
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--navy);
    line-height: 1.3;
    font-weight: 500;
  }
  .testimonial-attr {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .testimonial-attr strong { color: var(--navy); font-size: 0.9375rem; }
  .testimonial-attr span { font-size: 0.8125rem; }
  .testimonial-logo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .testimonial-logo {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    background: repeating-linear-gradient(135deg, #DFD6CD 0, #DFD6CD 1px, #E8E1D8 1px, #E8E1D8 12px);
  }

  /* Trust Points */
  .trust-points { padding: var(--space-xl) 0; }
  .trust-head { margin-bottom: 32px; }
  .trust-head h2 { max-width: 480px; }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .trust-card {
    padding: 28px;
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .trust-card h3 { font-size: 1.125rem; margin-bottom: 8px; }
  .trust-card p { font-size: 0.9375rem; }

  /* CTA Section */
  .cta-section {
    background: var(--navy);
    border-radius: var(--radius-xl);
    margin: 0 var(--px) var(--space-xl);
    padding: var(--space-xl) 0;
  }
  .cta-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 40px;
    align-items: center;
  }
  .cta-portrait {
    width: 100px;
    height: 100px;
    border-radius: var(--radius-pill);
    background: repeating-linear-gradient(135deg, #243F5F 0, #243F5F 1px, #2B486B 1px, #2B486B 12px);
  }
  .cta-attr { margin-top: 8px; }
  .cta-body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { max-width: 500px; }
    .herkenning-grid { grid-template-columns: 1fr; }
    .herkenning-cards { grid-template-columns: 1fr; }
    .herkenning-card { border-left: none; border-top: 1px solid var(--line); padding: 20px 0; }
    .herkenning-card:first-child { border-top: none; }
    .mech-flow { grid-template-columns: 1fr; gap: 16px; }
    .mech-arrow { display: none; }
    .mech-step { flex-direction: row; text-align: left; gap: 16px; }
    .compare-grid { grid-template-columns: 1fr 1fr; }
    .testimonial-grid { grid-template-columns: 1fr; }
    .testimonial-portrait { width: 120px; height: 120px; }
    .trust-grid { grid-template-columns: 1fr 1fr; }
    .cta-grid { grid-template-columns: 1fr; text-align: center; }
    .cta-portrait { margin: 0 auto; }
    .cta-body { align-items: center; }
    .mechanism { margin: 0; border-radius: 0; }
    .cta-section { margin: 0 0 var(--space-lg); border-radius: 0; }
  }

  @media (max-width: 640px) {
    .compare-grid { grid-template-columns: 1fr; }
    .trust-grid { grid-template-columns: 1fr; }
  }
</style>
