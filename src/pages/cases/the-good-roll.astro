---
// Klantcase The Good Roll. Implementatie van het goedgekeurde prototype
// (cases-the-good-roll-nav2 v2.dc.html) op de bestaande shell: Layout, Header, Footer, Button, tokens.
//
// Sander de Klerk heeft akkoord gegeven op naam, logo, foto en beide citaten (bevestigd 15-09-2026).
// Wijzig de citaten niet zonder nieuw akkoord; het zijn de enige klantquotes op de site.
//
// Geen cijfers, percentages, doorlooptijden of functietitels: alleen wat in het prototype staat.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';

const journey = [
  { title: 'Daily finance', desc: 'Administratie, AP/AR, betalingen' },
  { title: 'Close', desc: 'Maand- en jaarafsluiting' },
  { title: 'Control', desc: 'Processen, compliance, audit' },
  { title: 'Reporting', desc: 'Managementrapportages' },
  { title: 'Insight', desc: 'Analyse, duiding en advies' },
];

const regelt = [
  'Dagelijkse administratie (AP/AR, betalingen)',
  'Maand- en jaarafsluiting',
  'Managementrapportages en dashboards',
  'Ondersteuning bij control en compliance',
  'Actief meedenken over kostenbesparingen en financiële kansen',
  'Schaalbare capaciteit en extra expertise wanneer nodig',
];
// De vetgezette regel uit het prototype: de enige met extra nadruk.
const regeltEmphasis = 'Actief meedenken over kostenbesparingen en financiële kansen';

const controller = [
  'Eén persoon',
  'Eén expertiseprofiel',
  'Vaste capaciteit',
  'Operationeel én control op één bord',
  'Continuïteit afhankelijk van één rol',
  'Groei kan opnieuw een hire betekenen',
];

const finable = [
  'Eén vast aanspreekpunt',
  'Team van finance-professionals',
  'Verschillende expertises',
  'Capaciteit beweegt mee',
  'Continuïteit vanuit het team',
  'Geen finance-team zelf managen',
];

const waarom = [
  { n: '01', title: 'Snel operationeel', desc: 'Geen maanden zoeken, interviewen en onboarden. De benodigde finance-capaciteit kan snel worden georganiseerd.' },
  { n: '02', title: 'Een heel team. Zonder een hele payroll.', desc: 'Je hoeft niet voor iedere finance-behoefte een aparte medewerker aan te nemen. Je gebruikt de capaciteit en expertise die op dat moment nodig is.' },
  { n: '03', title: 'Zien waar geld blijft liggen', desc: 'We kijken niet alleen terug naar wat er is uitgegeven, maar signaleren ook waar kosten, marges, cashflow of processen aandacht verdienen.' },
  { n: '04', title: 'Cijfers mét duiding', desc: 'Geen rapportage zonder context. Je krijgt inzicht in wat er gebeurt, waarom het gebeurt en waar je mogelijk moet bijsturen.' },
  { n: '05', title: 'Expertise wanneer nodig', desc: 'Daily finance, close, control en reporting vragen niet altijd om hetzelfde profiel. Met Finable heb je toegang tot de expertise van het team.' },
  { n: '06', title: 'Capaciteit die meegroeit', desc: 'Meer finance nodig? Dan hoeft niet automatisch een nieuwe vacature open. De capaciteit kan meegroeien met de fase van het bedrijf.' },
];

const resultaat = [
  { title: 'Minder handwerk', desc: 'Processen slimmer ingericht' },
  { title: 'Sneller inzicht', desc: 'Managementinformatie wanneer nodig' },
  { title: 'Betere financiële duiding', desc: 'Zicht op kosten, marges, cashflow en financiële kansen' },
  { title: 'Schaalbare capaciteit', desc: 'Meegroeien zonder telkens een nieuwe hire' },
];
---
<Layout
  title="The Good Roll × Finable | Finance die meegroeit"
  description="Bekijk hoe Finable The Good Roll ondersteunt met dagelijkse finance, afsluiting, reporting en toegang tot een schaalbaar finance-team."
  breadcrumbs={[{ name: 'Finable', path: '/' }, { name: 'The Good Roll' }]}
>
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- HERO (navy) -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:52px;padding-bottom:64px">
    <div class="case-hero" style="display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,0.98fr);gap:clamp(36px,4.6vw,68px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:14px">Klantcase</div>
        <div style="font-size:15px;color:var(--on-dark-tertiary);margin-bottom:26px">The Good Roll <span style="color:var(--terracotta)">&times;</span> Finable</div>
        <h1 style="font-size:clamp(38px,5vw,62px);line-height:1.04;margin-bottom:24px">Finance die meegroeit. <span class="em">Zonder een heel team aan te nemen.</span></h1>
        <p style="font-size:clamp(17px,1.7vw,20px);color:var(--on-dark-secondary);max-width:500px;text-wrap:pretty">The Good Roll focust op impact en groei. Finable zorgt dat finance goed geregeld is, met één vast aanspreekpunt en toegang tot een compleet finance-team.</p>
        <div style="margin-top:32px"><Button href="/gesprek">Plan een gesprek &rarr;</Button></div>
      </div>
      <div style="position:relative">
        <div style="aspect-ratio:4/3;border-radius:16px;overflow:hidden"><img src="/images/sander-the-good-roll.webp" alt="Sander de Klerk van The Good Roll" width="1200" height="711" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;display:block"></div>
        <div class="hero-note" style="position:absolute;right:-8px;top:-30px;width:150px;text-align:center;pointer-events:none">
          <div class="cav" style="font-size:22px">Minder finance-gedoe. Meer ruimte om te groeien.</div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- PROOF STRIP -->
  <section class="wrap" style="padding-top:40px;padding-bottom:8px">
    <div class="proof-grid" style="border-bottom:1px solid var(--line);padding-bottom:40px;display:grid;grid-template-columns:auto minmax(0,1.35fr) 1px minmax(0,0.85fr);gap:clamp(18px,3vw,40px);align-items:center">
      <div style="width:74px;height:74px;border-radius:999px;overflow:hidden;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--white);border:1px solid var(--line)"><img src="/images/the-good-roll.png" alt="Logo The Good Roll" width="662" height="663" style="width:70%;height:70%;object-fit:contain;display:block"></div>
      <div>
        <blockquote style="font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(19px,2vw,25px);color:var(--navy);line-height:1.3;margin:0 0 12px;text-wrap:balance">&ldquo;We begonnen klein. Inmiddels doet Finable vrijwel onze hele dagelijkse finance.&rdquo;</blockquote>
        <div style="font-size:14px;color:var(--body)"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--navy)">Sander de Klerk</span> &middot; The Good Roll</div>
      </div>
      <div class="proof-div" style="background:var(--line);align-self:stretch"></div>
      <p style="font-size:15px;color:var(--body);line-height:1.6;text-wrap:pretty">Zo kan The Good Roll zich focussen op impact en groei, terwijl de dagelijkse finance goed geregeld is.</p>
    </div>
  </section>

  <!-- DE UITDAGING -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div style="max-width:760px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">De uitdaging</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px;text-wrap:balance">Groei maakt finance vanzelf complexer.</h2>
      <p style="font-size:17px;color:var(--body);line-height:1.7;text-wrap:pretty">Meer omzet betekent meer transacties, meer leveranciers, meer rapportages, meer controles en meer vragen vanuit het management. Op een gegeven moment heb je niet alleen iemand nodig die de administratie doet. Je hebt verschillende soorten finance-expertise nodig.</p>
    </div>
    <div>
      <div class="journey" style="display:flex;flex-wrap:wrap;gap:14px;align-items:stretch">
        {journey.map((step, i) => (
          <>
            <div style="flex:1 1 150px;min-width:150px;background:var(--section);border-radius:14px;padding:26px 22px">
              <div style="margin-bottom:16px">
                {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 14h5"/></svg>}
                {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M9 14l2 2 4-4"/></svg>}
                {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>}
                {i === 3 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><rect x="8" y="12" width="3" height="5"/><rect x="13" y="8" width="3" height="9"/><rect x="18" y="14" width="0.5" height="3"/></svg>}
                {i === 4 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="10" r="6"/><path d="M9 20h6M10 22h4M12 4v1M12 10l2.5-2.5"/></svg>}
              </div>
              <div style="font-family:'Playfair Display',serif;font-weight:600;font-size:18px;color:var(--navy);margin-bottom:6px">{step.title}</div>
              <div style="font-size:13px;color:var(--body);line-height:1.5">{step.desc}</div>
            </div>
            {i < journey.length - 1 && (
              <div class="jarrow" style="display:flex;align-items:center;flex:0 0 auto"><svg width="22" height="14" viewBox="0 0 30 18" fill="none" stroke="#C4643A" stroke-width="2" aria-hidden="true"><path d="M0 9h24M18 2l8 7-8 7"/></svg></div>
            )}
          </>
        ))}
      </div>
      <div class="case-note" style="text-align:right;margin-top:20px;pointer-events:none">
        <span class="cav" style="font-size:21px">Van meer transacties naar meer inzicht.</span>
      </div>
    </div>
  </section>

  <!-- WAT FINABLE REGELT (navy, primair) + EEN EXTRA FINANCE-HIRE? (licht, secundair) -->
  <section style="background:var(--white)">
    <div class="wrap" style="padding-top:88px;padding-bottom:88px">
    <div class="sol-grid" style="display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(40px,4.4vw,58px);align-items:start">
      <div>
        <div class="sol-navy" style="background:var(--navy);border-radius:20px;padding:clamp(30px,3.4vw,44px)">
          <div class="lbl" style="margin-bottom:18px">Wat Finable voor The Good Roll regelt</div>
          <h2 style="font-size:clamp(27px,3.3vw,40px);color:var(--warm-white);margin-bottom:18px;text-wrap:balance">Van inboeken naar een complete finance-functie.</h2>
          <p style="font-size:16px;color:var(--on-dark-secondary);line-height:1.7;margin-bottom:22px;text-wrap:pretty">We begonnen klein, met de dagelijkse administratie. Inmiddels runt Finable vrijwel de hele dagelijkse finance van The Good Roll, met één vast aanspreekpunt en een team erachter.</p>
          <div class="sol-list">
            {regelt.map((item) => (
              <div>
                <span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="rgba(196,100,58,0.12)"/><path d="M5 9.3l2.6 2.6L13 6.5" stroke="#C4643A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span class:list={[item === regeltEmphasis && 'is-key']}>{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="sol-right">
        <h2 style="font-size:clamp(21px,2.3vw,27px);line-height:1.2;margin-bottom:12px;text-wrap:balance">Een extra finance-hire? Of eerst kijken wat je écht nodig hebt?</h2>
        <p style="font-size:15px;color:var(--body);line-height:1.6;margin-bottom:24px;text-wrap:pretty">Soms is een Financial Controller de juiste keuze. Soms is een team een betere oplossing. Finable kan beide scenario's ondersteunen.</p>
        <div class="vs-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
          <div class="vs-card vs-hire">
            <div class="vs-head">1 Financial Controller</div>
            {controller.map((item) => (
              <div>
                <span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="8" stroke="#C4643A" stroke-opacity="0.45" stroke-width="1.4"/><path d="M6.3 6.3l5.4 5.4M11.7 6.3l-5.4 5.4" stroke="#C4643A" stroke-opacity="0.75" stroke-width="1.5" stroke-linecap="round"/></svg></span>
                <span>{item}</span>
              </div>
            ))}
          </div>
          <div class="vs-card vs-fin">
            <div class="vs-head">Finable</div>
            {finable.map((item) => (
              <div>
                <span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="9" fill="rgba(196,100,58,0.12)"/><path d="M5 9.3l2.6 2.6L13 6.5" stroke="#C4643A" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                <span>{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="vs-note" style="text-align:right;margin-top:22px;pointer-events:none"><span class="cav" style="font-size:21px">Laat je controller controller zijn.</span></div>
      </div>
    </div>
    </div>
  </section>

  <!-- WAAROM DIT MODEL -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div style="max-width:760px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">Waarom dit model</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px;text-wrap:balance">Finance die niet alleen klopt, maar je bedrijf vooruithelpt.</h2>
      <p style="font-size:17px;color:var(--body);line-height:1.7;text-wrap:pretty">Goede finance gaat niet alleen over correcte cijfers. Het gaat erom dat je snel weet waar je staat, begrijpt wat er gebeurt en ziet waar je kunt bijsturen.</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
      {waarom.map((w, i) => (
        <div style="background:var(--white);border:1px solid var(--line);border-radius:14px;padding:30px 28px">
          <div style="margin-bottom:16px">
            {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>}
            {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 19c0-3.3 2.7-5 6-5s6 1.7 6 5"/><path d="M16 5.5a3 3 0 010 5.5M17 19c0-2.3-.7-3.8-2-4.7"/></svg>}
            {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M11 8v6M8 11h6M20 20l-3.5-3.5"/></svg>}
            {i === 3 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><path d="M8 15l3-3 3 2 4-6"/></svg>}
            {i === 4 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M2 19c0-3.3 2.5-5 6-5s6 1.7 6 5"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 19c0-2.5 1-4 2.5-4s2.9 1.2 3 3.5"/></svg>}
            {i === 5 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20L20 4M20 4h-7M20 4v7"/></svg>}
          </div>
          <div style="font-family:'Playfair Display',serif;font-size:15px;color:var(--terracotta);line-height:1;margin-bottom:12px">{w.n}</div>
          <h3 style="font-size:20px;margin-bottom:10px">{w.title}</h3>
          <p style="font-size:15px;color:var(--body);line-height:1.6">{w.desc}</p>
        </div>
      ))}
    </div>
    <div class="case-note" style="text-align:right;margin-top:24px;pointer-events:none"><span class="cav" style="font-size:21px">Meer inzicht. Minder gedoe. Betere beslissingen.</span></div>
  </section>

  <!-- HET RESULTAAT -->
  <section class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div style="max-width:720px;margin-bottom:44px">
      <div class="lbl" style="margin-bottom:18px">Het resultaat</div>
      <h2 style="font-size:clamp(28px,3.4vw,42px);margin-bottom:20px;text-wrap:balance">Meer rust. Meer inzicht. Meer ruimte om te groeien.</h2>
      <p style="font-size:16px;color:var(--body);line-height:1.7;text-wrap:pretty">Met Finable heeft The Good Roll een finance-organisatie die meebeweegt met de ambities van het bedrijf. Een schaalbaar team dat zorgt voor structuur, inzicht en continuïteit.</p>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:18px">
      {resultaat.map((r, i) => (
        <div style="flex:1 1 190px;min-width:190px;background:var(--white);border:1px solid var(--line);border-radius:14px;padding:26px 24px">
          <div style="margin-bottom:16px">
            {i === 0 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><path d="M8 16l3-3 3 2 4-5"/></svg>}
            {i === 1 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>}
            {i === 2 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="9" r="3.2"/><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/><path d="M16 6.5a3 3 0 010 6M18 19c0-2.2-.8-3.6-2-4.5"/></svg>}
            {i === 3 && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C4643A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20L20 4M20 4h-7M20 4v7"/></svg>}
          </div>
          <div style="font-family:'Playfair Display',serif;font-weight:600;font-size:18px;color:var(--navy);margin-bottom:6px">{r.title}</div>
          <div style="font-size:14px;color:var(--body);line-height:1.55">{r.desc}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- QUOTE (navy) -->
  <section style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:76px">
    <div class="quote-grid" style="display:grid;grid-template-columns:clamp(170px,22vw,260px) minmax(0,1fr);gap:clamp(30px,4vw,60px);align-items:center">
      <div style="aspect-ratio:1/1;border-radius:16px;overflow:hidden"><img src="/images/sander-the-good-roll.webp" alt="Sander de Klerk van The Good Roll" width="1200" height="711" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
      <div>
        <blockquote style="font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(22px,2.7vw,36px);color:var(--warm-white);line-height:1.28;margin:0 0 24px;text-wrap:balance">&ldquo;Ik was in het begin sceptisch, maar we zijn klein begonnen met alleen het inboeken. Nu doet Finable vrijwel onze hele dagelijkse finance. <span style="color:var(--terracotta)">Ik zou het iedereen aanraden.</span>&rdquo;</blockquote>
        <div style="font-size:15px;color:var(--on-dark-secondary);line-height:1.5"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">Sander de Klerk</span><br>The Good Roll</div>
      </div>
    </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:76px;padding-bottom:84px">
    <div class="fcta-grid" style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,0.7fr);gap:clamp(32px,4vw,56px);align-items:center">
      <div>
        <div class="lbl" style="margin-bottom:18px">Ook toe aan de volgende stap?</div>
        <h2 style="font-size:clamp(26px,3.2vw,40px);color:var(--warm-white);margin-bottom:20px;text-wrap:balance">Jouw bedrijf groeit. Je finance-functie hoeft niet in hetzelfde tempo in headcount te groeien.</h2>
        <p style="font-size:16px;color:var(--on-dark-secondary);max-width:560px;text-wrap:pretty">Overweeg je een Financial Controller, Finance Manager of extra finance-capaciteit? Dan kunnen we beide scenario's eens naast elkaar leggen.</p>
      </div>
      <div style="display:flex;flex-direction:column;align-items:flex-start;gap:20px">
        <Button href="/gesprek">Plan een gesprek &rarr;</Button>
        <span class="cav" style="font-size:22px">Finance geregeld. Door met groeien.</span>
      </div>
    </div>
    </div>
  </section>

  <Footer />

