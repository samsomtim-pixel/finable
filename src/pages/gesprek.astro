---
import Base from '../layouts/Base.astro';
---
<Base
  title="Plan een gesprek — Finable"
  description="Vrijblijvend, in 30 minuten. Geen standaardverhaal, maar een eerlijk gesprek over jouw situatie."
>
  <section class="gesprek-hero">
    <div class="container gesprek-grid">
      <div class="gesprek-content">
        <p class="eyebrow">Plan een gesprek</p>
        <h1>Laten we kijken wat Finable voor jouw bedrijf kan betekenen.</h1>
        <p class="gesprek-body">Vrijblijvend, in 30 minuten. Geen standaardverhaal, maar een eerlijk gesprek over jouw situatie.</p>
      </div>
      <div class="gesprek-card">
        <form class="gesprek-form" id="gesprek-form">
          <div class="gesprek-field">
            <label for="g-naam">Je naam</label>
            <input type="text" id="g-naam" name="naam" placeholder="Voor- en achternaam" required />
          </div>
          <div class="gesprek-field">
            <label for="g-email">Zakelijk e-mailadres</label>
            <input type="email" id="g-email" name="email" placeholder="jij@bedrijf.nl" required />
          </div>
          <div class="gesprek-field">
            <label for="g-telefoon">Telefoonnummer <span class="gesprek-optional">(optioneel)</span></label>
            <input type="tel" id="g-telefoon" name="telefoon" placeholder="06 …" />
          </div>
          <div class="gesprek-field">
            <label for="g-bedrijf">Bedrijf</label>
            <input type="text" id="g-bedrijf" name="bedrijf" placeholder="Naam van je organisatie" required />
          </div>
          <div class="gesprek-field">
            <label for="g-bericht">Waar wil je het over hebben? <span class="gesprek-optional">(optioneel)</span></label>
            <textarea id="g-bericht" name="bericht" rows="3" placeholder="Vertel kort waar je tegenaan loopt."></textarea>
          </div>
          <div class="gesprek-hp" aria-hidden="true">
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <p class="gesprek-privacy">We gebruiken je gegevens alleen om contact op te nemen over je gesprek.</p>
          <div class="gesprek-error" id="gesprek-error" hidden>
            Er ging iets mis. Mail ons op <a href="mailto:tim@finable.nl">tim@finable.nl</a>.
          </div>
          <button type="submit" class="btn btn-primary gesprek-submit" id="gesprek-submit">Verstuur →</button>
        </form>
        <div class="gesprek-done" id="gesprek-done" hidden>
          <h2>Dank je.</h2>
          <p>Tim neemt zo snel mogelijk contact met je op.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="container gesprek-trust">
      <div class="gesprek-trust-item">
        <strong>Vrijblijvend</strong>
        <p>Geen verplichtingen, geen verkooppraatje.</p>
      </div>
      <div class="gesprek-trust-item">
        <strong>30 minuten</strong>
        <p>Kort en to the point.</p>
      </div>
      <div class="gesprek-trust-item">
        <strong>Persoonlijk</strong>
        <p>Je spreekt direct met Tim.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .gesprek-hero { padding: var(--space-xl) 0 var(--space-2xl); }
  .gesprek-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .gesprek-content { padding-top: 32px; }
  .gesprek-content h1 { margin-bottom: 16px; }
  .gesprek-body { font-size: 1.0625rem; max-width: 440px; }

  .gesprek-card {
    background: var(--white);
    border: 1px solid #EEE9E3;
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 50px -30px rgba(44,62,80,.35);
    padding: clamp(28px, 3.5vw, 44px);
  }
  .gesprek-field { margin-bottom: 20px; }
  .gesprek-field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--navy);
    display: block;
    margin-bottom: 8px;
  }
  .gesprek-optional { font-weight: 400; color: var(--body-color); }
  .gesprek-field input,
  .gesprek-field textarea {
    width: 100%;
    padding: 13px 16px;
    border-radius: 10px;
    border: 1.5px solid #E6E1DB;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--navy);
    background: transparent;
    outline: none;
    resize: vertical;
    transition: border-color 0.2s;
  }
  .gesprek-field input:focus,
  .gesprek-field textarea:focus {
    border-color: var(--terracotta);
    box-shadow: 0 0 0 2px rgba(196,100,58,0.15);
  }
  .gesprek-field input::placeholder,
  .gesprek-field textarea::placeholder { color: #9AA0A6; }
  .gesprek-hp { position: absolute; left: -9999px; }
  .gesprek-privacy { font-size: 0.8125rem; color: #8A94A0; margin-bottom: 20px; }
  .gesprek-error {
    padding: 14px 18px;
    background: #FBEDE6;
    border: 1px solid #E9C9B5;
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: #B2532B;
    margin-bottom: 16px;
  }
  .gesprek-error a { text-decoration: underline; }
  .gesprek-submit { width: 100%; justify-content: center; }

  .gesprek-done h2 { margin-bottom: 12px; }

  .gesprek-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: var(--space-lg) 0;
  }
  .gesprek-trust-item {
    text-align: center;
    padding: 24px;
  }
  .gesprek-trust-item strong { color: var(--navy); font-size: 1rem; display: block; margin-bottom: 4px; }
  .gesprek-trust-item p { font-size: 0.875rem; }

  @media (max-width: 1024px) {
    .gesprek-grid { grid-template-columns: 1fr; }
    .gesprek-content { padding-top: 0; }
  }
  @media (max-width: 640px) {
    .gesprek-trust { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.getElementById('gesprek-form') as HTMLFormElement;
  const done = document.getElementById('gesprek-done') as HTMLElement;
  const errEl = document.getElementById('gesprek-error') as HTMLElement;
  const submitBtn = document.getElementById('gesprek-submit') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errEl.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Bezig…';

    const data = Object.fromEntries(new FormData(form));
    if (data._gotcha) return;

    try {
      const res = await fetch('/api/gesprek', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        form.hidden = true;
        done.hidden = false;
      } else {
        errEl.hidden = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Verstuur →';
      }
    } catch {
      errEl.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Verstuur →';
    }
  });
</script>
