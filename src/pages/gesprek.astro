---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT_GESPREK ?? '';
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY ?? '';
// TODO: CONNECT REAL BOOKING PROVIDER — zet op true zodra echte beschikbaarheid uit de agenda-provider komt.
// Tot die tijd blijft de kalender verborgen: geen illustratieve data/tijden als echte beschikbaarheid tonen.
const bookingProviderConnected = false;
---
<Layout title="Plan een gesprek · Finable" description="Plan 30 minuten met Tim. We kijken hoe je finance nu is georganiseerd, waar het knelt en wat Finable eventueel kan overnemen.">
<div style="max-width:100%;overflow-x:hidden;background:var(--white)">

  <Header />

  <!-- De hele gesprekspagina staat op navy; de boekingskaart is wit. -->
  <section class="talk-navy hero-navy" style="background:var(--navy)">
    <div class="wrap" style="padding-top:56px;padding-bottom:72px">
    <div class="layout">

      <!-- LEFT -->
      <div class="talk-left">
        <div class="lbl" style="margin-bottom:20px">Plan een gesprek</div>
        <h1 style="font-size:clamp(32px,4.4vw,52px);margin-bottom:22px;text-wrap:balance">Laten we kijken hoe je finance <span class="em">er nu voor staat.</span></h1>
        <p style="font-size:clamp(16px,1.8vw,19px);color:var(--on-dark-secondary);max-width:500px;margin-bottom:44px;text-wrap:pretty">In 30 minuten bespreken we hoe je finance nu is georganiseerd, waar het knelt en wat Finable eventueel kan overnemen. Geen uitgebreide intake. Gewoon kijken of het past.</p>

        <div style="position:relative">
          <div style="position:absolute;left:9px;top:12px;bottom:60px;width:1px;background:var(--line)"></div>
          <div style="display:flex;flex-direction:column;gap:26px">
            <div style="display:flex;gap:20px">
              <span class="stepnum">01</span>
              <div><div class="st">Waar je nu staat</div><div class="sd">Hoe finance vandaag is georganiseerd en waar het knelt.</div></div>
            </div>
            <div style="display:flex;gap:20px">
              <span class="stepnum">02</span>
              <div><div class="st">Wat Finable kan overnemen</div><div class="sd">Van één onderdeel tot vrijwel je hele dagelijkse finance.</div></div>
            </div>
            <div style="display:flex;gap:20px">
              <span class="stepnum">03</span>
              <div><div class="st">Of het bij elkaar past</div><div class="sd">Een eerlijk beeld van wat logisch is, ook als Finable dat niet is.</div></div>
            </div>
          </div>
        </div>

        <div style="border-top:1px solid var(--on-dark-line);margin-top:36px;padding-top:26px;position:relative">
          <div style="font-size:15px;color:var(--on-dark-secondary);margin-bottom:8px">Liever eerst schrijven?</div>
          <a href="mailto:tim@finable.nl" style="display:inline-flex;align-items:center;gap:10px;font-family:'Playfair Display',serif;font-size:21px;color:var(--terracotta)">
            <svg width="20" height="20" viewBox="0 0 22 22" fill="none" stroke="#C4643A" stroke-width="1.6" aria-hidden="true"><rect x="2" y="4" width="18" height="14" rx="2"/><path d="M3 6l8 6 8-6"/></svg>
            tim@finable.nl &rarr;
          </a>
          <div class="mail-note" style="position:absolute;right:0;top:14px;width:130px;text-align:center;pointer-events:none">
            <div class="cav" style="font-size:21px">Direct contact met de oprichter.</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: BOOKING MODULE (wit op navy) -->
      <!-- TODO: CONNECT REAL BOOKING PROVIDER — data en tijden hieronder zijn illustratief tot de agenda-integratie is gekoppeld. -->
      <div class="book-card" style="background:var(--white);border:1px solid var(--line);border-radius:14px;padding:clamp(24px,3vw,34px)">
        <div data-booked hidden style="padding:8px 0">
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:22px"><svg width="26" height="26" viewBox="0 0 22 22" fill="none" stroke="#C4643A" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="9.5"/><path d="M6.5 11l3 3L15 8"/></svg><h2 style="font-size:26px;color:var(--navy)">Afgesproken.</h2></div>
            <p style="font-size:16px;color:var(--body);margin-bottom:22px">Je gesprek met Tim staat gepland.</p>
            <div style="border:1px solid var(--line);border-radius:12px;padding:22px 24px;margin-bottom:22px">
              <div style="font-family:'Playfair Display',serif;font-size:22px;color:var(--navy);margin-bottom:4px"><span data-booked-date></span></div>
              <div style="font-size:16px;color:var(--navy);margin-bottom:2px"><span data-booked-time></span></div>
              <div style="font-size:14px;color:var(--body)">30 minuten · met Tim Samsom</div>
            </div>
            <p style="font-size:14px;color:var(--body)">Je ontvangt de bevestiging en agenda-uitnodiging per e-mail.</p>
          </div>
          <div data-notbooked data-booking-endpoint={endpoint} data-access-key={accessKey} data-booking-disabled={!bookingProviderConnected}>
            <div class="book-split" style="display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;margin-bottom:26px">
              <div>
                <div class="lbl" style="margin-bottom:12px">Je spreekt met Tim</div>
                <h2 style="font-size:clamp(22px,2.4vw,28px);line-height:1.14;margin-bottom:8px;color:var(--navy)">Kies een moment dat uitkomt.</h2>
                <div style="font-size:15px;color:var(--body)">30 minuten · vrijblijvend</div>
              </div>
              <div style="width:84px;height:84px;border-radius:14px;overflow:hidden;flex-shrink:0"><img src="/images/tim-samsom.webp" alt="Tim Samsom, oprichter van Finable" width="800" height="699" style="width:100%;height:100%;object-fit:cover;display:block"></div>
            </div>

            <div style="height:1px;background:var(--line);margin-bottom:24px"></div>

            <!-- Tot de agenda-provider is gekoppeld: geen kalender, wel de mail-route. -->
            <p data-booking-notice hidden={bookingProviderConnected} style="font-size:15px;color:var(--body);text-wrap:pretty">Online een moment kiezen is nog niet beschikbaar. Mail <a href="mailto:tim@finable.nl" style="font-weight:600">tim@finable.nl</a>, dan plannen we samen een moment.</p>
            <div data-booking-ui hidden={!bookingProviderConnected}>
            <div style="font-size:14px;font-weight:600;color:var(--navy);margin-bottom:14px">Selecteer een datum en tijd</div>
            <div style="font-size:12px;color:var(--body);margin-bottom:8px"><span data-month-label></span></div>
            <div data-cal class="cal-grid" style="margin-bottom:22px" aria-label="Kies een datum"></div>

            <div data-slots-wrap hidden>
                <div style="font-size:13px;color:var(--body);margin-bottom:10px">Beschikbare tijden op <span style="color:var(--navy);font-weight:600"><span data-selected-date></span></span></div>
                <div data-slots style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:24px" aria-label="Kies een tijd"></div>
              </div>

            <button type="button" data-confirm disabled style="width:100%;background:var(--terracotta);color:var(--white);font-weight:600;font-size:16px;font-family:inherit;padding:15px;border:none;border-radius:999px;margin-top:4px;cursor:not-allowed;opacity:.45">Bevestig dit moment &rarr;</button>
            <p data-formerror style="display:none;font-size:14px;color:var(--terracotta);background:var(--terracotta-soft);border:1px solid rgba(196,100,58,0.35);border-radius:10px;padding:14px 16px;margin-top:16px">Er ging iets mis bij het versturen. Mail je aanvraag naar <a href="mailto:tim@finable.nl" style="font-weight:600">tim@finable.nl</a>, dan pakken we het op.</p>
            <div style="display:flex;align-items:center;gap:8px;justify-content:center;margin-top:14px">
              <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="#5F6B76" stroke-width="1.5" aria-hidden="true"><rect x="3" y="8" width="12" height="8" rx="1.5"/><path d="M6 8V6a3 3 0 016 0v2"/></svg>
              <span style="font-size:13px;color:var(--body)">Geen verplichtingen. Je ontvangt een bevestiging per e-mail.</span>
            </div>
            </div>
          </div>
      </div>

    </div>

    <div class="talk-foot" style="max-width:1240px;margin-top:28px;font-size:15px;color:var(--on-dark-secondary)">Liever eerst een prijsindicatie? <a href="/indicatie" style="font-weight:600">Bekijk de indicatie &rarr;</a></div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
  body{line-height:1.6}
  a{transition:opacity .15s}
  a:hover{opacity:.72}
  h1,h2,h3{line-height:1.12}
  .cav{font-family:'Caveat',cursive;font-weight:600;color:var(--terracotta);line-height:1.1}
  .layout{display:grid;grid-template-columns:minmax(0,1.02fr) minmax(0,0.98fr);gap:clamp(40px,4.6vw,64px);align-items:start}
  .stepnum{position:relative;z-index:1;width:20px;height:20px;border-radius:999px;background:rgba(196,100,58,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-family:'Playfair Display',serif;font-size:11px;font-weight:600;color:var(--terracotta);margin-top:2px}
  .talk-left .st{font-family:'Playfair Display',serif;font-weight:600;color:var(--white);font-size:19px;margin-bottom:3px}
  .talk-left .sd{font-size:15px;color:var(--on-dark-secondary)}
  .cal-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
  .cal-cell{display:flex;flex-direction:column;align-items:center;gap:3px;padding:10px 0;border:1px solid var(--line);border-radius:10px;background:var(--white);cursor:pointer;font-family:inherit;transition:border-color .12s,background .12s}
  .cal-cell:hover{border-color:var(--terracotta)}
  .cal-cell .dow{font-size:11px;color:var(--body);text-transform:uppercase;letter-spacing:.05em}
  .cal-cell .dnum{font-size:17px;font-weight:600;color:var(--navy)}
  .cal-cell.sel{background:var(--terracotta);border-color:var(--terracotta)}
  .cal-cell.sel .dow,.cal-cell.sel .dnum{color:var(--white)}
  .slot{padding:11px 8px;border:1px solid var(--line);border-radius:10px;background:var(--white);color:var(--navy);font-size:15px;font-family:inherit;font-weight:500;cursor:pointer;transition:border-color .12s,background .12s}
  .slot:hover{border-color:var(--terracotta)}
  .slot.sel{background:var(--terracotta);border-color:var(--terracotta);color:var(--white)}
  @media (max-width:1023px){
  .layout{grid-template-columns:1fr;gap:40px}
  .book-split{grid-template-columns:1fr!important}
  }
  /* Responsive (bouwopdracht §5): 1024 / 640 */
  @media (max-width:1023px){
    .layout{grid-template-columns:1fr!important;gap:40px!important}
    .book-split{grid-template-columns:1fr!important}
  }
  @media (max-width:639px){
    .mail-note{display:none}
    .cal-cell{min-height:48px}
    .cal-grid{grid-template-columns:repeat(auto-fill,minmax(44px,1fr))}
    /* Volgorde: intro → 01–03 → Tim/boeking → direct contact */
    .layout{display:flex!important;flex-direction:column;gap:0!important}
    .layout>div:first-child{display:contents}
    .layout>div:first-child>div:last-child{order:2}
    .layout>div:last-child{order:1;margin-top:36px}
    .book-split{grid-template-columns:1fr auto!important;gap:16px!important}
  }
</style>

<script>
  // Boekingsmodule (vanilla JS). TODO: CONNECT REAL BOOKING PROVIDER — weekdagen en tijden zijn illustratief
  // tot de agenda-integratie is gekoppeld. Bevestiging alleen na een succesvolle response.
  const root = document.querySelector<HTMLElement>('[data-notbooked]');
  const bookedEl = document.querySelector<HTMLElement>('[data-booked]');
  if (root && bookedEl && root.dataset.bookingDisabled !== 'true') {
    const calEl = root.querySelector<HTMLElement>('[data-cal]')!;
    const slotsWrap = root.querySelector<HTMLElement>('[data-slots-wrap]')!;
    const slotsEl = root.querySelector<HTMLElement>('[data-slots]')!;
    const confirmBtn = root.querySelector<HTMLButtonElement>('[data-confirm]')!;
    const err = root.querySelector<HTMLElement>('[data-formerror]');
    const monthEl = root.querySelector<HTMLElement>('[data-month-label]')!;
    const selEl = root.querySelector<HTMLElement>('[data-selected-date]')!;

    let dateIdx: number | null = null;
    let time: string | null = null;

    const DOW = ['zo','ma','di','wo','do','vr','za'];
    const days = () => {
      const out: { dow: string; dnum: number; date: Date }[] = [];
      const d = new Date(); d.setHours(0, 0, 0, 0);
      while (out.length < 10) {
        d.setDate(d.getDate() + 1);
        const wd = d.getDay();
        if (wd >= 1 && wd <= 5) out.push({ dow: DOW[wd] ?? '', dnum: d.getDate(), date: new Date(d) });
      }
      return out;
    };
    const times = () => ['09:00','09:30','11:00','13:30','15:00','16:30'];
    const fmt = (date: Date) => {
      const MO = ['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
      const DOWF = ['zondag','maandag','dinsdag','woensdag','donderdag','vrijdag','zaterdag'];
      return DOWF[date.getDay()] + ' ' + date.getDate() + ' ' + MO[date.getMonth()];
    };
    const DAYS = days();

    const render = () => {
      const chosen = dateIdx != null ? DAYS[dateIdx] : null;
      const ready = !!(chosen && time);
      const first = DAYS[0], last = DAYS[DAYS.length - 1];
      monthEl.textContent = first && last ? (first.date.getMonth() === last.date.getMonth()
        ? first.date.toLocaleDateString('nl-NL', { month: 'long', year: 'numeric' })
        : first.date.toLocaleDateString('nl-NL', { month: 'short' }) + ' – ' + last.date.toLocaleDateString('nl-NL', { month: 'short', year: 'numeric' })) : '';
      calEl.innerHTML = '';
      DAYS.forEach((day, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cal-cell' + (dateIdx === i ? ' sel' : '');
        b.setAttribute('aria-pressed', dateIdx === i ? 'true' : 'false');
        b.setAttribute('aria-label', fmt(day.date));
        b.innerHTML = '<span class="dow">' + day.dow + '</span><span class="dnum">' + day.dnum + '</span>';
        b.onclick = () => { dateIdx = i; time = null; render(); };
        calEl.appendChild(b);
      });
      slotsWrap.hidden = !chosen;
      selEl.textContent = chosen ? fmt(chosen.date) : '';
      slotsEl.innerHTML = '';
      times().forEach((t) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'slot' + (time === t ? ' sel' : '');
        b.setAttribute('aria-pressed', time === t ? 'true' : 'false');
        b.textContent = t;
        b.onclick = () => { time = t; render(); };
        slotsEl.appendChild(b);
      });
      confirmBtn.disabled = !ready;
      confirmBtn.style.cursor = ready ? 'pointer' : 'not-allowed';
      confirmBtn.style.opacity = ready ? '1' : '.45';
    };

    confirmBtn.addEventListener('click', async () => {
      const chosen = dateIdx != null ? DAYS[dateIdx] : null;
      if (!chosen || !time) return;
      if (err) err.style.display = 'none';
      const label = confirmBtn.textContent ?? '';
      confirmBtn.disabled = true; confirmBtn.setAttribute('aria-busy', 'true'); confirmBtn.textContent = 'Versturen…';
      try {
        // TODO: CONNECT REAL BOOKING PROVIDER — hier de boeking wegschrijven naar de agenda-provider.
        const endpoint = root.dataset.bookingEndpoint || '';
        const accessKey = root.dataset.accessKey || '';
        if (!endpoint) throw new Error('Geen endpoint geconfigureerd (PUBLIC_FORM_ENDPOINT_GESPREK).');
        const payload: Record<string, string> = { formulier: 'gesprek', _subject: 'Nieuwe gespreksaanvraag via finable.nl', datum: fmt(chosen.date), tijd: time + ' uur', datum_iso: chosen.date.toISOString().slice(0, 10) };
        if (accessKey) payload.access_key = accessKey;
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
        if (!res.ok) throw new Error('bad status ' + res.status);
        bookedEl.querySelector('[data-booked-date]')!.textContent = fmt(chosen.date);
        bookedEl.querySelector('[data-booked-time]')!.textContent = time + ' uur';
        root.hidden = true; bookedEl.hidden = false;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (ex) {
        console.error(ex);
        if (err) err.style.display = 'block';
        confirmBtn.removeAttribute('aria-busy'); confirmBtn.textContent = label; confirmBtn.disabled = false;
      }
    });
    render();
  }
</script>
