---
import Base from '../layouts/Base.astro';
---
<Base
  title="Plan een gesprek — Finable"
  description="Vrijblijvend, in 30 minuten. Geen standaardverhaal, maar een eerlijk gesprek over jouw situatie."
>
  <section class="gesprek-hero">
    <div class="container gesprek-grid">
      <div class="gesprek-content">
        <p class="eyebrow">Plan een gesprek</p>
        <h1>Laten we kijken wat Finable voor jouw bedrijf kan betekenen.</h1>
        <p class="gesprek-body">Vrijblijvend, in 30 minuten. Geen standaardverhaal, maar een eerlijk gesprek over jouw situatie.</p>
      </div>
      <div class="gesprek-card">
        <div
          class="calendly-inline-widget"
          id="calendly-embed"
          data-url="https://calendly.com/tim-finable/30min"
        ></div>
        <noscript>
          <p>Zet JavaScript aan om een gesprek in te plannen, of mail ons op <a href="mailto:tim@finable.nl">tim@finable.nl</a>.</p>
        </noscript>
      </div>
    </div>
  </section>

  <section class="tint">
    <div class="container gesprek-trust">
      <div class="gesprek-trust-item">
        <strong>Vrijblijvend</strong>
        <p>Geen verplichtingen, geen verkooppraatje.</p>
      </div>
      <div class="gesprek-trust-item">
        <strong>30 minuten</strong>
        <p>Kort en to the point.</p>
      </div>
      <div class="gesprek-trust-item">
        <strong>Persoonlijk</strong>
        <p>Je spreekt direct met Tim.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .gesprek-hero { padding: var(--space-xl) 0 var(--space-2xl); }
  .gesprek-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .gesprek-content { padding-top: 32px; }
  .gesprek-content h1 { margin-bottom: 16px; }
  .gesprek-body { font-size: 1.0625rem; max-width: 440px; }

  .gesprek-card {
    background: var(--white);
    border: 1px solid #EEE9E3;
    border-radius: var(--radius-xl);
    box-shadow: 0 20px 50px -30px rgba(44,62,80,.35);
    padding: clamp(20px, 3.5vw, 44px);
    overflow: hidden;
  }

  /* Calendly inline embed — responsive, no forced min-width so it never
     overflows the viewport on small screens. */
  .calendly-inline-widget {
    width: 100%;
    min-width: 0;
    height: 720px;
  }
  @media (max-width: 1024px) {
    .calendly-inline-widget { height: 760px; }
  }
  @media (max-width: 640px) {
    .gesprek-card { padding: 12px; }
    .calendly-inline-widget { height: 940px; }
  }

  .gesprek-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: var(--space-lg) 0;
  }
  .gesprek-trust-item {
    text-align: center;
    padding: 24px;
  }
  .gesprek-trust-item strong { color: var(--navy); font-size: 1rem; display: block; margin-bottom: 4px; }
  .gesprek-trust-item p { font-size: 0.875rem; }

  @media (max-width: 1024px) {
    .gesprek-grid { grid-template-columns: 1fr; }
    .gesprek-content { padding-top: 0; }
  }
  @media (max-width: 640px) {
    .gesprek-trust { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Calendly inline embed for /gesprek only. The external widget script is
  // loaded here (page-scoped), never site-wide, and guarded so it is not
  // injected twice if this script runs again.
  const CALENDLY_SCRIPT = 'https://assets.calendly.com/assets/external/widget.js';

  function loadCalendly() {
    if (document.querySelector(`script[src="${CALENDLY_SCRIPT}"]`)) return;
    const s = document.createElement('script');
    s.src = CALENDLY_SCRIPT;
    s.async = true;
    document.body.appendChild(s);
  }

  // Analytics: listen for Calendly postMessage events and only push a
  // conversion to the dataLayer once a booking is actually confirmed.
  // Fires on calendly.event_scheduled — never on load, open, date or time
  // selection. Guarded so the listener is attached only once.
  function attachCalendlyListener() {
    if ((window as any).__calendlyListenerAttached) return;
    (window as any).__calendlyListenerAttached = true;

    window.addEventListener('message', (e: MessageEvent) => {
      if (e.origin !== 'https://calendly.com') return;
      const data = e.data;
      if (!data || typeof data !== 'object') return;
      if (data.event !== 'calendly.event_scheduled') return;

      (window as any).dataLayer = (window as any).dataLayer || [];
      (window as any).dataLayer.push({
        event: 'book_call_complete',
        booking_provider: 'calendly',
        booking_type: '30min',
      });
    });
  }

  attachCalendlyListener();
  loadCalendly();
</script>
