              <summary><span class="fin-faq-q">{f.q}</span><span class="fin-faq-ic"></span></summary>
              <div class="fin-faq-a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
        <div class="fu-end-cta" data-cta-location="closing">
          <div class="lbl" style="margin-bottom:20px">Persoonlijk kennismaken</div>
          <div class="fu-tim">
            <div style="aspect-ratio:1/1;border-radius:12px;overflow:hidden"><img src="/images/tim-samsom.webp" alt="Tim Samsom, oprichter van Finable" width="800" height="699" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block"></div>
            <div>
              <h2 style="font-size:clamp(21px,2.2vw,28px);line-height:1.12;margin-bottom:12px;color:var(--white)">Benieuwd hoe jouw finance-functie eruit kan zien?</h2>
              <p style="font-size:15px;color:var(--on-dark-secondary);text-wrap:pretty">We kijken naar wat je vandaag hebt, waar het vastloopt en welke onderdelen je intern wilt houden of extern kunt organiseren.</p>
            </div>
          </div>
          <div class="fu-end-row">
            <Button href="/gesprek">Plan een gesprek &rarr;</Button>
            <a href="/indicatie" class="fu-cta-alt">Vraag je indicatie aan &rarr;</a>
          </div>
          <div class="fu-end-tim"><span style="font-family:'Playfair Display',serif;font-weight:600;color:var(--white)">Tim Samsom</span><br>Oprichter Finable</div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

</div>
</Layout>

<style is:global>
