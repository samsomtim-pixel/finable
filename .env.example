# Serverzijde van het indicatieformulier (/api/indicatie, Vercel-functie). Nooit als PUBLIC_ variabelen: ze blijven op de server.
# Resend: https://resend.com → API key. Zonder key antwoordt de route met 500 en toont het formulier de foutmelding.
RESEND_API_KEY=
# Afzender. Standaard 'Finable <onboarding@resend.dev>' (Resend-testafzender, alleen naar het eigen accountadres).
# Zet na domeinverificatie in Resend bijv. 'Finable <indicatie@finable.nl>'.
INDICATIE_FROM=
# Ontvanger; standaard tim@finable.nl.
INDICATIE_TO=
# Alleen voor lokaal testen met een mock-mailserver; standaard https://api.resend.com/emails.
RESEND_API_URL=
